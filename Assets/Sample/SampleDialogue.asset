        clip: {fileID: 0}
        animType: 0
        camPositionNumber: 0
        replicaText: "\u041E\u0442\u043B\u0438\u0447\u043D\u043E. \u041D\u0430\u043C
          \u0434\u0430\u043D\u043E \u0437\u0430\u0434\u0430\u043D\u0438\u0435 \u0432\u0437\u044F\u0442\u044C
          \u043E\u0434\u0438\u043D \u0438\u0437 \u0433\u043E\u0440\u043E\u0434\u043E\u0432
          \u043D\u0430 \u043F\u043B\u0430\u043D\u0435\u0442\u0435. \u041D\u043E \u043E\u043D
          \u043F\u043E\u0434 \u0449\u0438\u0442\u043E\u043C \u0438 \u0430\u0440\u0442\u0438\u043B\u043B\u0435\u0440\u0438\u044F
          \u043D\u0435 \u043F\u043E\u0437\u0432\u043E\u043B\u0438\u0442 \u043F\u043E\u0434\u043E\u0433\u043D\u0430\u0442\u044C
          \u0442\u044F\u0436\u0451\u043B\u0443\u044E \u0442\u0435\u0445\u043D\u0438\u043A\u0443.
          \u041F\u0440\u0438\u0434\u0451\u0442\u0441\u044F \u0432\u044B\u0441\u0430\u0436\u0438\u0432\u0430\u0442\u044C
          \u0434\u0435\u0441\u0430\u043D\u0442\u043D\u044B\u0435 \u0433\u0440\u0443\u043F\u043F\u044B.
          \u0412\u044B\u0431\u0440\u0430\u043D\u043E \u043C\u0435\u0441\u0442\u043E
          \u0432 \u043E\u0442\u0434\u0430\u043B\u0435\u043D\u0438\u0438 \u043E\u0442
          \u0433\u043E\u0440\u043E\u0434\u0430. \u0421\u043A\u0430\u043B\u0430 \u0431\u0443\u0434\u0435\u0442
          \u0437\u0430\u0449\u0438\u0449\u0430\u0442\u044C \u043D\u0430\u0441 \u043E\u0442
          \u043F\u0440\u044F\u043C\u043E\u0433\u043E \u043E\u0433\u043D\u044F \u0438\u0445
          \u0430\u0440\u0442\u0438\u043B\u043B\u0435\u0440\u0438\u0438, \u043D\u043E
          \u043D\u0430 \u0441\u0430\u043C\u043E\u0439 \u0433\u043E\u0440\u0435 \u0442\u043E\u0436\u0435
          \u0435\u0441\u0442\u044C \u043E\u0440\u0443\u0434\u0438\u044F. \u041F\u043E\u044D\u0442\u043E\u043C\u0443
          \u043A\u043E\u043D\u043A\u0440\u0435\u0442\u043D\u043E \u043D\u0430\u043C
          \u0441 \u0442\u043E\u0431\u043E\u0439 \u043F\u043E\u0440\u0443\u0447\u0435\u043D\u043E
          \u043F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u0438\u0442\u044C \u043F\u043B\u043E\u0449\u0430\u0434\u043A\u0443
          \u0434\u043B\u044F \u0432\u044B\u0441\u0430\u0434\u043A\u0438 \u0434\u0435\u0441\u0430\u043D\u0442\u0430.\r\n\r\n\u0422\u0430\u043C
          \u0440\u043E\u0432\u043D\u0430\u044F \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u044C,
          \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u043E
          \u043F\u0440\u043E\u0441\u0442\u0440\u0435\u043B\u0438\u0432\u0430\u0435\u0442\u0441\u044F.\n"
