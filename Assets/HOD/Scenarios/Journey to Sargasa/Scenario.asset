          \u0447\u0442\u043E \u0432 \u043C\u043E\u043C\u0435\u043D\u0442, \u043A\u043E\u0433\u0434\u0430
          \u0432\u0441\u0435 \u043C\u0443\u0436\u0438\u043A\u0438 \u0441\u043E \u0441\u043B\u044E\u043D\u043E\u0439
          \u0432\u043E \u0440\u0442\u0443 \u0448\u043B\u0438 \u043A \u043F\u043E\u043B\u0443\u0433\u043E\u043B\u044B\u043C
          \u0440\u044B\u0431\u0430\u043C, \u043D\u0435\u043A\u043E\u043C\u0443 \u0431\u044B\u043B\u043E
          \u0431\u043E\u043B\u044C\u0448\u0435 \u0434\u0435\u0439\u0441\u0442\u0432\u043E\u0432\u0430\u0442\u044C.
          \u0418 \u0435\u043C\u0443 \u0441\u043B\u0435\u0434\u0443\u0435\u0442 \u0440\u0430\u0434\u043E\u0432\u0430\u0442\u044C\u0441\u044F,
          \u0447\u0442\u043E \u043E\u043D \u043E\u0441\u0442\u0430\u043B\u0441\u044F
          \u0436\u0438\u0432. \u0425\u043E\u0442\u044F \u0443 \u0432\u0430\u0441
          \u0431\u044B\u043B \u0441\u043E\u0431\u043B\u0430\u0437\u043D \u043A\u0438\u043D\u0443\u0442\u044C
          \u0435\u0433\u043E \u0437\u0430 \u0431\u043E\u0440\u0442.  \u0423\u0440\u044F
          \u043F\u0440\u0438\u0442\u0438\u0445. \u0421 \u0443\u0432\u0430\u0436\u0435\u043D\u0438\u0435\u043C
          \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u043B \u043D\u0430 \u0432\u0430\u0441.
          \u0418 \u0443\u0448\u0451\u043B\u2026 "
