        replicaText: "\u0412\u044B \u0443\u0436\u0435 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
          \u043D\u0435\u0434\u0435\u043B\u044C \u043F\u043B\u0430\u0432\u0430\u0435\u0442\u0435
          \u0441 \u044D\u043A\u0438\u043F\u0430\u0436\u0435\u043C \u0427\u0435\u0440\u0435\u043F\u0430\u0448\u043A\u0438
          \u041F\u0430\u0448\u043A\u0438. \u041E\u0442\u0434\u0440\u0430\u0438\u0442\u044C
          \u043F\u0430\u043B\u0443\u0431\u0443 \u0434\u043B\u044F \u0432\u0430\u0441
          \u0442\u0435\u043F\u0435\u0440\u044C - \u0440\u0430\u0437\u0432\u043B\u0435\u0447\u0435\u043D\u0438\u0435.
          \u041F\u043E\u044F\u0432\u043B\u0435\u043D\u0438\u0435 \u041A\u0430\u043F\u0438\u0442\u0430\u043D\u0430
          \u043D\u0430 \u043F\u0430\u043B\u0443\u0431\u0435 - \u0441\u043E\u0431\u044B\u0442\u0438\u0435.
          \u0428\u0442\u043E\u0440\u043C - \u043F\u0440\u043E\u043A\u043B\u044F\u0442\u0438\u0435."
