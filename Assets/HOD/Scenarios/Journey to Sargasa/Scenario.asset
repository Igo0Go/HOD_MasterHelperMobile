      replicaInformation:
        alreadyUsed: 0
        character: {fileID: 11400000, guid: df5ced05feaf7d2438a27afab49786cf, type: 2}
        clip: {fileID: 0}
        animType: 0
        camPositionNumber: 0
        replicaText: "\u0412 \u043F\u0435\u0440\u0432\u0443\u044E \u043E\u0447\u0435\u0440\u0435\u0434\u044C
          \u0433\u043B\u0430\u0437 \u0443\u043F\u0430\u043B \u043D\u0430 \u043F\u0440\u0438\u043B\u0430\u0432\u043E\u043A
          \u0441 \u0435\u0434\u043E\u0439. \u0417\u0434\u0435\u0441\u044C \u0442\u043E\u0440\u0433\u043E\u0432\u0430\u043B\u0430
          \u043F\u044B\u0448\u043D\u0430\u044F \u0434\u0430\u043C\u0430 \u0432 \u0433\u043E\u043B\u0443\u0431\u043E\u043C
          \u043F\u043B\u0430\u0442\u044C\u0435 \u0441 \u043A\u0443\u0434\u0440\u044F\u0432\u043E\u0439
          \u0440\u044B\u0436\u0435\u0439 \u043F\u0440\u0438\u0447\u0451\u0441\u043A\u043E\u0439,
          \u043D\u0430\u0441\u0442\u043E\u043B\u044C\u043A\u043E \u043A\u0440\u0443\u0433\u043B\u043E\u0439,
          \u0447\u0442\u043E \u043E\u043D\u0430 \u0431\u044B\u043B\u0430 \u043F\u043E\u0445\u043E\u0436\u0430
          \u043D\u0430 \u043E\u0433\u043D\u0435\u043D\u043D\u044B\u0439 \u043E\u0434\u0443\u0432\u0430\u043D\u0447\u0438\u043A,
          \u043A\u0430\u043A\u0438\u0435 \u0432\u044B \u0432\u0438\u0434\u0435\u043B\u0438
          \u043F\u043E \u0434\u043E\u0440\u043E\u0433\u0435 \u043A \u0433\u043E\u0440\u043E\u0434\u0443.
          \u0422\u043E\u0440\u0433\u043E\u0432\u043A\u0430 \u0437\u0430 \u0447\u0442\u043E-\u0442\u043E
          \u043E\u0442\u0447\u0438\u0442\u044B\u0432\u0430\u043B\u0430 \u043E\u0434\u043D\u043E\u0433\u043E
          \u0438\u0437 \u043F\u043E\u0441\u0435\u0442\u0438\u0442\u0435\u043B\u0435\u0439: 
          \n\n\u201C\u041F\u043E\u043F\u0440\u043E\u0431\u043E\u0432\u0430\u0442\u044C\u201D
          - \u0441\u0442\u0440\u043E\u0433\u043E \u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0430
          \u043E\u043D\u0430 - \u201C\u042D\u0442\u043E \u043A\u043E\u0433\u0434\u0430
          \u043E\u0434\u043D\u0443 \u044F\u0433\u043E\u0434\u043A\u0443, \u0430 \u043D\u0435
          \u0432\u0441\u044E \u0441\u0432\u044F\u0437\u043A\u0443, \u0441\u0443\u0434\u0430\u0440\u044C!
          \u041F\u043B\u0430\u0442\u0438\u0442\u0435!\u201D \n\n\u201C\u041D\u0435\u0442\u044C!\u201D
          - \u043E\u0442\u0432\u0435\u0447\u0430\u043B \u044F\u0432\u043D\u043E \u043A\u0430\u043A\u043E\u0439-\u0442\u043E
          \u0447\u0443\u0436\u0435\u0441\u0435\u043C\u0435\u0446. - \u201C\u041C\u043D\u0435
          \u0431\u0438\u043B\u0451 \u043D\u0435 \u0432\u043A\u0443\u0441\u043D\u043E.\u201D\n\n\u201C\u0421\u0442\u043E\u044F\u043B
          \u0441 \u0434\u043E\u0432\u043E\u043B\u044C\u043D\u043E\u0439 \u0440\u043E\u0436\u0435\u0439
          \u0438 \u0443\u043F\u043B\u0435\u0442\u0430\u043B \u043A\u0440\u0430\u0441\u043D\u0443\u044E
          \u043A\u0430\u043F\u0435\u043B\u044C! \u0418 \u0433\u043E\u0432\u043E\u0440\u0438\u0442,
          \u0431\u044B\u043B\u043E \u043D\u0435 \u0432\u043A\u0443\u0441\u043D\u043E!
          \u041D\u0435 \u0431\u044B\u043B\u043E!\u201D\n\n\u201C\u0411\u0438\u043B\u0451!\u201D\n\n\u201C\u041D\u0435
          \u0431\u044B\u043B\u043E!\u201D\n\n\u201C\u0411\u0438\u043B\u0451! \u0421\u043E\u0432\u0441\u0435\u043C\u044C
          \u0440\u0430\u0441\u043F\u0443\u0442\u0438\u043B\u044C \u0432\u0430\u0441
          \u0432\u0430\u0448 \u043D\u0430\u043C\u0435\u0441\u0442\u043D\u0418\u043A.\u201D\n\n\u201C\u041A\u0430\u043A\u043E\u0432
          \u043D\u0430\u0433\u043B\u0435\u0446!\u201D - \u0437\u0430\u043C\u0430\u0445\u043D\u0443\u043B\u0430\u0441\u044C
          \u043E\u043D\u0430 \u043D\u0430 \u043D\u0435\u0433\u043E \u043A\u043E\u0432\u0448\u043E\u043C.
          - \u201C\u041F\u043E\u0448\u0451\u043B \u0432\u043E\u043D, \u043A\u0440\u043E\u0442\u043E\u043A\u0440\u043E\u043B
          \u0432\u0438\u0441\u043B\u043E\u0443\u0445\u0438\u0439! \u0427\u0442\u043E\u0431
          \u044F \u0442\u0435\u0431\u044F \u0442\u0443\u0442 \u0431\u043E\u043B\u044C\u0448\u0435
          \u043D\u0435 \u0432\u0438\u0434\u0435\u043B\u0430, \u0430 \u0442\u043E
          \u0441\u0442\u0440\u0430\u0436\u0443 \u0432\u044B\u0437\u043E\u0432\u0443.\u201D\n\n\u0418
          \u043E\u043D \u0443\u0448\u0451\u043B. \u0422\u043E\u0440\u0433\u043E\u0432\u043A\u0430
          \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u043B\u0430\u0441\u044C \u043A
