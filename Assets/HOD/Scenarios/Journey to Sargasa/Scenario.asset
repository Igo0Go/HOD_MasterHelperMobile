        replicaText: "\u041D\u0435\u043A\u043E\u043C\u0443 \u0431\u044B\u043B\u043E
          \u043F\u043E\u043C\u043E\u0447\u044C \u0423\u0440\u0435. \u0418 \u0435\u0433\u043E,
          \u043B\u0435\u0436\u0430\u0449\u0435\u0433\u043E \u0431\u0435\u0437 \u0441\u043E\u0437\u043D\u0430\u043D\u0438\u044F,
          \u043F\u0440\u043E\u0441\u0442\u043E \u043F\u0440\u043E\u0442\u043A\u043D\u0443\u043B\u0438
          \u043A\u043B\u0438\u043D\u043A\u043E\u043C. \u041E\u0447\u0435\u0440\u0435\u0434\u044C
          \u0434\u043E\u0448\u043B\u0430 \u0438 \u0434\u043E \u0432\u0430\u0448\u0435\u0433\u043E
          \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430, \u043D\u043E \u0442\u0443\u0442
          \u0432 \u0434\u0435\u043B\u043E \u0432\u0441\u0442\u0443\u043F\u0438\u043B
          \u041C\u0430\u0440, \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0432\u0441\u0451
          \u0436\u0435 \u0441\u043C\u043E\u0433 \u043F\u0440\u0438\u0437\u0432\u0430\u0442\u044C
          \u043C\u0430\u0433\u0438\u044E \u043C\u043E\u0440\u0435\u0445\u043E\u0434\u043E\u0432
          \u0438 \u0441\u043C\u044B\u043B \u0432\u043E\u043B\u043D\u043E\u0439 \u043F\u0438\u0440\u0430\u0442\u043E\u0432
          \u0441 \u0432\u0430\u0448\u0435\u0439 \u043F\u0430\u043B\u0443\u0431\u044B.
          \u0411\u043E\u043B\u0435\u0435 \u0442\u043E\u0433\u043E, \u043E\u043D\u0430
          \u043E\u0442\u0441\u0442\u0440\u0430\u043D\u0438\u043B\u0430 \u043E\u0442
          \u0432\u0430\u0441 \u043F\u0438\u0440\u0430\u0442\u0441\u043A\u0438\u0439
