        replicaText: "\u041F\u0440\u0438 \u044D\u0442\u043E\u043C \u043E\u043D\u0430
          \u043D\u0435 \u0437\u0430\u0434\u0435\u0432\u0430\u0435\u0442 \u0432\u0430\u0448\u0438\u0445.
          \u041E\u043D\u0430 \u0431\u0440\u043E\u0441\u0430\u0435\u0442\u0441\u044F
          \u043E\u043F\u043B\u0430\u043A\u0438\u0432\u0430\u0442\u044C \u043E\u0442\u0446\u0430.
          \u0412\u044B \u0432\u0438\u0434\u0438\u0442\u0435, \u0447\u0442\u043E \u0442\u044C\u043C\u0430
          \u0441\u043D\u043E\u0432\u0430 \u043E\u043A\u0443\u0442\u044B\u0432\u0430\u0435\u0442
          \u0435\u0451. \u041D\u043E \u043E\u0431\u043D\u044F\u0432 \u0441\u0443\u043F\u0440\u0443\u0433\u0443
          \u0438 \u0441\u043E\u0435\u0434\u0438\u043D\u0438\u0432 \u0434\u0432\u0430
          \u043A\u0440\u0430\u0441\u043D\u044B\u0445 \u043A\u0430\u043C\u043D\u044F
          \u0432\u043C\u0435\u0441\u0442\u0435, \u0443\u0441\u043F\u043E\u043A\u0430\u0438\u0432\u0430\u0435\u0442\u0435
          \u0435\u0451. \u041F\u043B\u0430\u043A\u0430\u0442\u044C - \u044D\u0442\u043E
          \u043D\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u043E. \u041D\u043E \u043F\u0443\u0441\u043A\u0430\u0442\u044C
          \u0442\u044C\u043C\u0443 \u0432 \u0434\u0443\u0448\u0443 \u043D\u0435\u043B\u044C\u0437\u044F."
