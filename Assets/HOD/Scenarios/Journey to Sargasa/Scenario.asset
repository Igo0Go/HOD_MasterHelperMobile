        replicaText: "\u041E\u043D\u0438 \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u043B\u0438\u0441\u044C
          \u043D\u0430 \u043F\u0430\u043B\u0443\u0431\u0435 \u041F\u0430\u0448\u043A\u0438.
          \u041E\u0431\u043D\u044F\u043B\u0438\u0441\u044C. \u042D\u043B\u0430\u0439
          \u043F\u0440\u0438\u0441\u043E\u0435\u0434\u0438\u043D\u0438\u043B\u0441\u044F
          \u043A \u0441\u0442\u043E\u043B\u0443. \u0412\u044B\u0441\u043B\u0443\u0448\u0430\u043B
          \u0432\u0430\u0448\u0443 \u0438\u0441\u0442\u043E\u0440\u0438\u044E. \u0410
          \u043F\u043E\u0442\u043E\u043C \u0437\u0430\u0433\u043E\u0432\u043E\u0440\u0438\u043B. 
          \u201C\u041D\u0430 \u041C\u043E\u043D\u0442\u0435\u0440\u0435 \u0442\u043E\u0432\u0430\u0440\u043E\u0432
          \u043C\u043D\u043E\u0433\u043E, \u043D\u043E \u0440\u0430\u0437\u0431\u0438\u0440\u0430\u044E\u0442
          \u0438\u0445 \u0431\u044B\u0441\u0442\u0440\u043E. \u0422\u0440\u0443\u0434\u043D\u043E
          \u043D\u0430\u0439\u0442\u0438 \u0442\u0443\u0442 \u0447\u0442\u043E-\u0442\u043E
          \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E
          \u0445\u043E\u0440\u043E\u0448\u0435\u0435. \u041C\u043E\u0436\u0435\u0442,
