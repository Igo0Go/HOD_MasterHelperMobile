  - nodeType: 1
    replicaNode:
      index: 1
      previousNodesNumbers: 05000000
      nextNodesNumbers: 07000000
      finalNode: 0
      leftToRight: 1
      transformRect:
        serializedVersion: 2
        x: 534
        y: 257
        width: 150
        height: 50
      replicaInformation:
        alreadyUsed: 0
        character: {fileID: 11400000, guid: df5ced05feaf7d2438a27afab49786cf, type: 2}
        clip: {fileID: 0}
        animType: 0
        camPositionNumber: 0
        replicaText: "\u0412 \u044E\u0433\u043E-\u0437\u0430\u043F\u0430\u0434\u043D\u043E\u0439
          \u0447\u0430\u0441\u0442\u0438 \u043F\u0440\u0435\u0434\u0435\u043B\u043E\u0432
          \u0426\u0435\u043F\u0430 \u0440\u0430\u0441\u043F\u043E\u043B\u0430\u0433\u0430\u044E\u0442\u0441\u044F
          \u0418\u0437\u0443\u043C\u0440\u0443\u0434\u043D\u044B\u0435 \u043B\u0443\u0433\u0430
          - \u0431\u043E\u0433\u0430\u0442\u0430\u044F \u0438 \u043F\u043B\u043E\u0434\u043E\u0440\u043E\u0434\u043D\u0430\u044F
          \u0437\u0435\u043C\u043B\u044F \u0441 \u0432\u044B\u0445\u043E\u0434\u043E\u043C
          \u043A \u043F\u0440\u0435\u0441\u043D\u043E\u0432\u043E\u0434\u043D\u043E\u043C\u0443
          \u043C\u043E\u0440\u044E. \r\n\u0418\u0437\u0443\u043C\u0440\u0443\u0434\u043D\u044B\u0435
          \u043B\u0443\u0433\u0430 - \u043A\u0440\u0430\u0441\u0438\u0432\u043E\u0435
          \u043C\u0435\u0441\u0442\u043E \u0441 \u043C\u044F\u0433\u043A\u0438\u043C
          \u043A\u043B\u0438\u043C\u0430\u0442\u043E\u043C. \u041D\u0435 \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E,
          \u0447\u0442\u043E \u0437\u0434\u0435\u0441\u044C \u043C\u043D\u043E\u0433\u043E
          \u043F\u0438\u0432\u043E\u0433\u0440\u0430\u0434\u043D\u0438\u043A\u043E\u0432
          \u0438 \u043F\u043B\u0430\u043D\u0442\u0430\u0446\u0438\u0439. \u041D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0435
          \u043E\u0441\u043E\u0431\u043E \u0443\u043C\u0435\u043B\u044B\u0435 \u0444\u0435\u0440\u043C\u0435\u0440\u044B
          \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E \u0437\u0430\u043D\u0438\u043C\u0430\u044E\u0442\u0441\u044F
          \u0441\u0435\u043B\u044C\u0441\u043A\u0438\u043C \u0445\u043E\u0437\u044F\u0439\u0441\u0442\u0432\u043E\u043C,
          \u043D\u043E \u0438 \u0437\u0430\u043C\u0430\u043D\u0438\u0432\u0430\u044E\u0442
          \u0442\u0443\u0440\u0438\u0441\u0442\u043E\u0432, \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u044F
          \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044E\u0449\u0438\u0435
          \u0437\u0430\u0432\u0435\u0434\u0435\u043D\u0438\u044F.\r\n\u0422\u0430\u043A
          \u043D\u0430 \u043F\u0435\u0440\u0435\u043F\u0443\u0442\u044C\u0435 \u0434\u043E\u0440\u043E\u0433
          \u0438\u0437 \u041A\u0443\u0434\u0440\u044F\u0432\u043E\u0433\u043E \u043B\u0435\u0441\u0430
          \u0438 \u0421\u043E\u043B\u0435\u0432\u044B\u0445 \u0441\u0442\u0435\u043F\u0435\u0439
          \u043A \u041F\u0440\u0435\u0441\u043D\u043E\u0432\u043E\u0434\u043D\u043E\u043C\u0443
          \u043C\u043E\u0440\u044E \u0441\u0442\u043E\u0438\u0442 \u0440\u0430\u043D\u0447\u043E
          \u043D\u0435\u043A\u043E\u0439 \u0421\u043E\u0444\u0438\u0438. \u0417\u0434\u0435\u0441\u044C
          \u0436\u0435 \u043E\u0442\u043A\u0440\u044B\u0442\u0430 \u0438 \u0442\u0430\u0432\u0435\u0440\u043D\u0430.
          \u0422\u0443\u0442 \u0432\u0441\u0435\u0433\u0434\u0430 \u0448\u0443\u043C\u043D\u043E
          \u0438 \u0432\u0435\u0441\u0435\u043B\u043E. \u041D\u043E \u0442\u043E\u043B\u044C\u043A\u043E
          \u0434\u043E 10 \u0432\u0435\u0447\u0435\u0440\u0430. \u041F\u043E\u0442\u043E\u043C
          \u043E\u0442\u0431\u043E\u0439.\r\n\u0417\u0430 \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u0443\u044E
          \u043F\u043B\u0430\u0442\u0443 \u0432\u044B \u043C\u043E\u0436\u0435\u0442\u0435
          \u043F\u043E\u043A\u043E\u0440\u043C\u0438\u0442\u044C \u043B\u0435\u0434\u0435\u043D\u0446\u043E\u0432\u044B\u0445
          \u0441\u0432\u0438\u043D\u0435\u0439, \u043F\u043E\u0447\u0435\u0441\u0430\u0442\u044C
          \u0441\u0430\u0445\u0430\u0440\u043E\u0432\u0435\u0446 \u0438 \u0432\u044B\u043F\u043E\u043B\u043D\u0438\u0442\u044C
          \u0434\u0440\u0443\u0433\u0443\u044E \u043D\u0435\u043E\u0431\u044B\u0447\u0430\u0439\u043D\u043E
          \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u0443\u044E \u0440\u0430\u0431\u043E\u0442\u0443.\r\n\r\n\u0418
          \u0432\u043E\u0442, \u0432 \u043E\u0434\u0438\u043D \u0438\u0437 \u0434\u043D\u0435\u0439
          \u043D\u0430 \u043F\u0435\u0440\u0432\u043E\u043C \u044D\u0442\u0430\u0436\u0435
          \u0442\u0430\u0432\u0435\u0440\u043D\u044B \u0442\u0430\u043A \u0436\u0435
          \u0448\u0443\u043C\u043D\u043E. \u041D\u043E \u043E\u0434\u0438\u043D \u0441\u0442\u043E\u043B\u0438\u043A
          \u0435\u0449\u0451 \u043F\u0443\u0441\u0442\u0443\u0435\u0442\u2026\r\n"
