        replicaText: "\u0412 \u044D\u0442\u043E\u0442 \u043C\u043E\u043C\u0435\u043D\u0442
          \u0432\u0430\u0448 \u043F\u0440\u043E\u0440\u043E\u0441\u043B\u0438\u043A,
          \u043E\u0433\u0440\u043E\u043C\u043D\u044B\u0439 \u0438 \u043C\u043E\u0449\u043D\u044B\u0439,
          \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442 \u0440\u0430\u0437\u043D\u043E\u0441\u0438\u0442\u044C
          \u0432\u0441\u0435\u0445 \u043F\u0438\u0440\u0430\u0442\u043E\u0432. \u0418
          \u044D\u0442\u043E\u0433\u043E \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E,
          \u0447\u0442\u043E\u0431\u044B \u0442\u0435 \u0441\u043A\u0440\u044B\u043B\u0438\u0441\u044C
          \u043D\u0430 \u0441\u0432\u043E\u0451\u043C \u043A\u043E\u0440\u0430\u0431\u043B\u0435.
          \u0412\u044B \u043F\u043E\u0442\u0438\u0445\u043E\u043D\u044C\u043A\u0443
          \u043F\u0440\u0438\u0448\u043B\u0438 \u0432 \u0441\u0435\u0431\u044F. \u041F\u043E\u0442\u0435\u0440\u044C
          \u043D\u0435\u0442. \u041D\u043E \u044F\u0432\u043D\u043E \u0432\u0438\u0434\u043D\u043E,
          \u0447\u0442\u043E \u043F\u0440\u043E\u0440\u043E\u0441\u043B\u0438\u043A\u0443
          \u043F\u0440\u0438\u0448\u043B\u043E\u0441\u044C \u0432\u043F\u0438\u0442\u0430\u0442\u044C
          \u043C\u043D\u043E\u0433\u043E \u0432\u043E\u0434\u044B, \u0447\u0442\u043E\u0431\u044B
          \u0441\u0442\u0430\u0442\u044C \u0442\u0430\u043A\u0438\u043C \u0441\u0438\u043B\u044C\u043D\u044B\u043C. "
