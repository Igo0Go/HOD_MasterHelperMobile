        replicaText: "\u041F\u043E\u043D\u044F\u0432, \u0447\u0442\u043E \u043E\u0442
          \u0432\u0430\u0441 \u043F\u043E\u043C\u043E\u0449\u0438 \u043D\u0435 \u0431\u0443\u0434\u0435\u0442,
          \u0410\u0440\u0438\u0441\u0430 \u0432\u0441\u0451 \u0436\u0435 \u0432\u0441\u0442\u0430\u043B\u0430
          \u0438 \u043F\u0440\u0438\u043C\u0435\u043D\u0438\u043B\u0430 \u043C\u0430\u0433\u0438\u044E.
          \u041E\u043D\u0430 \u0430\u043A\u043A\u0443\u0440\u0430\u0442\u043D\u043E
          \u043F\u0440\u0438\u043B\u043E\u0436\u0438\u043B\u0430 \u0440\u0443\u043A\u0438
          \u043A \u0437\u0430\u043C\u043A\u0443, \u0437\u0430\u043A\u0440\u044B\u043B\u0430
          \u0433\u043B\u0430\u0437\u0430. \u0421\u0442\u0430\u043B\u043E \u0445\u043E\u043B\u043E\u0434\u043D\u043E,
          \u0430 \u0432\u043E\u043A\u0440\u0443\u0433 \u0437\u0430\u043C\u043A\u0430
          \u043F\u043E\u044F\u0432\u0438\u043B\u0441\u044F \u0438\u043D\u0435\u0439.
          \u041E\u043D\u0430 \u0430\u043A\u043A\u0443\u0440\u0430\u0442\u043D\u043E
          \u0442\u043E\u043B\u043A\u043D\u0443\u043B\u0430 \u0434\u0432\u0435\u0440\u044C,
          \u043D\u043E \u0442\u0430 \u0432\u043C\u0435\u0441\u0442\u043E \u0442\u043E\u0433\u043E,
          \u0447\u0442\u043E\u0431 \u043E\u0442\u043A\u0440\u044B\u0442\u044C\u0441\u044F,
          \u0441\u043B\u043E\u043C\u0430\u0432 \u0437\u0430\u043C\u043E\u043A, \u0440\u0430\u0441\u043F\u0430\u043B\u0430\u0441\u044C
          \u043D\u0430 \u043A\u0443\u0441\u043E\u0447\u043A\u0438 \u0432\u043E\u043E\u0431\u0449\u0435
          \u0432\u0441\u044F. "
