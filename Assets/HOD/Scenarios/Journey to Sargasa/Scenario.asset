        clip: {fileID: 0}
        animType: 0
        camPositionNumber: 0
        replicaText: "\u041D\u043E\u0447\u044C \u043F\u043E\u0442\u0438\u0445\u043E\u043D\u044C\u043A\u0443
          \u043D\u0430\u0431\u0438\u0440\u0430\u043B\u0430 \u0441\u0432\u043E\u0438
          \u0441\u0438\u043B\u044B. \u041D\u0435 \u0432\u0441\u0435 \u0438\u0437
          \u0432\u0430\u0441 \u0441\u043F\u044F\u0442. \u0421\u043E\u043D \u043D\u0435
          \u0438\u0434\u0451\u0442. \u041F\u043E\u044D\u0442\u043E\u043C\u0443 \u043A\u043E\u0435-\u043A\u0442\u043E
          \u0440\u0435\u0448\u0438\u043B \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C
          \u0438\u0441\u043A\u0430\u0442\u044C \u043A\u043D\u0438\u0433\u0443. \u0418
          \u0443\u0441\u043F\u0435\u0445! \u041F\u043E\u0445\u043E\u0436\u0435, \u044D\u0442\u043E
          \u0438\u043C\u0435\u043D\u043D\u043E \u0442\u043E, \u0447\u0442\u043E \u0432\u0430\u043C
          \u0431\u044B\u043B\u043E \u043D\u0443\u0436\u043D\u043E.\n\n\u0421 \u0447\u0443\u0432\u0441\u0442\u0432\u043E\u043C
          \u0432\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u043D\u043E\u0433\u043E
          \u0434\u043E\u043B\u0433\u043E \u0432\u0430\u0448 \u0441\u0447\u0430\u0441\u0442\u043B\u0438\u0432\u0447\u0438\u043A
          \u043A\u043B\u0430\u0434\u0451\u0442 \u043A\u043D\u0438\u0433\u0443 \u043D\u0430
          \u043E\u0434\u0438\u043D \u0438\u0437 \u0441\u0442\u043E\u043B\u0438\u043A\u043E\u0432
          \u0431\u0438\u0431\u043B\u0438\u043E\u0442\u0435\u043A\u0438 \u0438 \u043E\u0442\u043F\u0440\u0430\u0432\u043B\u044F\u0435\u0442\u0441\u044F
          \u0441\u043F\u0430\u0442\u044C.\n\n\u0412\u0441\u0435: \u0421\u044B\u0442\u043E\u0441\u0442\u044C
