        replicaText: "\u041D\u043E \u043E\u043D\u0430 \u0441\u043D\u043E\u0432\u0430
          \u043D\u0435 \u0440\u0430\u0441\u0441\u0447\u0438\u0442\u044B\u0432\u0430\u0435\u0442
          \u0441\u0438\u043B\u0443. \u041E\u043D\u0430 \u0443\u0431\u0438\u0432\u0430\u0435\u0442
          \u0432\u0440\u0430\u0433\u043E\u0432. \u0418 \u0432\u043C\u0435\u0441\u0442\u0435
          \u0441 \u043D\u0438\u043C\u0438 \u043D\u0430\u043C\u0435\u0441\u0442\u043D\u0438\u043A\u0430.\r\n\u0428\u043E\u043A\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u0430\u044F
          \u0442\u0435\u043C, \u0447\u0442\u043E \u0441\u0434\u0435\u043B\u0430\u043B\u0430,
          \u043E\u043D\u0430 \u043F\u0430\u0434\u0430\u0435\u0442 \u043D\u0430 \u043A\u043E\u043B\u0435\u043D\u0438.
          \u0412\u044B \u0432\u0438\u0434\u0438\u0442\u0435, \u043A\u0430\u043A \u0435\u0451
          \u0441\u043B\u0451\u0437\u044B \u043F\u0440\u0435\u0432\u0440\u0430\u0449\u0430\u044E\u0442\u0441\u044F
          \u0432 \u0447\u0451\u0440\u043D\u0443\u044E \u0434\u044B\u043C\u043A\u0443,
          \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u043E\u043A\u0443\u0442\u044B\u0432\u0430\u0435\u0442
          \u0434\u0435\u0432\u0443\u0448\u043A\u0443 \u0446\u0435\u043B\u0438\u043A\u043E\u043C.
          \u0412\u0430\u043C \u0445\u0432\u0430\u0442\u0430\u0435\u0442 \u0443\u043C\u0430
          \u043D\u0435 \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442\u044C \u043A
          \u043D\u0435\u0439. \u041D\u043E \u0442\u0443\u0442 \u043E\u043D\u0430
          \u0438\u0437\u0434\u0430\u0451\u0442 \u0438\u0441\u0442\u043E\u0448\u043D\u044B\u0439
          \u0432\u043E\u043F\u043B\u044C, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
          \u043E\u0442\u043A\u0438\u0434\u044B\u0432\u0430\u0435\u0442 \u0438 \u0432\u0430\u0441.\r\n\n\u0412\u0441\u0435:
