        camPositionNumber: 0
        replicaText: "\u0412\u044B \u0432\u044B\u0445\u043E\u0434\u0438\u0442\u0435
          \u0432\u043E \u0434\u0432\u043E\u0440 \u0431\u0438\u0431\u043B\u0438\u043E\u0442\u0435\u043A\u0438.
          \u0412 \u0433\u043E\u0440\u043E\u0434\u0435 \u0441\u0442\u043E\u0438\u0442
          \u0442\u0438\u0448\u0438\u043D\u0430. \u0411\u043E\u0438 \u043A\u043E\u043D\u0447\u0438\u043B\u0438\u0441\u044C.\r\n\r\n\u041D\u0430\u043C\u0435\u0441\u0442\u043D\u0438\u043A
          \u0431\u044B\u043B \u0441 \u0432\u0430\u043C\u0438. \u041E\u043D \u0441\u043E
          \u0441\u043A\u043E\u0440\u0431\u044C\u044E \u0432 \u0433\u043B\u0430\u0437\u0430\u0445
          \u0441\u043C\u043E\u0442\u0440\u0435\u043B \u043D\u0430 \u0440\u0430\u0437\u0440\u0443\u0448\u0435\u043D\u043D\u044B\u0439
          \u0433\u043E\u0440\u043E\u0434 \u0438 \u043B\u0435\u0436\u0430\u0449\u0438\u0435
          \u043D\u0430 \u0443\u043B\u0438\u0446\u0430\u0445 \u0442\u0435\u043B\u0430
          \u0433\u043E\u0440\u043E\u0436\u0430\u043D. \r\n\r\n\u201C\u041C\u043E\u0436\u0435\u0442,
          \u0438 \u0432\u043F\u0440\u0430\u0432\u0434\u0443, \u044F \u043F\u0440\u0438\u0432\u0451\u043B
          \u0432\u043E\u0439\u043D\u0443 \u0432 \u043D\u0430\u0448 \u0434\u043E\u043C\u2026\u201D\r\n\r\n\u0412
          \u044D\u0442\u043E \u0432\u0440\u0435\u043C\u044F \u043A \u0432\u0430\u043C
          \u043D\u0430 \u043B\u043E\u0448\u0430\u0434\u044F\u0445 \u043F\u043E\u0434\u044A\u0435\u0445\u0430\u043B\u0438
          \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0441\u0442\u0440\u0430\u0436\u043D\u0438\u043A\u043E\u0432.
          \u0423\u0432\u0438\u0434\u0435\u0432 \u0432\u0430\u0441, \u043E\u043D\u0438
          \u0443\u0441\u043A\u043E\u0440\u0438\u043B\u0438\u0441\u044C. \u041D\u0430\u043C\u0435\u0441\u0442\u043D\u0438\u043A
          \u0432 \u0441\u0442\u0440\u0430\u0445\u0435 \u0437\u0430\u043A\u0440\u044B\u043B\u0441\u044F
          \u0449\u0438\u0442\u043E\u043C.\r\n\r\n\u201C\u0413\u043E\u0441\u0443\u0434\u0430\u0440\u044C,
          \u0432\u044B \u0436\u0438\u0432\u044B!\u201D - \u0432\u0435\u0449\u0430\u043B
          \u043E\u0434\u0438\u043D \u0438\u0437 \u043D\u0438\u0445. - \u201C\u041C\u044F\u0442\u0435\u0436\u043D\u0438\u043A\u0438
          \u0440\u0430\u0437\u0431\u0438\u0442\u044B. \u041C\u044B \u0442\u0443\u0448\u0438\u043C
          \u043F\u043E\u0436\u0430\u0440\u044B. \u0412\u044B \u0434\u043E\u043B\u0436\u043D\u044B
          \u0432\u044B\u0439\u0442\u0438 \u043A \u043D\u0430\u0440\u043E\u0434. \u0418\u043C
          \u043D\u0443\u0436\u043D\u0430 \u0432\u0430\u0448\u0430 \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u043A\u0430.\u201D\r\n\u201C\u041E\u043D\u0438
          \u043D\u0435 \u043F\u0440\u043E\u043A\u043B\u0438\u043D\u0430\u044E\u0442
          \u043C\u0435\u043D\u044F?\u201D - \u0441\u043F\u0440\u043E\u0441\u0438\u043B
          \u043D\u0430\u043C\u0435\u0441\u0442\u043D\u0438\u043A.\r\n\r\n\u0412\u0441\u0430\u0434\u043D\u0438\u043A
          \u0437\u0430\u043C\u0435\u0440 \u0432 \u043D\u0435\u0434\u043E\u0443\u043C\u0435\u043D\u0438\u0438.\r\n\r\n\u201C\u0413\u043E\u0441\u0443\u0434\u0430\u0440\u044C,
          \u043E\u043D\u0438 \u0436\u0434\u0443\u0442 \u0432\u0430\u0441! \u041F\u043E
          \u0432\u0430\u0448\u0438\u043C \u043D\u0430\u043A\u0430\u0437\u0430\u043C
          \u043C\u044B \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u043E\u0432\u0430\u043B\u0438
          \u043E\u0431\u043E\u0440\u043E\u043D\u0443. \u0423\u0431\u0435\u0440\u0435\u0433\u043B\u0438
          \u043C\u043D\u043E\u0433\u0438\u0445 \u0436\u0438\u0442\u0435\u043B\u0435\u0439.
          \u0410 \u0431\u0430\u0448\u043D\u0438 \u0410\u0440\u0438\u0441\u044B. \u0415\u0451
          \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u0438\u044F \u043C\u043E\u0440\u043E\u0437\u0430
          \u043F\u043E\u0442\u0443\u0448\u0438\u043B\u0438 \u0441\u0442\u043E\u043B\u044C\u043A\u043E
          \u043F\u043E\u0436\u0430\u0440\u043E\u0432.\u201D\r\n\u201C\u0423\u043C\u043D\u0438\u0446\u0430,
          \u0434\u043E\u0447\u043A\u0430.\u201D - \u0443\u043B\u044B\u0431\u043D\u0443\u043B\u0441\u044F
          \u043D\u0430\u043C\u0435\u0441\u0442\u043D\u0438\u043A.\r\n\r\n\u0412\u044B
          \u0441\u043A\u0430\u0437\u0430\u043B\u0438, \u0447\u0442\u043E \u0431\u044B\u043B\u0438
          \u0437\u043D\u0430\u043A\u043E\u043C\u044B \u0441 \u043E\u0434\u043D\u043E\u0439
          \u0434\u0435\u0432\u0443\u0448\u043A\u043E\u0439, \u043F\u043E \u0438\u043C\u0435\u043D\u0438
          \u0410\u0440\u0438\u0441\u0430. \u0412\u044B \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u0430\u043B\u0438
          \u0438 \u043E \u0442\u043E\u043C, \u043A\u0430\u043A \u043E\u043D\u0430
          \u043F\u043E\u0433\u0438\u0431\u043B\u0430.\r\n\r\n\u201C\u042F \u0443\u0431\u0438\u043B
          \u0435\u0451.\u201D - \u0433\u043E\u0432\u043E\u0440\u0438\u043B \u043D\u0430\u043C\u0435\u0441\u0442\u043D\u0438\u043A
          - \u201C\u041F\u043E\u0441\u043B\u0443\u0448\u0430\u043B \u0432\u0441\u0435\u0445
          \u0432\u0430\u0441, \u0422\u0430\u043B\u043E\u0441, \u0438 \u043E\u0442\u043E\u0441\u043B\u0430\u043B
          \u0435\u0451.\u201D\r\n\r\n\u201C\u0413\u043E\u0441\u0443\u0434\u0430\u0440\u044C,
          \u043F\u043E\u0447\u0435\u043C\u0443 \u0432\u044B \u0432\u0435\u0440\u0438\u0442\u0435
          \u044D\u0442\u0438\u043C \u043B\u044E\u0434\u044F\u043C?\u201D - \u043E\u0442\u0432\u0435\u0447\u0430\u043B
          \u0432\u0441\u0430\u0434\u043D\u0438\u043A - \u201C\u0413\u0434\u0435 \u0434\u043E\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0430?
          \u041A\u0442\u043E \u043E\u043D\u0438 \u0432\u043E\u043E\u0431\u0449\u0435
          \u0442\u0430\u043A\u0438\u0435?\u201D\r\n\r\n\u201C\u0413\u043E\u0441\u0442\u0438
          \u0438\u0437-\u0437\u0430 \u043C\u043E\u0440\u044F.\u201D - \u0441\u043A\u0430\u0437\u0430\u043B
          \u043D\u0430\u043C\u0435\u0441\u0442\u043D\u0438\u043A. - \u201C\u041E\u0431\u044B\u0447\u043D\u044B\u0435
          \u043B\u044E\u0434\u0438, \u043A\u043E\u0442\u043E\u0440\u044B\u043C \u043D\u0443\u0436\u043D\u043E
          \u0441\u043D\u044F\u0442\u044C \u0441\u043B\u0430\u0431\u044B\u0435 \u043F\u0440\u043E\u043A\u043B\u044F\u0442\u044C\u044F.
          \u0418 \u043E\u043D\u0438 \u0441\u043F\u0430\u0441\u043B\u0438 \u043C\u043D\u0435
          \u0436\u0438\u0437\u043D\u044C. \u0411\u043E\u044E\u0441\u044C, \u043E\u043D\u0438
          \u0433\u043E\u0432\u043E\u0440\u044F\u0442 \u043F\u0440\u0430\u0432\u0434\u0443.\u201D\r\n\r\n\u0412\u0441\u0435
          \u0432\u044B \u043C\u0438\u0440\u043D\u043E \u0448\u043B\u0438 \u0434\u043E
          \u0434\u0432\u043E\u0440\u0446\u0430. \u0413\u043E\u0441\u0443\u0434\u0430\u0440\u044C
          \u0443\u0442\u043E\u043F\u0430\u043B \u0432 \u0441\u0432\u043E\u0451\u043C
          \u0433\u043E\u0440\u0435. \u041D\u043E \u0432\u0434\u0440\u0443\u0433 \u043F\u0443\u0442\u044C
          \u0432\u0430\u043C \u043F\u0440\u0435\u0433\u0440\u0430\u0434\u0438\u043B
          \u043E\u0442\u0440\u044F\u0434 \u0441\u043A\u0435\u043B\u0435\u0442\u043E\u0432
          \u0438 \u0443\u043F\u044B\u0440\u0435\u0439 \u043F\u043E\u0434 \u043F\u0440\u0435\u0434\u0432\u043E\u0434\u0438\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E\u043C
          \u043F\u043E\u043B\u0443\u0441\u0433\u043D\u0438\u0432\u0448\u0435\u0433\u043E
          \u0440\u044B\u0446\u0430\u0440\u044F.\r\n\r\n\u201C\u041F\u0443\u0441\u0442\u044C
          \u043D\u0430\u0441\u043B\u0435\u0434\u043D\u0438\u043A \u0438 \u043D\u0435
          \u0441\u043F\u0440\u0430\u0432\u0438\u043B\u0441\u044F, \u043D\u043E \u0421\u043E\u0441\u0443\u0434
          \u0437\u0434\u0435\u0441\u044C\u201D - \u043C\u043E\u0433\u0438\u043B\u044C\u043D\u044B\u043C
          \u0433\u043E\u043B\u043E\u0441\u043E\u043C \u0433\u043E\u0432\u043E\u0440\u0438\u043B
          \u043F\u0440\u0435\u0434\u0432\u043E\u0434\u0438\u0442\u0435\u043B\u044C
          - \u201C\u041B\u0443\u0447\u0448\u0435 \u043D\u0435 \u0441\u0440\u0430\u0436\u0430\u0439\u0442\u0435\u0441\u044C,
          \u0438 \u043C\u044B \u0443\u0439\u0434\u0451\u043C.\u201D\r\n\r\n\u041D\u0430\u043C\u0435\u0441\u0442\u043D\u0438\u043A
          \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u043E \u043F\u043E\u0434\u043D\u044F\u043B
          \u0432\u0437\u043E\u0440 \u043D\u0430 \u0437\u0430\u0433\u0440\u043E\u0431\u043D\u044B\u0445.\r\n\u201C\u041E\u043D\u0430
          \u043C\u0435\u0440\u0442\u0432\u0430, \u0442\u0451\u043C\u043D\u044B\u0439
          \u043F\u0440\u0435\u0434\u0432\u043E\u0434\u0438\u0442\u0435\u043B\u044C.
          \u041D\u0430\u043C \u043D\u0435\u0442 \u043D\u0443\u0436\u0434\u044B \u0441\u0440\u0430\u0436\u0430\u0442\u044C\u0441\u044F.\u201D\r\n\r\n\u201C\u0413\u0440\u044F\u0434\u0451\u0442
          \u0442\u044C\u043C\u0430. \u041A\u0443\u0434\u0430 \u0441\u0442\u0440\u0430\u0448\u043D\u0435\u0435
          \u0438 \u0433\u0443\u0449\u0435 \u0442\u043E\u0439, \u0447\u0442\u043E
          \u0436\u0438\u0432\u0451\u0442 \u0432 \u0442\u0432\u043E\u0435\u0439 \u0434\u043E\u0447\u0435\u0440\u0438.
          \u041E\u043D\u0430 \u043F\u043E\u0433\u043B\u043E\u0442\u0438\u0442 \u0438
          \u0441\u043C\u0435\u0440\u0442\u043D\u044B\u0445, \u0438 \u0437\u0430\u0433\u0440\u043E\u0431\u043D\u044B\u0445.
          \u041D\u0430\u043C \u043D\u0443\u0436\u043D\u044B \u0432\u0441\u0435 \u0441\u0438\u043B\u044B,
          \u0447\u0442\u043E\u0431\u044B \u0441\u043F\u0430\u0441\u0442\u0438\u0441\u044C.
          \u0415\u0441\u043B\u0438 \u043C\u044B \u043D\u0435 \u0432\u044B\u043F\u0443\u0441\u0442\u0438\u043C
          \u0442\u044C\u043C\u0443 \u0438\u0437 \u0410\u0440\u0438\u0441\u044B, \u0442\u043E
          \u043F\u043E\u0433\u0438\u0431\u043D\u0443\u0442 \u0432\u0441\u0435. \u041E\u0442\u0434\u0430\u0439
          \u0434\u043E\u0447\u044C \u043C\u0438\u0440\u043E\u043C, \u043D\u0435 \u044E\u043B\u0438.\u201D\r\n\r\n\u0412\u0430\u043C
          \u043D\u0443\u0436\u043D\u043E \u0443\u0431\u0435\u0434\u0438\u0442\u044C
          \u0437\u0430\u0433\u0440\u043E\u0431\u043D\u044B\u0445, \u0447\u0442\u043E
          \u0410\u0440\u0438\u0441\u0430 \u043C\u0435\u0440\u0442\u0432\u0430.\r\n"
