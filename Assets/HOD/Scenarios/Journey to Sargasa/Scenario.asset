        character: {fileID: 11400000, guid: df5ced05feaf7d2438a27afab49786cf, type: 2}
        clip: {fileID: 0}
        animType: 0
        camPositionNumber: 0
        replicaText: "\u0412\u044B \u043F\u043E\u0441\u043B\u0443\u0448\u0430\u043B\u0438\u0441\u044C
          \u0438 \u0443\u0432\u0438\u0434\u0435\u043B\u0438, \u043A\u0430\u043A \u0434\u0435\u0432\u0443\u0448\u043A\u0430
          \u043F\u0440\u0438\u043B\u043E\u0436\u0438\u043B\u0430 \u0440\u0443\u043A\u0438
          \u043A \u0437\u0435\u043C\u043B\u0435. \u0421\u0440\u0435\u0434\u0438 \u0448\u0430\u043C\u0430\u043D\u043E\u0432
          \u043D\u0430\u0447\u0430\u043B\u0430\u0441\u044C \u043F\u0430\u043D\u0438\u043A\u0430.
          \u041D\u0430 \u043D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u043E\u043C
          \u0432\u0430\u043C \u043D\u0430\u0440\u0435\u0447\u0438\u0438 \u043E\u043D\u0438
          \u043F\u0435\u0440\u0435\u0433\u043E\u0432\u0430\u0440\u0438\u0432\u0430\u043B\u0438\u0441\u044C
          \u0434\u0440\u0443\u0433 \u0441 \u0434\u0440\u0443\u0433\u043E\u043C, \u043D\u0435
          \u0440\u0435\u0448\u0430\u044F\u0441\u044C \u0443\u0434\u0430\u0440\u0438\u0442\u044C. 
          \u201C\n\n\"\u041E\u043D\u0430 \u0441\u043C`\u044D\u0440\u0442\u044C\u201D
          - \u043A\u0440\u0438\u0447\u0430\u043B \u0432\u0430\u043C \u043E\u0434\u0438\u043D
          \u0438\u0437 \u043A\u043B\u044C\u0442\u0438\u0441\u0442\u043E\u0432.  \n\n\u0412
          \u044D\u0442\u043E \u0436\u0435 \u0432\u0440\u0435\u043C\u044F \u0432\u044B
          \u0441\u043B\u044B\u0448\u0430\u043B\u0438, \u043A\u0430\u043A \u043B\u0435\u0441
          \u0448\u0443\u043C\u0438\u0442. \u041F\u043E-\u043E\u0441\u043E\u0431\u043E\u043C\u0443.
          \u041A\u043E\u0440\u043D\u0438 \u043D\u0430\u0447\u0430\u043B\u0438 \u0441\u043F\u0443\u0442\u044B\u0432\u0430\u0442\u044C
          \u0438 \u0434\u0443\u0448\u0438\u0442\u044C \u0432\u0441\u0435\u0445 \u0448\u0430\u043C\u0430\u043D\u043E\u0432
          \u043D\u0430 \u043F\u043E\u043B\u044F\u043D\u0435. \u0421\u043F\u0443\u0441\u0442\u044F
          \u043F\u0430\u0440\u0443 \u043C\u0438\u043D\u0443\u0442, \u0410\u0440\u0438\u0441\u0430
          \u043D\u0435 \u043E\u0441\u0442\u0430\u0432\u0438\u043B\u0430 \u0432 \u0436\u0438\u0432\u044B\u0445
