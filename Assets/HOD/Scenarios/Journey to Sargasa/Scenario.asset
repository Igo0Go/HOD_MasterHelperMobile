      replicaInformation:
        alreadyUsed: 0
        character: {fileID: 11400000, guid: df5ced05feaf7d2438a27afab49786cf, type: 2}
        clip: {fileID: 0}
        animType: 0
        camPositionNumber: 0
        replicaText: "\u2013 \u0421\u0442\u0440\u0430\u043D\u0438\u0446\u0430 23
          \u2013\r\n\r\n\u0418\u0437\u0434\u0440\u0435\u0432\u043B\u0435 \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u043E,
          \u0447\u0442\u043E \u0421\u0430\u0440\u0433\u0430\u0441\u0430 - \u043C\u0430\u0442\u0435\u0440\u0438\u043A
          \u043B\u0438\u0448\u044C \u0432 \u0443\u043C\u0430\u0445 \u043B\u044E\u0434\u0435\u0439,
          \u043E\u0442 \u043A\u0430\u0440\u0442 \u0434\u0430\u043B\u0451\u043A\u0438\u0445.
          \u0421\u0430\u0440\u0433\u0430\u0441\u0430 -  \u044D\u0442\u043E \u043D\u0435
          \u0431\u043E\u043B\u0435\u0435 \u0447\u0435\u043C \u043E\u0441\u0442\u0440\u043E\u0432
          \u0432 \u043F\u0440\u0435\u0441\u043D\u043E\u0432\u043E\u0434\u043D\u043E\u043C
          \u043C\u043E\u0440\u0435. \u041D\u043E \u043F\u043E \u0441\u0432\u043E\u0438\u043C
          \u0440\u0430\u0437\u043C\u0435\u0440\u0430\u043C \u043E\u043D \u0441\u043E\u043F\u043E\u0441\u0442\u0430\u0432\u0438\u043C
          \u0441\u043E \u0432\u0441\u0435\u043C \u043F\u0440\u0435\u0434\u0435\u043B\u043E\u043C
          \u0426\u0435\u043F\u0430 \u043D\u0430 \u044E\u0433\u0435.\r\n\r\n\u041A\u0430\u043A
          \u0440\u0430\u0437 \u043E\u0442\u0442\u0443\u0434\u0430 \u0438 \u043F\u0440\u0438\u043F\u043B\u044B\u043B\u0438
          \u043F\u0435\u0440\u0432\u044B\u0435 \u043F\u043E\u0441\u0435\u043B\u0435\u043D\u0446\u044B
          \u0432 \u044D\u0442\u0438 \u0437\u0435\u043C\u043B\u0438. \u0421\u043D\u0430\u0447\u0430\u043B\u0430
          \u043C\u043E\u0440\u044F\u043A\u0438 \u043F\u043E\u0434 \u043F\u0440\u0435\u0434\u0432\u043E\u0434\u0438\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E\u043C
          \u041A\u043E\u043B\u044F\u0431\u0430 \u041C\u043E\u043D\u0442\u0435\u0440\u0430
          \u043D\u0430\u0448\u043B\u0438 \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0439
          \u043E\u0441\u0442\u0440\u043E\u0432\u043E\u043A, \u043D\u0430\u0437\u0432\u0430\u043D\u043D\u044B\u0439
          \u043F\u043E\u0437\u0436\u0435 \u041C\u043E\u043D\u0442\u0435\u0440\u0440\u043E\u0439.
          \u041F\u043E\u0437\u0436\u0435 \u043E\u043D \u043F\u043E\u0441\u0435\u043B\u0438\u043B\u0441\u044F
          \u043D\u0430 \u0421\u0430\u0440\u0433\u0430\u0441\u0435 \u0438 \u0443\u0447\u0430\u0441\u0442\u0432\u043E\u0432\u0430\u043B
          \u0432 \u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u0438
          \u0433\u043E\u0440\u043E\u0434\u0430 \u0418\u0437\u043B\u0438\u0435\u043D\u0430,
          \u0432\u0437\u044F\u0432 \u0441\u0435\u0431\u0435 \u0433\u0435\u0440\u0431
          \u0441 \u0432\u043E\u0434\u043E\u0446\u0432\u0435\u0442\u043E\u043C \u0438
          \u043E\u0433\u043D\u0435\u0436\u0430\u0440\u043E\u043C. \u041D\u044B\u043D\u0435
          \u044D\u0442\u0430 \u0441\u0435\u043C\u044C\u044F \u0432\u0435\u0440\u043D\u0443\u043B\u0430\u0441\u044C
          \u043E\u0431\u0440\u0430\u0442\u043D\u043E \u0432 \u043F\u0440\u0435\u0434\u0435\u043B\u044B
          \u0426\u0435\u043F\u0430.\r\n\r\n\u0412\u043C\u0435\u0441\u0442\u0435 \u0441
          \u041A\u043E\u043B\u044F\u0431\u043E\u043C \u043D\u0430 \u043A\u043E\u0440\u0430\u0431\u043B\u0435
          \u0431\u044B\u043B \u0438 \u0423\u0440\u0434\u0440\u0438\u043B \u0422\u0430\u0430\u043A.
          \u041E\u043D \u0437\u0430\u0431\u0440\u0430\u043B\u0441\u044F \u0443\u0436\u0435
          \u0432\u0433\u043B\u0443\u0431\u044C \u043E\u0441\u0442\u0440\u043E\u0432\u0430
          \u0421\u0430\u0440\u0433\u0430\u0441\u044B, \u0433\u0434\u0435 \u0441\u0442\u043E\u043B\u043A\u043D\u0443\u043B\u0441\u044F
          \u0441 \u043D\u0435\u0432\u0435\u0434\u043E\u043C\u043E\u0439 \u0434\u043E\u0441\u0435\u043B\u0435
          \u043D\u0430\u043F\u0430\u0441\u0442\u044C\u044E - \u0437\u0430\u0433\u0440\u043E\u0431\u043D\u044B\u043C\u0438.
          \u0412\u0441\u0435 \u0437\u043D\u0430\u044E\u0442, \u0447\u0442\u043E \u043F\u043E\u0441\u043B\u0435
          \u0423\u0440\u0434\u0440\u0438\u043B \u0432\u043E\u0437\u0433\u043B\u0430\u0432\u0438\u043B
          \u201C\u0432\u0435\u043B\u0438\u043A\u0443\u044E \u0447\u0438\u0441\u0442\u043A\u0443
          \u0437\u0435\u043C\u0435\u043B\u044C\u201D \u0438 \u0438\u0437\u0433\u043D\u0430\u043B
          \u0437\u0430\u0433\u0440\u043E\u0431\u043D\u044B\u0445 \u043F\u0440\u043E\u0447\u044C,
          \u043F\u043E\u043B\u0443\u0447\u0438\u0432 \u0437\u0430 \u044D\u0442\u043E
          \u043F\u043E\u0447\u0451\u0442\u043D\u043E\u0435 \u0437\u0432\u0430\u043D\u0438\u0435
          \u0445\u0435\u0441\u0430 \u0421\u0430\u0440\u0433\u0430\u0441\u044B. \u042D\u0442\u043E\u0442
          \u0440\u043E\u0434 \u043D\u044B\u043D\u0435 \u043F\u0440\u0430\u0432\u0438\u0442
          \u043D\u0430\u0448\u0438\u043C\u0438 \u0437\u0435\u043C\u043B\u044F\u043C\u0438.\r\n\r\n\u041D\u043E
          \u043C\u0430\u043B\u043E \u043A\u043E\u043C\u0443 \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u043E,
          \u0447\u0442\u043E \u0432 \u0432\u0435\u043B\u0438\u043A\u043E\u0439 \u0447\u0438\u0441\u0442\u043A\u0435
          \u0443\u0447\u0430\u0441\u0442\u0432\u043E\u0432\u0430\u043B \u0432\u043E\u0435\u043D\u043D\u0430\u0447\u0430\u043B\u044C\u043D\u0438\u043A
          \u0438 \u0432\u0435\u0440\u043D\u044B\u0439 \u0434\u0440\u0443\u0433 \u0423\u0440\u0434\u0440\u0438\u043B\u0430
          - \u0422\u043E\u043B\u0435\u0434\u0430\u0441 \u0414\u043E\u0440\u0435\u0441.
          \u0427\u0430\u0441\u0442\u043E, \u0438\u043C\u0435\u043D\u043D\u043E \u043E\u043D
          \u0441\u0440\u0430\u0436\u0430\u043B\u0441\u044F \u0441 \u0441\u0430\u043C\u044B\u043C\u0438
          \u0441\u0438\u043B\u044C\u043D\u044B\u043C\u0438 \u043E\u0442\u0440\u044F\u0434\u0430\u043C\u0438
          \u0442\u044C\u043C\u044B. \u0414\u043E\u0440\u0435\u0441 \u043F\u043E\u0441\u043B\u0435
          \u0437\u0430\u043B\u043E\u0436\u0438\u043B \u0433\u043E\u0440\u043E\u0434
          \u0421\u0430\u0440\u0433\u0443, \u0430 \u0435\u0433\u043E \u043F\u043E\u0442\u043E\u043C\u043A\u0438
          \u0431\u044B\u043B\u0438 \u0442\u0430\u043C \u043D\u0430\u043C\u0435\u0441\u0442\u043D\u0438\u043A\u0430\u043C\u0438.\r\n\r\n\u041D\u043E
          \u043C\u0430\u043B\u043E \u043A\u0442\u043E \u0437\u043D\u0430\u0435\u0442
          \u043F\u0440\u043E \u0435\u0449\u0451 \u043E\u0434\u0438\u043D \u0440\u043E\u0434.
          \u0422\u0430\u0448\u0430\u0439\u0430 \u041A\u0430\u0430\u043D - \u0434\u0435\u0432\u0443\u0448\u043A\u0430
          \u0438\u0437 \u043F\u043B\u0435\u0435\u043C\u0435\u043D\u0438 \u043A\u043E\u0440\u0435\u043D\u043D\u044B\u0445
          \u0421\u0430\u0440\u0433\u0430\u0441\u0446\u0435\u0432 \u0425\u0430\u043D\u043E\u043B\u0443
          \u043F\u0435\u0440\u0432\u043E\u0439 \u0432\u044B\u0443\u0447\u0438\u043B\u0430
          \u044F\u0437\u044B\u043A \u043F\u0440\u0438\u0448\u0435\u043B\u044C\u0446\u0435\u0432.
          \u0412\u043E \u043C\u043D\u043E\u0433\u043E\u043C \u0435\u0451 \u0437\u0430\u0441\u043B\u0443\u0433\u0430
          \u0432 \u0442\u043E\u043C, \u0447\u0442\u043E \u0437\u0430\u0441\u0435\u043B\u0435\u043D\u0438\u0435
          \u0421\u0430\u0440\u0433\u0430\u0441\u044B \u043F\u0440\u043E\u0448\u043B\u043E
          \u043C\u0438\u0440\u043D\u043E. \u041E\u043D\u0438 \u0441 \u0422\u043E\u043B\u0435\u0434\u0430\u0441\u043E\u043C
          \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u043B\u0438\u0441\u044C \u0432\u043E
          \u0432\u0440\u0435\u043C\u044F \u043E\u0434\u043D\u043E\u0433\u043E \u0438\u0437
          \u043F\u043E\u0445\u043E\u0434\u043E\u0432 \u0422\u0430\u0430\u043A\u0430.
          \r\n\u0423\u0436\u0435 \u043F\u043E\u0441\u043B\u0435 \u0432\u0435\u043B\u0438\u043A\u043E\u0439
          \u0447\u0438\u0441\u0442\u043A\u0438 \u0422\u043E\u043B\u0435\u0434\u0430\u0441
          \u0432\u0437\u044F\u043B \u0422\u0430\u0448\u0430\u0439\u0443 \u0432 \u0436\u0451\u043D\u044B,
          \u0430 \u0432 \u0447\u0435\u0441\u0442\u044C \u0435\u0434\u0438\u043D\u0435\u043D\u0438\u044F
          \u0434\u0432\u0443\u0445 \u043D\u0430\u0440\u043E\u0434\u043E\u0432, \u043E\u043D\u0438
          \u043E\u0431\u044A\u0435\u0434\u0438\u043D\u0438\u043B\u0438 \u0440\u043E\u0434
          \u0438 \u0441\u0442\u0430\u043B\u0438 \u0437\u0432\u0430\u0442\u044C\u0441\u044F
          \u0414\u043E\u0440\u0435\u0441\u041A\u0430\u0430\u043D\u2026\r"
