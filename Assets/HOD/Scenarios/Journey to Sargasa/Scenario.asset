          \u041F\u0430\u043A\u0430\u043B\u0435\u0442, \u043A\u0430\u043A \u043C\u043E\u0433,
          \u0437\u0430\u0449\u0438\u0449\u0430\u043B \u0435\u0433\u043E. \n\n\u0418
          \u0432\u043E\u0442, \u043D\u0430 \u0432\u0430\u0448 \u043A\u043E\u0440\u0430\u0431\u043B\u044C
          \u0441\u0442\u0443\u043F\u0438\u043B \u0441\u0430\u043C \u043A\u0430\u043F\u0438\u0442\u0430\u043D.
