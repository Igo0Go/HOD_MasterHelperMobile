          \u0432\u0441\u0435\u0445 \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u043E\u0432.
          \u041A \u0441\u043E\u0436\u0430\u043B\u0435\u043D\u0438\u044E, \u043E\u0434\u0438\u043D
          \u0438\u0437 \u043C\u0430\u0433\u043E\u0432 \u0430\u0442\u0430\u043A\u043E\u0432\u0430\u043B
          \u0435\u0433\u043E \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u0438\u0435\u043C
          \u0448\u043A\u043E\u043B\u044B \u043C\u043E\u0440\u043E\u0437\u0430. \u041F\u0440\u043E\u0440\u043E\u0441\u043B\u0438\u043A
          \u043F\u043E\u0433\u043B\u043E\u0442\u0438\u043B \u0432\u043E\u0434\u0443.\r\n\r\n\u041F\u0440\u0438\u0448\u043B\u043E
          \u0432\u0440\u0435\u043C\u044F \u0435\u043C\u0443 \u043F\u0443\u0441\u0442\u0438\u0442\u044C
          \u043A\u043E\u0440\u043D\u0438. \u0412\u0441\u0435 \u0432\u044B \u0432\u044B\u0448\u043B\u0438
          \u0432\u043E \u0434\u0432\u043E\u0440 \u0431\u0438\u0431\u043B\u0438\u043E\u0442\u0435\u043A\u0438.
          \u041E\u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C, \u0447\u0442\u043E
          \u0431\u043E\u0438 \u0441\u0442\u0438\u0445\u043B\u0438. \u0412\u0438\u0434\u0438\u043C\u043E,
          \u043C\u044F\u0442\u0435\u0436 \u043F\u043E\u0434\u0430\u0432\u043B\u0435\u043D.
          \u041F\u0440\u043E\u0440\u043E\u0441\u043B\u0438\u043A \u0434\u043E\u043F\u043E\u043B\u0437
          \u0434\u043E \u043F\u0443\u0441\u0442\u043E\u0439 \u043A\u043B\u0443\u043C\u0431\u044B,
          \u043A\u043E\u0442\u043E\u0440\u0443\u044E \u0435\u0449\u0451 \u043D\u0435
          \u0443\u0441\u043F\u0435\u043B\u0438 \u0437\u0430\u0441\u0430\u0434\u0438\u0442\u044C.
          \u0412\u044B \u043F\u043E\u043F\u0440\u043E\u0449\u0430\u043B\u0438\u0441\u044C
          \u0441 \u043F\u0440\u043E\u0440\u043E\u0441\u043B\u0438\u043A\u043E\u043C,
          \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043D\u0430\u0432\u0435\u043A\u0438
          \u0443\u0441\u043D\u0443\u043B, \u0447\u0442\u043E\u0431\u044B \u043D\u0430\u0431\u0440\u0430\u0442\u044C
          \u0441\u0438\u043B, \u0433\u043E\u0442\u043E\u0432\u044F\u0441\u044C \u0441\u0442\u0430\u0442\u044C
          \u044D\u043D\u0442\u043E\u043C.\r\n\r\n\u0410 \u0432\u0430\u043C \u043F\u043E\u0440\u0430
          \u0431\u044B\u043B\u043E \u0441\u043D\u044F\u0442\u044C \u043F\u0440\u043E\u043A\u043B\u044F\u0442\u0438\u0435.\r"
