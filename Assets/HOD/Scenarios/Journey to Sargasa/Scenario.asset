        replicaText: "\u0421\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u043C \u043A
          \u0442\u0435\u043B\u0443 \u043F\u043E\u0434\u043E\u0448\u0451\u043B \u0423\u0440\u044F.
          \u041E\u043D \u043D\u0451\u0441 \u0441 \u0441\u043E\u0431\u043E\u0439 \u0442\u0443
          \u0441\u0430\u043C\u0443\u044E \u0440\u0430\u043F\u0438\u0440\u0443. \u041A\u0438\u0432\u043A\u043E\u043C
          \u043F\u043E\u043F\u0440\u043E\u0441\u0438\u043B \u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043D\u0438\u044F
          \u0443 \u0410\u043B\u044C\u044F\u043D\u0430\u044B. \u0422\u0430 \u043E\u0442\u0432\u0435\u0442\u0438\u043B\u0430
          \u0441\u043E\u0433\u043B\u0430\u0441\u0438\u0435\u043C. \u0423\u0440\u044F
          \u043F\u043E\u043B\u043E\u0436\u0438\u043B \u0440\u0430\u043F\u0438\u0440\u0443
          \u044D\u0444\u0435\u0441\u043E\u043C \u043D\u0430 \u0433\u0440\u0443\u0434\u0438
          \u041C\u0430\u0440\u0430, \u043D\u0430\u043F\u0440\u0430\u0432\u0438\u0432
          \u043B\u0435\u0437\u0432\u0438\u0435 \u043A \u0435\u0433\u043E \u043D\u043E\u0433\u0430\u043C. 
          \u0421\u043B\u043E\u0436\u0438\u043B \u043A\u0438\u0441\u0442\u0438 \u043A\u0430\u043F\u0438\u0442\u0430\u043D\u0430
          \u043D\u0430 \u0440\u0443\u043A\u043E\u044F\u0442\u0438 \u043A\u043B\u0438\u043D\u043A\u0430.
          \u0412\u044B \u043E\u0442\u043C\u0435\u0442\u0438\u043B\u0438, \u0447\u0442\u043E
          \u0433\u0434\u0435-\u0442\u043E \u043D\u0430 \u0440\u043E\u0434\u0438\u043D\u0435
          \u0432\u0438\u0434\u0435\u043B\u0438 \u043C\u043D\u043E\u0433\u043E \u043A\u043E\u0440\u043E\u043B\u0435\u0432\u0441\u043A\u0438\u0445
