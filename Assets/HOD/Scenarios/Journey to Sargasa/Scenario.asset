        clip: {fileID: 0}
        animType: 0
        camPositionNumber: 0
        replicaText: "\u0412\u044B \u043F\u043E\u043F\u0430\u043B\u0438 \u0432 \u0448\u0442\u043E\u0440\u043C.
          \u041D\u043E\u0432\u044B\u0439 \u043A\u0430\u043F\u0438\u0442\u0430\u043D
          \u0441\u0440\u0430\u0437\u0443 \u043F\u043E\u043D\u044F\u043B, \u0447\u0442\u043E
          \u0434\u0435\u043B\u043E \u0442\u0443\u0442 \u043D\u0435 \u0447\u0438\u0441\u0442\u043E.
          \u0412\u0435\u0442\u0440\u0430 \u0431\u044B\u043B\u0438 \u0435\u043C\u0443
          \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0437\u043D\u0430\u043A\u043E\u043C\u044B.
          \u041E\u043D\u0438 \u0431\u044B\u043B\u0438 \u0441\u043B\u0438\u0448\u043A\u043E\u043C
          \u0436\u0438\u0432\u044B\u0435. \u041A\u0430\u043F\u043B\u0438 \u0434\u043E\u0436\u0434\u044F,
          \u043F\u043E\u0434\u0433\u043E\u043D\u044F\u0435\u043C\u044B\u0435 \u0432\u0435\u0442\u0440\u043E\u043C
          \u0441\u0438\u043B\u044C\u043D\u043E \u0431\u0438\u043B\u0438 \u043F\u043E
          \u043B\u0438\u0446\u0443. \u0410 \u0432\u043F\u0435\u0440\u0435\u0434\u0438
          \u0442\u043E \u0438 \u0434\u0435\u043B\u043E \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u043B\u0438\u0441\u044C
          \u0432\u044B\u0441\u043E\u043A\u0438\u0435 \u0432\u0430\u043B\u044B, \u0433\u0440\u043E\u0437\u044F\u0449\u0438\u0435
          \u043F\u043E\u0445\u043E\u0440\u043E\u043D\u0438\u0442\u044C \u043F\u043E\u0434
          \u0441\u043E\u0431\u043E\u0439 \u041F\u0430\u0448\u043A\u0443. \u0418 \u0443\u0434\u0430\u0440\u044B
          \u043C\u043E\u043B\u043D\u0438\u0439 \u0441\u0432\u0435\u0440\u043A\u0430\u043B\u0438
          \u0432\u0441\u0451 \u0431\u043B\u0438\u0436\u0435."
