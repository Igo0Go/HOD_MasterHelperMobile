      replicaInformation:
        alreadyUsed: 0
        character: {fileID: 11400000, guid: df5ced05feaf7d2438a27afab49786cf, type: 2}
        clip: {fileID: 0}
        animType: 0
        camPositionNumber: 0
        replicaText: "\u041E\u043D \u0443\u0436\u0435 \u0443\u0441\u043F\u0435\u043B
          \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E \u043F\u043E\u0434\u0440\u0430\u0441\u0442\u0438
          \u0438 \u043F\u043E\u0442\u043E\u043C\u0443 \u0441\u043C\u043E\u0433 \u043B\u0435\u0433\u043A\u043E
          \u0441\u043F\u0440\u0430\u0432\u0438\u0442\u044C\u0441\u044F \u0441 \u0432\u0430\u0448\u0438\u043C\u0438
          \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0430\u043C\u0438.
          \u041A \u0441\u043E\u0436\u0430\u043B\u0435\u043D\u0438\u044E, \u043E\u0434\u0438\u043D
          \u0438\u0437 \u0448\u0430\u043C\u0430\u043D\u043E\u0432 \u0443\u0441\u043F\u0435\u043B
          \u043F\u0440\u0438\u043C\u0435\u043D\u0438\u0442\u044C \u043D\u0430 \u043F\u0440\u043E\u0440\u043E\u0441\u043B\u0438\u043A\u0430
          \u043A\u0430\u043A\u043E\u0435-\u0442\u043E \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u0438\u0435,
          \u0441\u0432\u044F\u0437\u0430\u043D\u043D\u043E\u0435 \u0441 \u0432\u043E\u0434\u043E\u0439.
          \u0412\u0430\u0448 \u043F\u0440\u043E\u0440\u043E\u0441\u043B\u0438\u043A
          \u0432\u043F\u0438\u0442\u0430\u043B \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E
          \u0432\u043E\u0434\u044B. \u0415\u043C\u0443 \u043F\u043E\u0440\u0430 \u0431\u044B\u043B\u043E
          \u043F\u0443\u0441\u0442\u0438\u0442\u044C \u043A\u043E\u0440\u043D\u0438.
          \n\n\u0412\u044B \u0441\u043C\u043E\u0433\u043B\u0438 \u0441\u0431\u0435\u0436\u0430\u0442\u044C
          \u0438 \u0441\u043A\u0440\u044B\u0442\u044C\u0441\u044F \u0434\u0430\u043B\u0435\u043A\u043E
          \u0432 \u043B\u0435\u0441\u0443. \u041A\u0443\u043B\u044C\u0442 \u043F\u043E\u0442\u0435\u0440\u044F\u043B
          \u0432\u0430\u0441. \u0412\u044B \u043F\u0440\u043E\u0432\u043E\u0434\u0438\u043B\u0438
          \u0434\u043E\u0431\u0440\u043E\u0433\u043E \u0434\u0440\u0443\u0433\u0430
          \u0438 \u0434\u0430\u043B\u0438 \u0435\u043C\u0443 \u0443\u0441\u043D\u0443\u0442\u044C
          \u043D\u0430 \u0432\u0435\u043A\u0430, \u0447\u0442\u043E\u0431\u044B \u043E\u043D
          \u043C\u043E\u0433 \u043D\u0430\u0431\u0440\u0430\u0442\u044C\u0441\u044F
          \u0441\u0438\u043B \u0438 \u0441\u0442\u0430\u0442\u044C \u044D\u043D\u0442\u043E\u043C."
