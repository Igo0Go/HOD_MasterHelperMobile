        replicaText: "\u0412\u044B \u0441\u043B\u0430\u0434\u043A\u043E \u0441\u043F\u0438\u0442\u0435:\n\n\u0421\u043F\u044F\u0449\u0438\u0435:
          \u0421\u0438\u043B\u044B +4\n\n\u041D\u043E\u0447\u044C\u044E \u0432\u044B
          \u0441\u043B\u044B\u0448\u0438\u0442\u0435 \u0437\u0432\u0443\u043A\u0438
          \u0431\u043E\u044F \u043D\u0430 \u0443\u043B\u0438\u0446\u0435. \u0412\u044B
          \u0432\u043E\u0432\u0440\u0435\u043C\u044F \u0443\u0441\u043F\u0435\u0432\u0430\u0435\u0442\u0435
          \u0441\u043F\u0440\u044F\u0442\u0430\u0442\u044C\u0441\u044F. \u0412 \u0431\u0438\u0431\u043B\u0438\u043E\u0442\u0435\u043A\u0443
          \u0437\u0430\u0431\u0435\u0433\u0430\u044E\u0442 \u0442\u0440\u043E\u0435
          \u043C\u0443\u0436\u0447\u0438\u043D. \u0414\u0432\u043E\u0435 \u0438\u0437
          \u043D\u0438\u0445 \u0441\u0442\u0440\u0430\u0436\u043D\u0438\u043A\u0438.
          \u0422\u0440\u0435\u0442\u0438\u0439 - \u043A\u0430\u043A\u043E\u0439-\u0442\u043E
          \u043E\u0444\u0438\u0446\u0435\u0440. \u041E\u043D\u0438 \u043D\u0430\u0447\u0430\u043B\u0438
          \u0431\u0430\u0440\u0438\u043A\u0430\u0434\u0438\u0440\u043E\u0432\u0430\u0442\u044C
          \u0432\u0445\u043E\u0434 \u0432 \u0431\u0438\u0431\u043B\u0438\u043E\u0442\u0435\u043A\u0443
