        camPositionNumber: 0
        replicaText: "\u0412\u0430\u043C \u0443\u0434\u0430\u043B\u043E\u0441\u044C
          \u0441\u043A\u0440\u044B\u0442\u044C\u0441\u044F \u043E\u0442 \u0441\u043C\u0435\u0440\u0442\u0438.
          \u0412\u044B \u0432\u044B\u0431\u0440\u0430\u043B\u0438\u0441\u044C \u0438\u0437
          \u0433\u043E\u0440\u043E\u0434\u0430 \u0438 \u0434\u043E\u0448\u043B\u0438
          \u0434\u043E \u0445\u043E\u043B\u043C\u0430, \u043E\u0442\u043A\u0443\u0434\u0430
          \u043D\u0430\u0431\u043B\u044E\u0434\u0430\u043B\u0438 \u0441 \u0432\u044B\u0441\u043E\u0442\u044B
          \u0437\u0430 \u0421\u0430\u0440\u0433\u043E\u0439. \u0422\u0451\u043C\u043D\u043E\u0435
          \u043F\u044F\u0442\u043D\u043E \u0434\u0432\u0438\u0433\u0430\u043B\u043E\u0441\u044C
