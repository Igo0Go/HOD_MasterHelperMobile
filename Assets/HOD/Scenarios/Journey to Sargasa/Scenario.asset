        replicaText: "\u0412\u0441\u0435: \u0421\u044B\u0442\u043E\u0441\u0442\u044C
          -1\n\u0427\u0430\u0441\u043E\u0432\u044B\u0435: \u0421\u0438\u043B\u044B
          -2\n\n\u0412\u044B \u0440\u0430\u0441\u043F\u0440\u0430\u0432\u0438\u043B\u0434\u0438
          \u043F\u043B\u0435\u0434\u044B \u0438 \u0441\u043E\u0431\u0440\u0430\u043B\u0438\u0441\u044C
          \u0443 \u043E\u0434\u043D\u043E\u0433\u043E \u0438\u0437 \u0441\u0442\u043E\u043B\u0438\u043A\u043E\u0432
          \u0431\u0438\u0431\u043B\u0438\u043E\u0442\u0435\u043A\u0438 \u0440\u0430\u0437\u043B\u043E\u0436\u0438\u0432
          \u043A\u043D\u0438\u0433\u0438. \u0428\u043B\u0438 \u0447\u0430\u0441\u044B.
          \u041B\u0430\u043C\u043F\u0430 \u0442\u0443\u0441\u043A\u043B\u043E \u043E\u0441\u0432\u0435\u0449\u0430\u043B\u0430
          \u043A\u043E\u043C\u043D\u0430\u0442\u0443. \u041A\u043D\u0438\u0433\u0438
          \u043E\u0434\u043D\u0430 \u0437\u0430 \u043E\u0434\u043D\u043E\u0439 \u043E\u0442\u043F\u0440\u0430\u0432\u043B\u044F\u043B\u0438\u0441\u044C
          \u0432 \u0441\u0442\u043E\u043F\u043A\u0443 \u0431\u0435\u0441\u043F\u043E\u043B\u0435\u0437\u043D\u044B\u0445.
          \u0412\u044B \u0435\u0449\u0451 \u0445\u043E\u0442\u0435\u043B\u0438 \u0432\u044B\u0441\u043F\u0430\u0442\u044C\u0441\u044F,
