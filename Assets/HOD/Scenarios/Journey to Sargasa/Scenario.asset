      replicaInformation:
        alreadyUsed: 0
        character: {fileID: 11400000, guid: df5ced05feaf7d2438a27afab49786cf, type: 2}
        clip: {fileID: 0}
        animType: 0
        camPositionNumber: 0
        replicaText: "\u041C\u0430\u0433, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
          \u043F\u044B\u0442\u0430\u043B\u0441\u044F \u0437\u0430\u0431\u0440\u0430\u0442\u044C
          \u043A\u043D\u0438\u0433\u0443 \u0431\u044B\u043B \u0432 \u0437\u0430\u043C\u0435\u0448\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0435.
          \u041D\u043E \u043D\u0435 \u0434\u043E\u043B\u0433\u043E.\n\n\u201C\u042F
          \u0434\u0443\u043C\u0430\u043B, \u0442\u0435\u0431\u044F \u0438\u0437\u0433\u043D\u0430\u043B\u0438.\u201D
          - \u0433\u043E\u0432\u043E\u0440\u0438\u043B \u043E\u043D - \u201C\u0414\u043E\u043A\u043E\u043B\u0435
          \u0442\u0435\u0440\u043F\u0435\u0442\u044C \u043E\u0442\u0440\u043E\u0434\u044C\u0435
          \u0442\u0435\u043D\u0435\u0439 \u0432 \u043D\u0430\u0448\u0435\u043C \u043C\u0438\u0440\u0435!\u201D\n\n\u041E\u043D
          \u043D\u0430\u0447\u0430\u043B \u0447\u0438\u0442\u0430\u0442\u044C \u0437\u0430\u043A\u043B\u044F\u0442\u0438\u0435,
          \u043D\u043E \u0410\u0440\u0438\u0441\u0430 \u043C\u0430\u0448\u0438\u043D\u0430\u043B\u044C\u043D\u043E
          \u0437\u0430\u043A\u0440\u044B\u043B\u0430\u0441\u044C. \u0412 \u0448\u043A\u043E\u043B\u0435
          \u0431\u043E\u044F \u044D\u0442\u043E\u0442 \u0436\u0435\u0441\u0442 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442\u0441\u044F
          \u0434\u043B\u044F \u043E\u0431\u0435\u0440\u0435\u0433\u0430, \u043D\u043E
          \u0441\u0435\u0439\u0447\u0430\u0441 \u0432\u0441\u0451 \u0441\u0440\u0430\u0431\u043E\u0442\u0430\u043B\u043E
          \u0438\u043D\u0430\u0447\u0435. \u041A\u0438\u0441\u0442\u0438 \u0410\u0440\u0438\u0441\u044B
          \u0432 \u043C\u043E\u043C\u0435\u043D\u0442 \u0432\u0437\u043C\u0430\u0445\u0430
          \u043D\u0435\u0441\u043B\u0438 \u043D\u0430 \u0441\u0435\u0431\u0435 \u0447\u0451\u0440\u043D\u0443\u044E
          \u0434\u044B\u043C\u043A\u0443. \u0418 \u0441\u0432\u043E\u0438\u043C \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0435\u043C
          \u043E\u043D\u0430 \u043A\u0430\u043A \u0431\u0443\u0434\u0442\u043E \u0440\u0430\u0437\u0440\u0435\u0437\u0430\u043B\u0430
          \u043C\u0430\u0433\u0430. \u0422\u043E\u0442 \u0443\u043F\u0430\u043B \u0437\u0430\u043C\u0435\u0440\u0442\u0432\u043E.\r\n\r\n\u0410\u0440\u0438\u0441\u0430
          \u0441\u0442\u043E\u044F\u043B\u0430 \u0432\u0441\u044F \u0431\u043B\u0435\u0434\u043D\u0430\u044F.
          \u0421\u043C\u043E\u0442\u0440\u0435\u043B\u0430 \u043D\u0430 \u0441\u0432\u043E\u0438
          \u0440\u0443\u043A\u0438 \u0438 \u043F\u044B\u0442\u0430\u043B\u0430\u0441\u044C
          \u043F\u043E\u043D\u044F\u0442\u044C, \u0447\u0442\u043E \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u0438\u0442.
          \u0414\u044B\u043C\u043A\u0430 \u0432\u0441\u0451 \u0431\u043E\u043B\u044C\u0448\u0435
          \u0440\u0430\u0441\u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u044F\u043B\u0430\u0441\u044C
          \u043F\u043E \u0440\u0443\u043A\u0430\u043C.\r \u041E\u043D\u0430 \u043D\u0430\u0447\u0430\u043B\u0430
          \u0441\u0443\u043C\u0430\u0442\u043E\u0448\u043D\u043E \u0441\u0442\u0440\u044F\u0445\u0438\u0432\u0430\u0442\u044C
          \u0435\u0451, \u043D\u043E \u043D\u0435 \u043F\u043E\u043B\u0443\u0447\u0430\u043B\u043E\u0441\u044C."
