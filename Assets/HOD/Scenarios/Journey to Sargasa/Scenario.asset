        replicaText: "\u201C\u0410 \u0437\u043D\u0430\u0439\u0442\u0435,\u201D -
          \u0441\u043A\u0430\u0437\u0430\u043B \u043E\u043D. - \u201C\u0414\u043E\u0431\u0440\u044B\u0435
          \u0432\u044B \u043B\u044E\u0434\u0438. \u0412\u043E\u0437\u044C\u043C\u0438\u0442\u0435
          \u043F\u0440\u043E\u0440\u043E\u0441\u043B\u0438\u043A\u0430 \u0441 \u0441\u043E\u0431\u043E\u0439.
          \u041F\u0443\u0441\u0442\u044C \u043F\u043E\u0432\u0438\u0434\u0430\u0435\u0442
          \u0434\u0440\u0443\u0433\u0438\u0435 \u0441\u0442\u0440\u0430\u043D\u044B.
          \u0410 \u0432\u0430\u043C \u043F\u043E\u043C\u043E\u0436\u0435\u0442. \u0411\u0430\u0443\u043B\u044B
          \u0432\u0430\u0448\u0438 \u0442\u0430\u0441\u043A\u0430\u0442\u044C. \u041C\u043E\u0438
          \u043F\u0440\u043E\u0440\u043E\u0441\u043B\u0438\u043A\u0438 \u043A\u0440\u0435\u043F\u043A\u0438\u0435.
          \u0422\u043E\u043B\u044C\u043A\u043E \u043F\u043E\u043B\u0438\u0432\u0430\u0442\u044C
          \u043D\u0435 \u0437\u0430\u0431\u044B\u0432\u0430\u0439\u0442\u0435. \u041D\u043E
          \u0435\u0441\u043B\u0438 \u0441\u0438\u043B\u044C\u043D\u043E \u0432\u044B\u0440\u0430\u0441\u0442\u0435\u0442,
          \u0441\u043C\u043E\u0442\u0440\u0438\u0442\u0435. \u0412\u043E\u0434\u044B
          \u0434\u043E\u0431\u0430\u0432\u0438\u0442\u0435, \u043E\u043D \u043A\u043E\u0440\u043D\u0438
