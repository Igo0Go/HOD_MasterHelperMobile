          \u043E\u0442\u0434\u0430\u0442\u044C. \u041F\u0443\u0441\u0442\u044C \u0443
          \u0442\u0435\u0431\u044F \u0431\u0443\u0434\u0435\u0442 \u0434\u0432\u0430
          \u043E\u0431\u0435\u0440\u0435\u0433\u0430. \u041E\u0434\u0438\u043D \u0441\u0435\u0431\u0435,
          \u0432\u0442\u043E\u0440\u043E\u0439 \u0438\u0437\u0431\u0440\u0430\u043D\u043D\u0438\u0446\u0435.
          \u0418 \u043E\u043D\u0438 \u0432\u0430\u0441 \u0441\u0431\u0435\u0440\u0435\u0433\u0443\u0442.\u201D\r\n\r\n\u041F\u0430\u043A\u0430\u043B\u0435\u0442
