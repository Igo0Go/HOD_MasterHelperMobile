  - nodeType: 1
    replicaNode:
      index: 673
      previousNodesNumbers: a0020000
      nextNodesNumbers: a4020000
      finalNode: 0
      leftToRight: 1
      transformRect:
        serializedVersion: 2
        x: 3672.1277
        y: 3970.5
        width: 150
        height: 50
      replicaInformation:
        alreadyUsed: 0
        character: {fileID: 11400000, guid: 77220b1acb9966744b74a9048bdcb6fd, type: 2}
        clip: {fileID: 0}
        animType: 0
        camPositionNumber: 0
        replicaText: "\u201C\u0421\u0430\u0440\u0433\u0430\u0441\u043E\u0439 \u043F\u0440\u0430\u0432\u0438\u0442
          \u0434\u0440\u0435\u0432\u043D\u0438\u0439 \u0440\u043E\u0434.\u201D -
          \u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0430 \u0410\u0440\u0438\u0441\u0430.
          - \u201C\u041F\u0440\u0430\u0432\u0434\u0430, \u043F\u043E \u043C\u043D\u0435\u043D\u0438\u044E
          \u043C\u043D\u043E\u0433\u0438\u0445, \u043F\u0440\u0430\u0432\u0438\u0442
          \u043D\u0435 \u043E\u0441\u043E\u0431\u043E \u0443\u043C\u0435\u043B\u043E.
          \u0411\u044B\u043B \u0433\u043E\u043B\u043E\u0434. \u0411\u0430\u043D\u0434\u0438\u0442\u044B
          \u043D\u0430\u043F\u0430\u0434\u0430\u043B\u0438 \u043D\u0430 \u0434\u0435\u0440\u0435\u0432\u043D\u0438,
          \u0430 \u0441 \u044D\u0442\u0438\u043C \u043D\u0438\u043A\u0442\u043E \u043D\u0435
          \u0431\u043E\u0440\u043E\u043B\u0441\u044F. \u0422\u043E\u0433\u0434\u0430
          \u043D\u0430\u043C\u0435\u0441\u0442\u043D\u0438\u043A \u0421\u0430\u0440\u0433\u0438
          \u0432\u0437\u044F\u043B \u0432\u0441\u0451 \u0432 \u0441\u0432\u043E\u0438
          \u0440\u0443\u043A\u0438. \u0421\u0435\u043C\u044C \u043B\u0435\u0442 \u043D\u0430\u0437\u0430\u0434
          \u043E\u043D \u043E\u0431\u044A\u044F\u0432\u0438\u043B \u0421\u0430\u0440\u0433\u0443
          \u043D\u0435\u0437\u0430\u0432\u0438\u0441\u0438\u043C\u043E\u0439. \u041F\u0440\u0438
          \u044D\u0442\u043E\u043C \u043C\u043D\u043E\u0433\u0438\u0435 \u0435\u0433\u043E
          \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u0430\u043B\u0438. \u041D\u0435\u0441\u043E\u0433\u043B\u0430\u0441\u043D\u044B\u0445
          \u043E\u043D \u0432\u044B\u0434\u0432\u043E\u0440\u0438\u043B \u0438\u0437
          \u0433\u043E\u0440\u043E\u0434\u0430, \u0433\u0434\u0435 \u0442\u0435\u0445
          \u0431\u044B\u0441\u0442\u0440\u043E \u043F\u043E\u0439\u043C\u0430\u043B\u0438
          \u0440\u0430\u0437\u0431\u043E\u0439\u043D\u0438\u043A\u0438.\r\n\u041F\u043E\u0442\u043E\u043C
          \u043D\u0430\u043C\u0435\u0441\u0442\u043D\u0438\u043A \u0437\u0430\u043D\u0438\u043C\u0430\u043B\u0441\u044F
          \u043F\u0440\u0438\u0432\u0435\u0434\u0435\u043D\u0438\u0435\u043C \u0421\u0430\u0440\u0433\u0438
          \u0432 \u043F\u043E\u0440\u044F\u0434\u043E\u043A. \u041E\u0442\u0431\u0438\u043B
          \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u043D\u0430\u043F\u0430\u0434\u043E\u043A
          \u043A\u043E\u0440\u043E\u043B\u044F. \u0410 \u043F\u043E\u0437\u0436\u0435
          \u0432\u043E\u043E\u0431\u0449\u0435 \u043D\u0430\u0447\u0430\u043B \u201C\u043E\u0441\u0432\u043E\u0431\u043E\u0436\u0434\u0430\u0442\u044C\u201D
          \u0441\u043E\u0441\u0435\u0434\u043D\u0438\u0435 \u0441\u0435\u043B\u0435\u043D\u0438\u044F.
          \u041C\u043D\u043E\u0433\u0438\u0435 \u0431\u044B\u043B\u0438 \u043D\u0435
          \u043F\u0440\u043E\u0442\u0438\u0432. \u041D\u0435\u0441\u043E\u0433\u043B\u0430\u0441\u043D\u044B\u0445
          \u043F\u0440\u043E\u0433\u043E\u043D\u044F\u043B\u0438. \u041D\u0430\u043C\u0435\u0441\u0442\u043D\u0438\u043A
          \u0434\u0435\u0439\u0441\u0442\u0432\u043E\u0432\u0430\u043B \u0436\u0451\u0441\u0442\u043A\u043E.
          \u041E\u0441\u043E\u0431\u043E \u0431\u0443\u0439\u043D\u044B\u0445 \u043A\u0430\u0437\u043D\u0438\u043B\u0438.\r\n\u041A\u043E\u0440\u043E\u043B\u044C
          \u0442\u0435\u043C \u0432\u0440\u0435\u043C\u0435\u043D\u0435\u043C \u0443\u043C\u0435\u0440.
          \u0412\u0441\u0451 \u0433\u043E\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u043E,
          \u043A\u0440\u043E\u043C\u0435 \u0437\u0435\u043C\u0435\u043B\u044C \u043D\u0430\u043C\u0435\u0441\u0442\u043D\u0438\u043A\u0430
          \u0441\u0435\u0439\u0447\u0430\u0441 \u0432 \u043F\u043B\u0430\u0447\u0435\u0432\u043D\u043E\u043C
          \u0441\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u0438. \u041D\u043E \u043F\u043E\u044F\u0432\u0438\u043B\u0441\u044F
          \u043D\u0430\u0441\u043B\u0435\u0434\u043D\u0438\u043A. \u041E\u043D \u0440\u0435\u0448\u0438\u043B
          \u0432\u043D\u043E\u0432\u044C \u043E\u0431\u044A\u0435\u0434\u0438\u043D\u0438\u0442\u044C
          \u0432\u0441\u044E \u0421\u0430\u0440\u0433\u0430\u0441\u0443. \u0421\u043E\u0431\u0440\u0430\u043B
          \u0431\u043E\u043B\u044C\u0448\u043E\u0435 \u0432\u043E\u0439\u0441\u043A\u043E.
          \u041B\u044E\u0434\u0438 \u0431\u043E\u044F\u0442\u044C\u0441\u044F \u0432\u043E\u0439\u043D\u044B\u2026\u201D\r"
