          \u0441 \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u0432\u0448\u0438\u043C
          \u043C\u0438\u043C\u043E \u043C\u0430\u0433\u043E\u043C. \u0422\u043E\u0442
          \u0443\u0440\u043E\u043D\u0438\u043B \u0447\u0442\u043E-\u0442\u043E. \u0418
          \u044D\u0442\u043E \u0447\u0442\u043E-\u0442\u043E \u0440\u0430\u0437\u0431\u0438\u043B\u043E\u0441\u044C,
          \u0432\u044B\u043F\u0443\u0441\u0442\u0438\u0432 \u0447\u0451\u0440\u043D\u044B\u0439
