        clip: {fileID: 0}
        animType: 0
        camPositionNumber: 0
        replicaText: "\u0412\u044B \u0441\u043C\u043E\u0433\u043B\u0438 \u0443\u0446\u0435\u043F\u0438\u0442\u044C\u0441\u044F
          \u0437\u0430 \u043A\u0430\u043A\u043E\u0439-\u0442\u043E \u0438\u0437 \u043E\u0431\u043B\u043E\u043C\u043A\u043E\u0432.
          \u041E\u0437\u0438\u0440\u0430\u044F\u0441\u044C \u043F\u043E \u0441\u0442\u043E\u0440\u043E\u043D\u0430\u043C,
          \u0432\u044B \u043F\u044B\u0442\u0430\u043B\u0438\u0441\u044C \u043D\u0430\u0439\u0442\u0438
          \u0442\u043E\u0432\u0430\u0440\u0438\u0449\u0435\u0439. \u042D\u0442\u043E
          \u0432\u0430\u043C \u0443\u0434\u0430\u043B\u043E\u0441\u044C, \u043D\u043E
          \u043D\u0438\u043A\u043E\u0433\u043E \u0438\u0437 \u044D\u043A\u0438\u043F\u0430\u0436\u0430
          \u201C\u0427\u0435\u0440\u0435\u043F\u0430\u0448\u043A\u0438 \u041F\u0430\u0448\u043A\u0438\u201D
          \u0432\u044B \u0442\u0430\u043A \u0438 \u043D\u0435 \u0443\u0432\u0438\u0434\u0435\u043B\u0438.
          \u0414\u0430\u0436\u0435 \u0442\u0435\u043B.\n\u041D\u0435 \u0431\u044B\u043B\u043E
          \u0438 \u0432\u0430\u0448\u0435\u0433\u043E \u043F\u0440\u043E\u0440\u043E\u0441\u043B\u0438\u043A\u0430.
          \u0415\u0434\u0432\u0430 \u043B\u0438 \u043E\u043D, \u0442\u0430\u043A\u043E\u0439
          \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0439, \u0431\u044B\u043B
          \u0441\u043F\u043E\u0441\u043E\u0431\u0435\u043D \u0442\u0430\u043A \u0434\u043E\u043B\u0433\u043E
          \u0434\u0435\u0440\u0436\u0430\u0442\u044C\u0441\u044F \u043D\u0430 \u0432\u043E\u0434\u0435.
          \u0412\u044B \u0442\u0430\u043A \u0438 \u043D\u0435 \u0441\u043C\u043E\u0433\u043B\u0438
          \u043D\u0430\u0439\u0442\u0438 \u0435\u0433\u043E \u0441\u0440\u0435\u0434\u0438
          \u043E\u0431\u043B\u043E\u043C\u043A\u043E\u0432.  \u041D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
          \u0447\u0430\u0441\u043E\u0432 \u0432\u044B \u043F\u043E\u0442\u0438\u0445\u043E\u043D\u044C\u043A\u0443
          \u043F\u043B\u044B\u043B\u0438 \u043F\u043E \u043C\u043E\u0440\u044E \u043D\u0430
          \u043A\u0430\u043A\u043E\u0439-\u0442\u043E \u0447\u0430\u0441\u0442\u0438
          \u043A\u043E\u0440\u0430\u0431\u043B\u044F, \u043D\u043E \u0432 \u0438\u0442\u043E\u0433\u0435
          \u0432\u0441\u0451 \u0436\u0435 \u0432\u044B\u0448\u043B\u0438 \u043D\u0430
          \u043A\u0430\u043A\u043E\u0439-\u0442\u043E \u0431\u0435\u0440\u0435\u0433.
          \u041E\u0431\u0435\u0441\u0441\u0438\u043B\u0435\u043D\u043D\u044B\u0435,
          \u0432\u044B \u043F\u0440\u043E\u0441\u0442\u043E \u0443\u0441\u043D\u0443\u043B\u0438
          \u043F\u0440\u044F\u043C\u043E \u043D\u0430 \u0431\u0435\u0440\u0435\u0433\u0443
          \u0438 \u043F\u0440\u043E\u0441\u043F\u0430\u043B\u0438 \u0442\u0430\u043A
          \u043E\u0447\u0435\u043D\u044C \u0434\u043E\u043B\u0433\u043E.\n\n\u0412\u0441\u0435:
          1 \u0423\u0440\u043E\u043D \u043C\u043E\u0440\u043E\u0437\u043E\u043C\n\u0412\u0441\u0435:
          \u0421\u0438\u043B\u044B = 2\n\u0412\u0441\u0435: \u0421\u044B\u0442\u043E\u0441\u0442\u044C
          -2"
