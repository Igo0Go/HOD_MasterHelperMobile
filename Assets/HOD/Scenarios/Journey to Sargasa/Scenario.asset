          \u043F\u0440\u0430\u0432\u0438\u0442\u0435\u043B\u044C \u0433\u043E\u0440\u043E\u0434\u0430
          \u0421\u0430\u0440\u0433\u0430 \u0438 \u043E\u043A\u0440\u0435\u0441\u0442\u043D\u044B\u0445
          \u0437\u0435\u043C\u0435\u043B\u044C. \u041A\u0430\u043A \u0432\u0438\u0434\u0438\u0442\u0435,
          \u0443 \u043D\u0430\u0441 \u0441\u0435\u0439\u0447\u0430\u0441 \u043D\u0435\u0441\u043F\u043E\u043A\u043E\u0439\u043D\u043E.
          \u041B\u044E\u0434\u0435\u0439 \u0432\u0435\u0440\u043D\u044B\u0445 \u0434\u043D\u0451\u043C
          \u0441 \u043E\u0433\u043D\u0451\u043C \u043D\u0435 \u0441\u044B\u0449\u0435\u0448\u044C.
          \u0412\u044B \u043F\u043E\u043A\u0430\u0437\u0430\u043B\u0438 \u0441\u0435\u0431\u044F
          \u0445\u043E\u0440\u043E\u0448\u0438\u043C\u0438 \u0431\u043E\u0439\u0446\u0430\u043C\u0438,
          \u043D\u043E \u044F \u0442\u0440\u0435\u0431\u0443\u044E \u043E\u0442 \u0441\u0432\u043E\u0438\u0445
          \u0432\u043E\u0439\u043D\u043E\u0432 \u043A\u0443\u0434\u0430 \u0431\u043E\u043B\u044C\u0448\u0435.
          \u041A\u0430\u0437\u043D\u0438\u0442\u0435 \u043F\u0440\u0435\u0441\u0442\u0443\u043F\u043D\u0438\u043A\u043E\u0432.
          \u0414\u043E\u043A\u0430\u0436\u0438\u0442\u0435 \u0442\u0432\u0451\u0440\u0434\u043E\u0441\u0442\u044C
          \u043D\u0430\u043C\u0435\u0440\u0435\u043D\u0438\u0439 \u0438 \u0431\u0435\u0439\u0442\u0435\u0441\u044C
          \u0441\u043E \u043C\u043D\u043E\u0439 \u0431\u043E\u043A \u043E \u0431\u043E\u043A.
          \u041F\u0440\u043E\u0433\u043E\u043D\u0438\u043C \u0437\u0430\u0440\u0430\u0437\u0443
          \u0441 \u044D\u0442\u0438\u0445 \u0437\u0435\u043C\u0435\u043B\u044C.\u201D"
