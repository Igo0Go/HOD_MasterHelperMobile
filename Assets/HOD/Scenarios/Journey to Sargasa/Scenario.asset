        replicaText: "\u201C\u042D\u0442\u043E \u041A\u043B\u0451\u043F\u0430.\u201D
          - \u0440\u0430\u0441\u0441\u0442\u0440\u043E\u0438\u043B\u0441\u044F \u043A\u0430\u043F\u0438\u0442\u0430\u043D.
