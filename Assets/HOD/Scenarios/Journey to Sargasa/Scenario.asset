        replicaText: "\u0412\u044B \u043D\u0435 \u0441\u043F\u0440\u0430\u0432\u043B\u044F\u0435\u0442\u0435\u0441\u044C.
          \u041A\u0443\u0445\u043D\u044F \u043D\u0430\u0447\u0430\u043B\u0430 \u043F\u043E\u043B\u043D\u043E\u0446\u0435\u043D\u043D\u043E
          \u043F\u0440\u043E\u0433\u043E\u0440\u0430\u0442\u044C. \u0412\u0434\u0440\u0443\u0433
          \u0432\u044B \u0443\u0432\u0438\u0434\u0435\u043B\u0438, \u043A\u0430\u043A
          \u0432\u0430\u0448 \u043F\u0440\u043E\u0440\u043E\u0441\u043B\u0438\u043A,
          \u0442\u043E\u043B\u044C\u043A\u043E \u043E\u0433\u0440\u043E\u043C\u043D\u044B\u0439
          \u043A\u0430\u043A \u0441\u0435\u043B\u044C\u0442\u0438\u0439\u0441\u043A\u0438\u0439
          \u0433\u0440\u0438\u0444\u043E\u043D, \u043F\u044C\u0451\u0442 \u0432\u043E\u0434\u0443
          \u0438\u0437 \u043F\u0440\u0435\u0441\u043D\u043E\u0432\u043E\u0434\u043D\u043E\u0433\u043E
          \u043C\u043E\u0440\u044F, \u0441\u0442\u0430\u043D\u043E\u0432\u044F\u0441\u044C
          \u0432\u0441\u0451 \u0431\u043E\u043B\u044C\u0448\u0435. \u0420\u0430\u0441\u043F\u0443\u0445\u043D\u0443\u0432,
          \u043A\u0430\u043A \u0433\u0443\u0431\u043A\u0430, \u043E\u043D \u0432\u044B\u043F\u043B\u0435\u0441\u043D\u0443\u043B
          \u0432\u0441\u044E \u0432\u043E\u0434\u0443 \u043D\u0430 \u043F\u043B\u0430\u043C\u044F
          \u0438 \u043F\u043E\u0442\u0443\u0448\u0438\u043B \u043F\u043E\u0436\u0430\u0440.
          \u0412\u0441\u0451 \u0431\u044B\u043B\u043E \u043A\u043E\u043D\u0447\u0435\u043D\u043E.
          \u041F\u043E\u0436\u0430\u0440 \u043F\u043E\u0442\u0443\u0448\u0435\u043D.
          \u0415\u0441\u0442\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E, \u043A\u0430\u043F\u0438\u0442\u0430\u043D
          \u0438 \u043A\u043E\u043C\u0430\u043D\u0434\u0430 \u0431\u044B\u043B\u0438
