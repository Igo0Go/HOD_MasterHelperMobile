          \u043E\u0442\u043A\u0443\u0434\u0430 \u0441\u043B\u044B\u0448\u0435\u043D
          \u0438\u0441\u0442\u043E\u0448\u043D\u044B\u0439 \u0432\u043E\u043F\u043B\u044C
          \u0442\u0451\u043C\u043D\u043E\u0439 \u0410\u0440\u0438\u0441\u044B.\r\n\r\n\u0412\u0434\u0440\u0443\u0433
          \u043F\u0443\u0442\u044C \u0432\u0430\u043C \u043F\u0440\u0435\u0433\u0440\u0430\u0434\u0438\u043B
