      replicaInformation:
        alreadyUsed: 0
        character: {fileID: 11400000, guid: df5ced05feaf7d2438a27afab49786cf, type: 2}
        clip: {fileID: 0}
        animType: 0
        camPositionNumber: 0
        replicaText: "\u041D\u043E \u044D\u0442\u043E\u0442 \u0432\u0435\u0447\u0435\u0440
          - \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u044B\u0439. \u0421\u0435\u0433\u043E\u0434\u043D\u044F
          \u043A\u0430\u043F\u0438\u0442\u0430\u043D \u041C\u0430\u0440 \u043F\u0440\u0430\u0437\u0434\u043D\u0443\u0435\u0442
          \u0441\u0432\u043E\u0439 49 \u0434\u0435\u043D\u044C \u0440\u043E\u0436\u0434\u0435\u043D\u0438\u044F.
          \u0415\u0441\u0442\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E, \u043F\u043E
          \u0442\u0430\u043A\u043E\u043C\u0443 \u0441\u043E\u0431\u044B\u0442\u0438\u044E
          \u043A\u043E\u043C\u0430\u043D\u0434\u0430 \u0440\u0435\u0448\u0438\u043B\u0430
          \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u043E\u0432\u0430\u0442\u044C
          \u043F\u0440\u0430\u0437\u0434\u043D\u0438\u043A.  \n\u0418 \u0432\u043E\u0442.
          \u0412\u0441\u0435 \u0432\u044B \u0437\u0430 \u0441\u0442\u043E\u043B\u043E\u043C.
          \u0418 \u043A\u0430\u043F\u0438\u0442\u0430\u043D \u0441\u0438\u0434\u0438\u0442,
          \u043D\u0435 \u0432\u044B\u043F\u0443\u0441\u043A\u0430\u044F \u0438\u0437
          \u0440\u0443\u043A \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0439
          \u043A\u0440\u0430\u0441\u043D\u044B\u0439 \u043A\u0430\u043C\u0435\u0448\u0435\u043A
          \u043D\u0430 \u043D\u0438\u0442\u043E\u0447\u043A\u0435. \u0412\u0441\u0435
          \u0432\u044B \u0437\u043D\u0430\u043B\u0438. \u042D\u0442\u043E \u201C\u0437\u0430\u0432\u0435\u0442\u043D\u043E\u0435
          \u0441\u043B\u043E\u0432\u043E\u201D \u043E\u0442 \u0435\u0433\u043E \u0441\u0443\u043F\u0440\u0443\u0433\u0438,
          \u0447\u0442\u043E \u0436\u0434\u0451\u0442 \u0435\u0433\u043E \u043D\u0430
          \u0440\u043E\u0434\u0438\u043D\u0435.  \u0422\u0435\u043C \u043D\u0435
          \u043C\u0435\u043D\u0435\u0435, \u043F\u0440\u0438\u0448\u043B\u043E \u0432\u0440\u0435\u043C\u044F
          \u043F\u043E\u0434\u0430\u0440\u043A\u043E\u0432. "
