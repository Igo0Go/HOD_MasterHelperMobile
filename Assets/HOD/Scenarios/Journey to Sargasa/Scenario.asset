          \u043D\u0430 \u043F\u043E\u043C\u043E\u0449\u044C \u0441\u0432\u043E\u0438\u043C
          \u0434\u0440\u0443\u0437\u044C\u044F\u043C. \u0412\u0438\u0434\u0438\u0442\u0435,
          \u0447\u0442\u043E \u0438\u0445 \u043F\u043E\u0447\u0442\u0438 \u043E\u043A\u0440\u0443\u0436\u0438\u043B\u0438.
          \u0412\u044B \u043D\u0435 \u043F\u0440\u0438\u0434\u0443\u043C\u044B\u0432\u0430\u0435\u0442\u0435
