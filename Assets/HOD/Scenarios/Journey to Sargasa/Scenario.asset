      replicaInformation:
        alreadyUsed: 0
        character: {fileID: 11400000, guid: df5ced05feaf7d2438a27afab49786cf, type: 2}
        clip: {fileID: 0}
        animType: 0
        camPositionNumber: 0
        replicaText: "\u0415\u0449\u0451 \u043D\u0435\u0434\u0435\u043B\u044F \u0432
          \u043C\u043E\u0440\u0435. \u0412\u0430\u043C \u043A\u0440\u0430\u0439\u043D\u0435
          \u043D\u0435 \u0432\u0435\u0437\u0451\u0442. \u0428\u0442\u0438\u043B\u044C.
          \u0415\u0449\u0451 \u0438 \u0441\u0442\u0440\u0430\u0448\u043D\u0430\u044F
          \u0436\u0430\u0440\u0430. \u041C\u043E\u0436\u0435\u0442, \u0432\u044B
          \u0438 \u043F\u0440\u0430\u0432\u0434\u0430 \u0441\u0432\u043E\u0438\u043C\u0438
          \u043F\u0440\u043E\u043A\u043B\u044F\u0442\u044C\u044F\u043C\u0438 \u043F\u0440\u0438\u0442\u044F\u0433\u0438\u0432\u0430\u0435\u0442\u0435
          \u043D\u0435\u0441\u0447\u0430\u0441\u0442\u044C\u044F? \u041F\u0430\u043A\u0430\u043B\u0435\u0442
          \u0431\u043E\u043B\u044C\u0448\u0435 \u0447\u0430\u0441\u0430 \u043F\u044B\u0442\u0430\u043B\u0441\u044F
          \u043F\u043E\u0439\u043C\u0430\u0442\u044C \u0445\u043E\u0442\u044C \u043A\u0430\u043A\u043E\u0439-\u0442\u043E
          \u0432\u0435\u0442\u0435\u0440 \u0438 \u043D\u0430\u0447\u0430\u0442\u044C
          \u0434\u0432\u0438\u0433\u0430\u0442\u044C\u0441\u044F, \u043D\u043E \u0441\u0434\u0430\u043B\u0441\u044F.
          \u041C\u0430\u0440 \u0437\u0430\u0440\u044B\u043B\u0441\u044F \u0432 \u043A\u043D\u0438\u0433\u0430\u0445,
          \u0447\u0442\u043E\u0431\u044B \u043D\u0430\u0439\u0442\u0438 \u0447\u0442\u043E-\u043D\u0438\u0431\u0443\u0434\u044C
          \u043E \u043C\u0430\u0433\u0438\u0438 \u043C\u043E\u0440\u0435\u0445\u043E\u0434\u043E\u0432.
          \u041E\u043D \u0445\u043E\u0447\u0435\u0442 \u043F\u0440\u0438\u0437\u0432\u0430\u0442\u044C
          \u043F\u043E\u043F\u0443\u0442\u043D\u044B\u0439 \u0432\u0435\u0442\u0435\u0440. "
