      replicaInformation:
        alreadyUsed: 0
        character: {fileID: 11400000, guid: df5ced05feaf7d2438a27afab49786cf, type: 2}
        clip: {fileID: 0}
        animType: 0
        camPositionNumber: 0
        replicaText: "\u0412\u0435\u0447\u0435\u0440\u0435\u0435\u0442. \u0412\u044B
          \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442\u0435\u0441\u044C
          \u043D\u0430 \u0431\u043E\u0440\u0442 \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u043E\u0433\u043E
          \u043A\u043E\u0440\u0430\u0431\u043B\u0438\u043A\u0430 \u043F\u043E\u0434
          \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u0435\u043C \u201C\u0427\u0435\u0440\u0435\u043F\u0430\u0448\u043A\u0430
          \u041F\u0430\u0448\u043A\u0430\u201D. \u0412\u0430\u043C \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F
          \u044F\u0441\u043D\u043E, \u0447\u0442\u043E \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u0435
          \u0442\u0430\u043A\u043E\u0435 \u043E\u043D \u043F\u043E\u043B\u0443\u0447\u0438\u043B
          \u043D\u0435\u0441\u043F\u0440\u043E\u0441\u0442\u0430. \u041A\u043E\u0440\u043F\u0443\u0441
          \u0445\u043E\u0442\u044C \u0438 \u0434\u0435\u0440\u0435\u0432\u044F\u043D\u043D\u044B\u0439,
          \u043D\u043E \u043A\u0430\u043A \u0431\u0443\u0434\u0442\u043E \u043E\u0431\u0442\u044F\u043D\u0443\u0442
          \u0447\u0435\u0448\u0443\u0439\u043A\u0430\u043C\u0438, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
          \u044F\u0432\u043D\u043E \u0431\u044B\u043B\u0438 \u043A\u0440\u0435\u043F\u0447\u0435,
          \u0447\u0435\u043C \u043A\u0430\u0437\u0430\u043B\u0438\u0441\u044C. \u041A\u043E\u0440\u0430\u0431\u043B\u044C
          \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043B \u043A\u043E\u0441\u043E\u0439
          \u043F\u0430\u0440\u0443\u0441, \u0438 \u0434\u043B\u044F \u0442\u0430\u043A\u043E\u0433\u043E
          \u043F\u0430\u043D\u0446\u0438\u0440\u044F \u0434\u0432\u0438\u0433\u0430\u043B\u0441\u044F
          \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E \u0431\u044B\u0441\u0442\u0440\u043E.\r\n\u0422\u0435\u043C
