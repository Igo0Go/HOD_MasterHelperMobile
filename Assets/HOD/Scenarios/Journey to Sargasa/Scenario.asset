        clip: {fileID: 0}
        animType: 0
        camPositionNumber: 0
        replicaText: "\u0412\u044B \u0434\u043E\u043B\u0436\u043D\u044B \u0432\u044B\u0431\u0440\u0430\u0442\u044C
          \u043E\u0434\u043D\u043E\u0433\u043E \u0438\u0437 \u043E\u0442\u0440\u044F\u0434\u0430,
          \u043E\u043D \u0431\u0443\u0434\u0435\u0442 \u043A\u0438\u0434\u0430\u0442\u044C
          \u043A\u0443\u0431\u0438\u043A \u043E\u0442 \u0432\u0430\u0448\u0435\u0433\u043E
          \u0438\u043C\u0435\u043D\u0438. \u041E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0435
          \u043C\u043E\u0433\u0443\u0442 \u0441\u0434\u0435\u043B\u0430\u0442\u044C
          \u0441\u0442\u0430\u0432\u043A\u0443 \u043D\u0430 \u043D\u0435\u0433\u043E
          \u0438\u043B\u0438 \u043F\u0440\u043E\u0442\u0438\u0432. \u0414\u043B\u044F
          \u0441\u0442\u0430\u0432\u043A\u0438 \u0442\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044F
          \u043E\u0442\u0434\u0430\u0442\u044C \u043C\u0435\u0441\u044F\u0446\u044B.
          \u041C\u0438\u043D\u0438\u043C\u0430\u043B\u043D\u0430\u044F \u0441\u0442\u0430\u0432\u043A\u0430
          - 3 \u043C\u0435\u0441\u044F\u0446\u0430. \u0415\u0441\u043B\u0438 \u0441\u0442\u0430\u0432\u043A\u0430
          \u0441\u044B\u0433\u0440\u0430\u0435\u0442, \u0442\u043E \u0432\u044B \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u0435
          \u0431\u043E\u043B\u044C\u0448\u0435.\n----------------\n\u041C\u0438\u043D\u0438\u043C\u0430\u043B\u044C\u043D\u0430\u044F
          \u0441\u0442\u0430\u0432\u043A\u0430: 3 \u043C\u0435\u0441\u044F\u0446\u0430\n\u0412\u044B\u0438\u0433\u0440\u044B\u0448
          \u0441 \u043F\u0440\u043E\u0432\u0430\u043B\u0430: +1 \u043C\u0435\u0441\u044F\u0446\n\u0412\u044B\u0438\u0433\u0440\u044B\u0448
          \u0441 \u043F\u043E\u0431\u0435\u0434\u044B: +2 \u043C\u0435\u0441\u044F\u0446\u0430"
