        replicaText: "\u0412\u044B \u0448\u043B\u0438 \u043F\u043E \u0442\u043E\u0440\u0433\u043E\u0432\u043E\u0439
          \u043F\u043B\u043E\u0449\u0430\u0434\u0438 \u0434\u0430\u043B\u044C\u0448\u0435.
          \u041C\u0435\u0436\u0434\u0443 \u0434\u043E\u043C\u0430\u043C\u0438 \u0431\u044B\u043B\u0438
          \u043D\u0430\u0432\u0435\u0441\u044B, \u043F\u043E\u044D\u0442\u043E\u043C\u0443
          \u0432\u044B \u043E\u0441\u0442\u0430\u0432\u0430\u043B\u0438\u0441\u044C
          \u0432 \u0442\u0435\u043D\u0438, \u043D\u0430\u0441\u043B\u0430\u0436\u0434\u0430\u044F\u0441\u044C
          \u043F\u0440\u043E\u0445\u043B\u0430\u0434\u043E\u0439 \u0444\u043E\u043D\u0442\u0430\u043D\u0447\u0438\u043A\u043E\u0432.\r\n\u0414\u043E
          \u0432\u0430\u0441 \u0434\u043E\u043D\u0451\u0441\u0441\u044F \u0441\u043F\u043E\u0440
          \u0434\u0432\u0443\u0445 \u0436\u0438\u0442\u0435\u043B\u0435\u0439.\r\n\r\n\u201C\u0418
          \u043D\u0435 \u0437\u043D\u0430\u044E, \u043F\u0440\u0430\u0432\u043E.
          \u041C\u043D\u0435 \u043A\u0430\u0436\u0435\u0442\u0441\u044F, \u0441\u0435\u0439\u0447\u0430\u0441
          \u043C\u044B \u0436\u0438\u0432\u0451\u043C \u043D\u0435\u043F\u043B\u043E\u0445\u043E.\u201D\r\n\u201C\u041D\u043E
          \u044D\u0442\u043E \u043D\u0435 \u043D\u0430\u0448 \u043A\u043E\u0440\u043E\u043B\u044C!
          \u0412\u043B\u0430\u0441\u0442\u044C \u0437\u0430\u0445\u0432\u0430\u0442\u0438\u043B\u0438
          \u0443\u0437\u0443\u0440\u043F\u0430\u0442\u043E\u0440\u044B! \u041D\u0430\u043C\u0435\u0441\u0442\u043D\u0438\u043A
          \u043D\u0435 \u0437\u0430\u043A\u043E\u043D\u043D\u044B\u0439 \u043F\u0440\u0430\u0432\u0438\u0442\u0435\u043B\u044C!\u201D\r\n\u201C\u041C\u043E\u0436\u0435\u0442
          \u0431\u044B\u0442\u044C. \u041D\u043E \u044F \u043F\u0440\u043E\u0441\u0442\u043E
          \u0432\u0441\u043F\u043E\u043C\u0438\u043D\u0430\u044E, \u0447\u0442\u043E
          \u0431\u044B\u043B\u043E \u0434\u043E \u0435\u0433\u043E \u043F\u0440\u0438\u0445\u043E\u0434\u0430.
          \u0414\u0430, \u0443 \u043D\u0430\u0441 \u0431\u044B\u043B \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0438\u0439
          \u043A\u043E\u0440\u043E\u043B\u044C, \u043D\u043E \u0441\u0442\u0440\u0430\u043D\u0430
          \u0431\u044B\u043B\u0430 \u0432 \u0443\u043F\u0430\u0434\u043A\u0435.\u201D\r\n\u201C\u0420\u0430\u0434\u0438
          \u0442\u043E\u0433\u043E, \u0447\u0442\u043E\u0431\u044B \u043D\u0430\u0431\u0438\u0442\u044C
          \u043F\u0443\u0437\u043E, \u043D\u0430\u0434\u043E \u043E\u0442\u043A\u0430\u0437\u0430\u0442\u044C\u0441\u044F
          \u043E\u0442 \u0441\u0432\u043E\u0435\u0439 \u0447\u0435\u0441\u0442\u0438?
          \u041E\u0442 \u0441\u0432\u043E\u0431\u043E\u0434\u044B?\u201D\r\n\u201C\u0414\u0430
          \u043A\u0442\u043E \u043E\u0442\u0431\u0438\u0440\u0430\u0435\u0442 \u0443
          \u0442\u0435\u0431\u044F \u0441\u0432\u043E\u0431\u043E\u0434\u0443?!\u201D\r\n\u201C\u0422\u0435\u0431\u0435
          \u043D\u0440\u0430\u0432\u0438\u0442\u0441\u044F, \u0447\u0442\u043E \u043A\u0430\u0436\u0434\u044B\u0439
          \u0447\u0438\u0445 \u043E\u0442\u0441\u043B\u0435\u0436\u0438\u0432\u0430\u0435\u0442
          \u0441\u0442\u0440\u0430\u0436\u0430? \u0418\u043B\u0438 \u0447\u0442\u043E
          \u0438\u0437 \u0433\u043E\u0440\u043E\u0434\u0430 \u043D\u0435 \u0432\u044B\u0435\u0445\u0430\u0442\u044C
          \u0431\u0435\u0437 \u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043D\u0438\u044F?!\u201D\r\n\r\n\u041E\u0441\u0442\u0430\u0442\u043E\u043A
          \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440\u0430 \u0432\u044B \u043D\u0435
          \u0443\u0441\u043B\u044B\u0448\u0430\u043B\u0438. \r\n\u0422\u0435\u043C
          \u0432\u0440\u0435\u043C\u0435\u043D\u0435\u043C \u0432\u044B \u0434\u043E\u0431\u0440\u0430\u043B\u0438\u0441\u044C
          \u0434\u043E \u043F\u0430\u043B\u0430\u0442 \u0441 \u043E\u0440\u0443\u0436\u0438\u0435\u043C
          \u0438 \u043E\u0434\u0435\u044F\u043D\u0438\u044F\u043C\u0438. \u0414\u0432\u0435
          \u0434\u0435\u0432\u0443\u0448\u043A\u0438 \u043F\u044B\u0442\u0430\u043B\u0438\u0441\u044C
          \u043F\u043E\u0433\u0430\u0441\u0438\u0442\u044C \u043E\u0433\u043E\u043D\u044C
          \u043D\u0430 \u043E\u0434\u043D\u043E\u0439 \u0438\u0437 \u043C\u0430\u043D\u0442\u0438\u0439.\r\n\r\n\u201C\u0414\u0430
          \u043A\u0443\u0434\u0430?!\u201D - \u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0430
          \u043C\u0438\u043D\u0438\u0430\u0442\u044E\u0440\u043D\u0430\u044F \u0434\u0435\u0432\u0443\u0448\u043A\u0430,
          \u0432 \u0443\u0436\u0430\u0441\u0435 \u0433\u043B\u044F\u0434\u044F \u043D\u0430
          \u0432\u0442\u043E\u0440\u0443\u044E - \u201C\u041F\u043E\u0433\u043E\u0434\u0438!\u201D\r\n\u041D\u043E
          \u0432 \u043D\u0435\u0451 \u0443\u0436\u0435 \u043F\u043E\u043B\u0435\u0442\u0435\u043B
          \u043F\u043E\u0442\u043E\u043A \u0432\u043E\u0434\u044B, \u043F\u0440\u0438\u0437\u0432\u0430\u043D\u043D\u044B\u0439
          \u0435\u0451 \u043F\u043E\u0434\u0440\u0443\u0433\u043E\u0439. \u041C\u0430\u043B\u044B\u0448\u043A\u0443
          \u0441\u043C\u044B\u043B\u043E \u043A\u0443\u0434\u0430-\u0442\u043E \u0437\u0430
          \u043F\u0440\u0438\u043B\u0430\u0432\u043E\u043A. \u0421\u043E\u0437\u0434\u0430\u0442\u0435\u043B\u044C\u043D\u0438\u0446\u0430
          \u0432\u043E\u0434\u044F\u043D\u043E\u0433\u043E \u043F\u043E\u0442\u043E\u043A\u0430
          \u043D\u0435\u0432\u043E\u0437\u043C\u0443\u0442\u0438\u043C\u043E \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u043B\u0430\u0441\u044C
          \u043A \u0432\u0430\u043C \u0438 \u043E\u0431\u043B\u043E\u043A\u043E\u0442\u0438\u043B\u0430\u0441\u044C
          \u043D\u0430 \u043F\u0440\u0438\u043B\u0430\u0432\u043E\u043A.\r\n\u201C\u0412\u0430\u043C
          \u0447\u0435\u0433\u043E?\u201D\r\n\n\n\u041F\u043E\u043A\u0443\u043F\u043A\u0430\n\u041F\u0440\u043E\u0434\u0430\u0436\u0430\n\u041E\u0431\u043C\u0435\u043D\n--------------\n\u041E\u0434\u0435\u0436\u0434\u0430\n\u041E\u0440\u0443\u0436\u0438\u0435"
