      replicaInformation:
        alreadyUsed: 0
        character: {fileID: 11400000, guid: df5ced05feaf7d2438a27afab49786cf, type: 2}
        clip: {fileID: 0}
        animType: 0
        camPositionNumber: 0
        replicaText: "\u0412\u044B \u043D\u0430\u043A\u043E\u043D\u0435\u0446 \u0434\u043E\u0431\u0440\u0430\u043B\u0438\u0441\u044C
          \u0434\u043E \u0441\u0432\u043E\u0435\u0439 \u0446\u0435\u043B\u0438. \u0413\u043E\u0440\u043E\u0434
          \u0421\u0430\u0440\u0433\u0430! \u041E\u0434\u0438\u043D \u0438\u0437 \u043A\u0440\u0443\u043F\u043D\u0435\u0439\u0448\u0438\u0445
          \u0433\u043E\u0440\u043E\u0434\u043E\u0432 \u0421\u0430\u0440\u0433\u0430\u0441\u044B,
          \u0447\u0442\u043E \u0441\u043E\u043A\u0440\u044B\u0442 \u0433\u043B\u0443\u0431\u043E\u043A\u043E
          \u0432 \u0446\u0435\u043D\u0442\u0440\u0435 \u043C\u0430\u0442\u0435\u0440\u0438\u043A\u0430.
          \u041A\u0443\u043B\u044C\u0442\u0443\u0440\u043D\u044B\u0439 \u0438 \u0442\u043E\u0440\u0433\u043E\u0432\u044B\u0439
          \u0446\u0435\u043D\u0442\u0440. \u041E\u0431\u0438\u0442\u0435\u043B\u044C
          \u043C\u0430\u0433\u043E\u0432 \u0448\u043A\u043E\u043B\u044B \u043F\u0435\u0441\u043A\u0430.
          \u0418 \u0434\u0440\u0435\u0432\u043D\u0435\u0439\u0448\u0438\u0439 \u043F\u0430\u043C\u044F\u0442\u043D\u0438\u043A
          \u0430\u0440\u0445\u0438\u0442\u0435\u043A\u0442\u0443\u0440\u044B. \u0412\u044B
          \u0448\u043B\u0438 \u043F\u043E \u0432\u044B\u043B\u043E\u0436\u0435\u043D\u043D\u044B\u043C\u0438
          \u043F\u0435\u0441\u0447\u0430\u043D\u0438\u043A\u043E\u043C \u043F\u0440\u043E\u0443\u043B\u043A\u0430\u043C
          \u0442\u043E\u0440\u0433\u043E\u0432\u043E\u0433\u043E \u043A\u0432\u0430\u0440\u0442\u0430\u043B\u0430.
          \u041F\u043E\u0441\u043B\u0435 \u0432\u0430\u0448\u0438\u0445 \u0434\u043E\u043B\u0433\u0438\u0445
          \u0441\u043A\u0438\u0442\u0430\u043D\u0438\u0439 \u0431\u044B\u043B\u043E
          \u0440\u0430\u0437\u0443\u043C\u043D\u043E \u043F\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u044C
          \u0437\u0430\u043F\u0430\u0441\u044B. \u0412\u044B \u0438\u0441\u043A\u0430\u043B\u0438
          \u043F\u043E\u0434\u0445\u043E\u0434\u044F\u0449\u0438\u0435 \u043B\u0430\u0432\u043A\u0438,
          \u043F\u043E\u0441\u0442\u043E\u044F\u043D\u043D\u043E \u043D\u0430\u0442\u044B\u043A\u0430\u044F\u0441\u044C
          \u043D\u0430 \u043F\u0430\u0442\u0440\u0443\u043B\u0438 \u0441\u0442\u0440\u0430\u0436\u0438.
          \u0418\u0445 \u0431\u044B\u043B\u043E \u0443\u0436 \u0441\u043B\u0438\u0448\u043A\u043E\u043C
          \u043C\u043D\u043E\u0433\u043E. "
