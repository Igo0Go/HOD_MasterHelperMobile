          \u0445\u043E\u0442\u0435\u043B\u0438 \u043F\u043E\u0439\u0442\u0438 \u0441\u0442\u043E\u0440\u043E\u043D\u043E\u0439,
          \u043D\u043E \u0432\u0434\u0440\u0443\u0433 \u043A\u0430\u043A\u0430\u044F-\u0442\u043E
          \u043F\u0435\u0449\u0435\u0440\u0430 \u0432\u043E\u0437\u043B\u0435 \u043F\u043E\u043B\u044F\u043D\u044B
          \u043E\u0437\u0430\u0440\u0438\u043B\u0430\u0441\u044C \u0441\u0432\u0435\u0442\u043E\u043C. 
          \u0412\u044B\u0448\u043B\u0438 \u043B\u044E\u0434\u0438 \u0441 \u0444\u0430\u043A\u0435\u043B\u0430\u043C\u0438.
          \u042D\u0442\u043E \u0431\u044B\u043B\u0438 \u0442\u0435, \u0447\u0442\u043E
          \u0432\u0447\u0435\u0440\u0430 \u043D\u0430\u043F\u0430\u0434\u0430\u043B\u0438
          \u043D\u0430 \u0432\u0430\u0441.\r\n\u0414\u0432\u043E\u0435 \u043C\u0443\u0436\u0447\u0438\u043D
          \u0432 \u0434\u043B\u0438\u043D\u043D\u044B\u0445 \u0442\u043E\u0433\u0430\u0445
          \u0432\u0435\u043B\u0438 \u043D\u0430 \u0430\u043B\u0442\u0430\u0440\u044C
          \u043C\u043E\u043B\u043E\u0434\u0443\u044E \u0447\u0435\u0440\u043D\u043E\u0432\u043E\u043B\u043E\u0441\u0443\u044E
          \u0434\u0435\u0432\u0443\u0448\u043A\u0443, \u0432 \u0433\u043E\u043B\u0443\u0431\u043E\u043C
          \u043E\u0434\u0435\u044F\u043D\u0438\u0438 \u043C\u0430\u0433\u0430 \u0448\u043A\u043E\u043B\u044B
          \u043C\u043E\u0440\u043E\u0437\u0430. \u041E\u043D\u0430 \u043F\u044B\u0442\u0430\u043B\u0430\u0441\u044C
          \u0432\u044B\u0440\u044B\u0432\u0430\u0442\u044C\u0441\u044F, \u043D\u043E
          \u044F\u0432\u043D\u043E \u0431\u044B\u043B\u0430 \u0443\u0436\u0435 \u0431\u0435\u0437
          \u0441\u0438\u043B.\r\n\r\n\u041E\u0447\u0435\u0432\u0438\u0434\u043D\u043E,
          \u0432\u0430\u043C \u043F\u0440\u0438\u0434\u0451\u0442\u0441\u044F \u0432\u043C\u0435\u0448\u0430\u0442\u044C\u0441\u044F,
          \u0438\u043D\u0430\u0447\u0435 \u0435\u0451 \u0443\u0431\u044C\u044E\u0442.\r\n\n\n\n\u0411\u043E\u0439\n----------------\n\u041A\u0443\u043B\u044C\u0442\u0438\u0441\u0442
          \u04457\n\n[] | [] | [] \n\u0421\u043A\u043E\u0440\u043E\u0441\u0442\u044C:
          8\n\u0423\u044F\u0437\u0432\u0438\u043C\u043E\u0441\u0442\u044C: \n\u0421\u0442\u043E\u0439\u043A\u043E\u0441\u0442\u044C:
          \u041E\u0433\u043E\u043D\u044C\n\n-0-\u0431\u043B\u0438\u0436\u043D\u044F\u044F
          \u0430\u0442\u0430\u043A\u0430: 1 \u0444\u0438\u0437\n----------------\n\u041A\u0443\u043B\u044C\u0442\u0438\u0441\u0442
          \u043C\u0430\u0433 \u04452\n\n[] | [][][] | [] \n\u0421\u043A\u043E\u0440\u043E\u0441\u0442\u044C:
          7\n\u0423\u044F\u0437\u0432\u0438\u043C\u043E\u0441\u0442\u044C: \u041C\u043E\u0440\u043E\u0437
          \n\u0421\u0442\u043E\u0439\u043A\u043E\u0441\u0442\u044C: \u041E\u0433\u043E\u043D\u044C\n\n-0-\u0431\u043B\u0438\u0436\u043D\u044F\u044F
          \u0430\u0442\u0430\u043A\u0430: 1 \u0444\u0438\u0437\n-0-\u0437\u0430\u043A\u043B.
          \u0423\u043A\u043E\u043B\n-0-\u0437\u0430\u043A\u043B. \u0420\u0430\u0437\u0440\u0435\u0437\n-0-\u0437\u0430\u043A\u043B.
          \u041F\u043B\u0430\u043C\u044F\n----------------\n\u041A\u0443\u043B\u044C\u0442\u0438\u0441\u0442
          \u043C\u0430\u0433 \u04456\n\n[][] | [][] | [][] \n\u0421\u043A\u043E\u0440\u043E\u0441\u0442\u044C:
          5\n\u0423\u044F\u0437\u0432\u0438\u043C\u043E\u0441\u0442\u044C: \u041C\u043E\u0440\u043E\u0437
          \n\u0421\u0442\u043E\u0439\u043A\u043E\u0441\u0442\u044C: \u041E\u0433\u043E\u043D\u044C\n\n-0-\u0431\u043B\u0438\u0436\u043D\u044F\u044F
          \u0430\u0442\u0430\u043A\u0430: 1 \u0444\u0438\u0437\n-0-\u0437\u0430\u043A\u043B.
          \u0423\u043A\u043E\u043B\n-0-\u0437\u0430\u043A\u043B. \u0420\u0430\u0437\u0440\u0435\u0437\n-0-\u0437\u0430\u043A\u043B.
          \u041A\u0438\u043D\u0435\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439
          \u0443\u0434\u0430\u0440\n-0-\u0437\u0430\u043A\u043B. \u041A\u0440\u0430\u0436\u0430
          \u0434\u044B\u0445\u0430\u043D\u0438\u044F\n-0-\u0437\u0430\u043A\u043B.
          \u041F\u043B\u0430\u043C\u044F\n-0-\u0437\u0430\u043A\u0434. \u0410\u0434\u0441\u043A\u043E\u0435
          \u043F\u043B\u0430\u043C\u044F (1)\n----------------"
