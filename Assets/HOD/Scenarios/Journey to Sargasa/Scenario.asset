  - nodeType: 1
    replicaNode:
      index: 1059
      previousNodesNumbers: 21040000
      nextNodesNumbers: 27040000
      finalNode: 0
      leftToRight: 1
      transformRect:
        serializedVersion: 2
        x: 6976.643
        y: 10378.5
        width: 150
        height: 50
      replicaInformation:
        alreadyUsed: 0
        character: {fileID: 11400000, guid: df5ced05feaf7d2438a27afab49786cf, type: 2}
        clip: {fileID: 0}
        animType: 0
        camPositionNumber: 0
        replicaText: "\u0412\u044B \u0441 \u0410\u0440\u0438\u0441\u043E\u0439 \u0448\u043B\u0438
          \u043F\u043E \u0433\u043E\u0440\u043E\u0434\u0443. \u041D\u0430\u0432\u0441\u0442\u0440\u0435\u0447\u0443
          \u0432\u0430\u043C \u0448\u0451\u043B \u0438 \u043D\u0430\u043C\u0435\u0441\u0442\u043D\u0438\u043A
          \u0441\u043E \u0441\u0432\u043E\u0435\u0439 \u0441\u0432\u0438\u0442\u043E\u0439.
          \u041E\u043D\u0438 \u044F\u0432\u043D\u043E \u043E\u0431\u0441\u0443\u0436\u0434\u0430\u043B\u0438
          \u043F\u043B\u0430\u043D \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u044F.\r\n\r\n\u201C\u0417\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0443\u0439,
          \u043E\u0442\u0435\u0446\u201D\r\n\u201C\u0414\u043E\u0447\u043A\u0430?\u201D
          - \u0443\u0434\u0438\u0432\u0438\u043B\u0441\u044F \u043D\u0430\u043C\u0435\u0441\u0442\u043D\u0438\u043A\r\n\u201C\u042F
          \u0436\u0438\u0432\u0430. \u0425\u043E\u0442\u044F, \u0442\u0435\u0431\u044F
          \u044D\u0442\u043E \u0432\u0440\u044F\u0434 \u043B\u0438 \u0431\u0443\u0434\u0435\u0442
          \u0432\u043E\u043B\u043D\u043E\u0432\u0430\u0442\u044C, \u0440\u0430\u0437
          \u0442\u044B \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u043E \u043E\u0441\u0442\u0430\u0432\u0438\u043B
          \u043C\u0435\u043D\u044F \u0432 \u0431\u0438\u0431\u043B\u0438\u043E\u0442\u0435\u043A\u0435,
          \u043A\u0443\u0434\u0430 \u043F\u0440\u0438\u0448\u043B\u0438 \u043C\u044F\u0442\u0435\u0436\u043D\u0438\u043A\u0438,
          \u0438 \u0437\u0430\u0431\u044B\u043B \u043F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0434\u0438\u0442\u044C,
          \u0447\u0442\u043E \u0437\u0430 \u043C\u043D\u043E\u0439 \u043C\u043E\u0436\u0435\u0442
          \u043E\u0445\u043E\u0442\u0438\u0442\u044C\u0441\u044F \u043E\u0442\u0440\u044F\u0434
          \u0437\u0430\u0433\u0440\u043E\u0431\u043D\u044B\u0445, \u043F\u0440\u0435\u0434\u0432\u043E\u0434\u0438\u0442\u0435\u043B\u044C
          \u043A\u043E\u0442\u043E\u0440\u044B\u0445 - \u043C\u043E\u0439 \u043F\u0440\u0430\u0434\u0435\u0434.
          \u0410\u0445 \u0434\u0430. \u0415\u0441\u0442\u044C \u0436\u0435 \u0435\u0449\u0451
          \u0441\u0442\u0440\u0430\u0448\u043D\u0430\u044F \u043D\u0430\u043F\u0430\u0441\u0442\u044C,
          \u043A\u043E\u0442\u043E\u0440\u0443\u044E \u043C\u043E\u0436\u043D\u043E
          \u043F\u043E\u0431\u0435\u0434\u0438\u0442\u044C \u0442\u0435\u043C, \u0447\u0442\u043E
          \u043C\u044B \u0437\u043E\u0432\u0451\u043C \u0440\u043E\u0434\u043E\u0432\u044B\u043C
          \u043F\u0440\u043E\u043A\u043B\u044F\u0442\u044C\u0435\u043C. \u0412\u043E\u0442
          \u0442\u043E\u043B\u044C\u043A\u043E \u0432\u043C\u0435\u0441\u0442\u043E
          \u0442\u043E\u0433\u043E, \u0447\u0442\u043E\u0431\u044B \u0443\u0447\u0438\u0442\u044C\u0441\u044F
          \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u0438\u0440\u043E\u0432\u0430\u0442\u044C
          \u044D\u0442\u0443 \u0441\u0438\u043B\u0443, \u044F \u0431\u044B\u043B\u0430
          \u0437\u0430\u043F\u0435\u0440\u0442\u0430 \u0432 \u0437\u0430\u043C\u043A\u0435
          \u043C\u043D\u043E\u0433\u043E \u043B\u0435\u0442 \u0438 \u043F\u043E\u0434\u0430\u0432\u043B\u044F\u043B\u0430
          \u0435\u0451. \u0410 \u043F\u043E\u0442\u043E\u043C \u0442\u044B \u0435\u0449\u0451
          \u0438 \u0438\u0437\u0433\u043D\u0430\u043B \u043C\u0435\u043D\u044F.\u201D\r\n\r\n\u0422\u043E\u043B\u043F\u0430
          \u043B\u044E\u0434\u0435\u0439 \u0432\u043E\u043A\u0440\u0443\u0433 \u043D\u0430\u043C\u0435\u0441\u0442\u043D\u0438\u043A\u0430
          \u0441\u0442\u043E\u044F\u043B\u0430 \u0432 \u0441\u0442\u0440\u0430\u0445\u0435
          \u0438 \u043D\u0435\u0434\u043E\u0443\u043C\u0435\u043D\u0438\u0438. \u041D\u0430\u043C\u0435\u0441\u0442\u043D\u0438\u043A
          \u043D\u0435 \u043D\u0430\u0448\u0451\u043B, \u0447\u0442\u043E \u043E\u0442\u0432\u0435\u0442\u0438\u0442\u044C.\r\n\r\n\u201C\u042F
          \u0443\u0445\u043E\u0436\u0443 \u0441\u043E \u0441\u0432\u043E\u0438\u043C\u0438
          \u0434\u0440\u0443\u0437\u044C\u044F\u043C\u0438. \u0415\u0441\u043B\u0438
          \u043F\u0435\u0440\u0435\u0441\u0442\u0430\u043D\u0435\u0448\u044C \u043C\u0435\u043D\u044F
          \u0441\u0442\u044B\u0434\u0438\u0442\u044C\u0441\u044F, \u0436\u0434\u0443
          \u0432 \u0433\u043E\u0441\u0442\u0438.\u201D - \u0441\u043A\u0430\u0437\u0430\u043B\u0430
          \u0410\u0440\u0438\u0441\u0430.\r\n\r\n\u0418 \u0432\u044B \u043F\u043E\u0448\u043B\u0438
          \u043F\u0440\u043E\u0447\u044C \u0438\u0437 \u0421\u0430\u0440\u0433\u0438.\r\n"
