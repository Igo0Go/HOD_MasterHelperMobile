        replicaText: "\u0412\u0430\u0440\u044F \u0431\u044B\u043B \u0432 \u0441\u0432\u043E\u0451\u043C
          \u0440\u0435\u043F\u0435\u0440\u0442\u0443\u0430\u0440\u0435. \u0412 \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u0435
          \u043F\u043E\u0434\u0430\u0440\u043A\u0430 \u043E\u043D, \u044F\u0441\u043D\u043E\u0435
          \u0434\u0435\u043B\u043E, \u043D\u0430\u043A\u0440\u044B\u043B \u0441\u0442\u043E\u043B.
          \u0417\u0434\u0435\u0441\u044C \u0431\u044B\u043B\u0438 \u0438 \u043F\u0430\u0440\u0435\u043D\u043D\u044B\u0435
          \u0440\u0435\u043F\u043A\u0438 \u043F\u043E \u043E\u0441\u043E\u0431\u043E\u043C\u0443,
          \u043F\u043E \u043C\u043D\u0435\u043D\u0438\u044E \u041F\u0430\u043A\u0430\u043B\u0435\u0442\u0430,
          \u0432\u0441\u0451 \u0442\u0430\u043A\u0438 \u0432\u043A\u0443\u0441\u043D\u043E\u043C\u0443
          \u0440\u0435\u0446\u0435\u043F\u0442\u0443. \u0421\u0442\u043E\u044F\u043B
          \u0438 \u0441\u043E\u043A \u0438\u0437 \u0441\u0443\u0445\u043E\u0432\u043E\u0449\u0435\u0439
          \u0438 \u0440\u044F\u0431\u0438\u043D\u043E\u0432\u044B\u0439 \u0445\u043B\u0435\u0431
          \u0431\u044B\u043B \u043D\u0430\u0440\u0435\u0437\u0430\u043D. \u0412 \u043E\u0431\u0449\u0435\u043C,
