        character: {fileID: 11400000, guid: 5d1de31c963ec3243a6bf702700f6831, type: 2}
        clip: {fileID: 0}
        animType: 0
        camPositionNumber: 0
        replicaText: "\u201C\u0412\u043E\u043E\u0431\u0449\u0435, \u044F \u043C\u043E\u043B\u0447\u0430\u043B,\u201D
          - \u043F\u043E\u043F\u0440\u0430\u0432\u0438\u043B \u0435\u0433\u043E \u041C\u0430\u0440.
          \u0422\u043E\u0442 \u0441\u043A\u043E\u043D\u0444\u0443\u0437\u0438\u043B\u0441\u044F.
          - \u201C\u0418 \u0442\u0435\u043C \u043D\u0435 \u043C\u0435\u043D\u0435\u0435.
          \u041D\u043E\u0432\u044B\u0439 \u043A\u0430\u043F\u0438\u0442\u0430\u043D
          \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E
          \u0440\u0430\u0437\u0440\u0435\u0448\u0438\u043B.\u201D - \u0441\u043A\u0430\u0437\u0430\u043B
          \u043E\u043D, \u0432\u0441\u0442\u0430\u0432\u0430\u044F \u0438 \u0445\u043B\u043E\u043F\u0430\u044F
          \u043F\u043E \u043F\u043B\u0435\u0447\u0443 \u041F\u0430\u043A\u0430\u043B\u0435\u0442\u0430. 
          \n\n\u041D\u0430 \u043F\u0430\u043B\u0443\u0431\u0435 \u0431\u044B\u043B\u0430
          \u0442\u0438\u0448\u0438\u043D\u0430.  \n\n\u201C\u0414\u0430, \u043F\u0435\u0441\u043A\u0430\u0440\u0438\u043A\u0438.\u201D
          - \u0443\u043B\u044B\u0431\u0430\u043B\u0441\u044F \u043E\u043D. - \u201C\u042D\u0442\u043E
          \u043C\u043E\u0451 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0435
          \u043F\u043B\u0430\u0432\u0430\u043D\u044C\u0435. \u042F \u0440\u0435\u0448\u0438\u043B
          \u043E\u0441\u0442\u0430\u0442\u044C\u0441\u044F \u043D\u0430 \u0441\u0443\u0448\u0435,
          \u0441 \u0441\u0443\u043F\u0440\u0443\u0433\u043E\u0439. \u041A\u0430\u043A
          \u0442\u043E\u043B\u044C\u043A\u043E \u0432\u0435\u0440\u043D\u0451\u043C\u0441\u044F
          \u0434\u043E\u043C\u043E\u0439, \u041F\u0430\u043A\u0430\u043B\u0435\u0442,
          \u043A\u043E\u0440\u0430\u0431\u043B\u044C \u0442\u0432\u043E\u0439.\u201D"
