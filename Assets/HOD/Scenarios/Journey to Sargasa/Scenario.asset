        clip: {fileID: 0}
        animType: 0
        camPositionNumber: 0
        replicaText: "\u201C\u042F \u0436\u0434\u0443 \u0432\u0430\u0441 \u0432\u0435\u0447\u0435\u0440\u043E\u043C.
          \u041C\u044B \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u043C \u0437\u0430\u043D\u044F\u0442\u0438\u044F.\u201D
          - \u0433\u043E\u0432\u043E\u0440\u0438\u043B \u0441\u0442\u0430\u0440\u0435\u0439\u0448\u0438\u043D\u0430,
          \u043F\u0440\u043E\u0432\u043E\u0436\u0430\u044F \u0432\u0430\u0441 \u0438
          \u0434\u0440\u0443\u0433\u0438\u0445 \u043C\u043E\u043D\u0430\u0445\u043E\u0432.
          \n\n\u0412\u044B \u0448\u043B\u0438 \u0441\u0432\u043E\u0435\u0439 \u043A\u0443\u0447\u043A\u043E\u0439-\u043C\u043E\u0433\u0443\u0447\u043A\u043E\u0439.
          \u0414\u0440\u0443\u0433\u0438\u0435 \u043C\u043E\u043D\u0430\u0445\u0438
          \u0448\u0435\u043F\u0442\u0430\u043B\u0438\u0441\u044C, \u0433\u043B\u044F\u0434\u044F
          \u043D\u0430 \u0432\u0430\u0441. \u0411\u044B\u043B\u043E \u0432\u0438\u0434\u043D\u043E,
          \u0447\u0442\u043E \u043E\u043D\u0438 \u043F\u0440\u043E\u044F\u0432\u043B\u044F\u044E\u0442
          \u0438\u043D\u0442\u0435\u0440\u0435\u0441. \u0413\u043E\u0441\u0442\u0438
          \u0438\u0437 \u0426\u0435\u043F\u0430 - \u0440\u0435\u0434\u043A\u043E\u0435
          \u0441\u043E\u0431\u044B\u0442\u0438\u0435 \u0432 \u044D\u0442\u0438\u0445
          \u043A\u0440\u0430\u044F\u0445.  \n\n\u201C\u0410 \u044D\u0442\u043E \u043F\u0440\u0430\u0432\u0434\u0430,
          \u0447\u0442\u043E \u0443 \u0432\u0430\u0441 \u043D\u0430\u0434 \u0432\u0441\u0435\u043C
          \u0446\u0435\u043F\u043E\u043C \u0432 \u043E\u0431\u043B\u0430\u043A\u0430\u0445
          \u0436\u0438\u0432\u0443\u0442 \u043B\u044E\u0434\u0438?\u201D - \u0432\u044B\u043F\u0430\u043B\u0438\u043B
          \u043E\u0434\u0438\u043D \u0438\u0437 \u043C\u043E\u043D\u0430\u0445\u043E\u0432. "
