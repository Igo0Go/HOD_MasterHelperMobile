        replicaText: "\u041D\u043E \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0435
          \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u0438\u044F \u043C\u043E\u0436\u043D\u043E
          \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C
          \u0442\u043E\u043B\u044C\u043A\u043E \u0432 \u0447\u0430\u0441 \u043B\u0443\u043D\u044B.
          \u0421\u0442\u0430\u0440\u0435\u0439\u0448\u0438\u043D\u0430 \u043F\u0440\u0435\u0434\u043B\u0430\u0433\u0430\u0435\u0442
          \u0432\u0430\u043C \u043F\u043E\u043A\u0430 \u043F\u0435\u0440\u0435\u0434\u043E\u0445\u043D\u0443\u0442\u044C
          \u0438 \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u043E \u0434\u043E\u0436\u0434\u0430\u0442\u044C\u0441\u044F
          \u0437\u0430\u043A\u0430\u0442\u0430.\r\n\r\n\u201C\u041F\u043E\u043C\u043D\u0438\u0442\u0435,\u201D
          - \u0433\u043E\u0432\u043E\u0440\u0438\u043B \u043E\u043D - \u201C\u0415\u0441\u043B\u0438
          \u043D\u0435 \u043F\u044B\u0442\u0430\u0442\u044C\u0441\u044F \u043E\u0441\u043F\u0430\u0440\u0438\u0432\u0430\u0442\u044C
          \u0437\u0430\u043A\u043E\u043D\u044B \u043F\u0440\u0438\u0440\u043E\u0434\u044B
          \u0438 \u043F\u0440\u0438\u043D\u044F\u0442\u044C \u0438\u0445, \u0442\u043E
          \u0432\u044B \u043F\u043E\u0439\u043C\u0451\u0442\u0435, \u0447\u0442\u043E
