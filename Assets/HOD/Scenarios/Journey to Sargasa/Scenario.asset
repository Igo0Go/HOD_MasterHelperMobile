  - nodeType: 1
    replicaNode:
      index: 9
      previousNodesNumbers: 0a000000
      nextNodesNumbers: 0b000000
      finalNode: 0
      leftToRight: 1
      transformRect:
        serializedVersion: 2
        x: 1201
        y: 257
        width: 150
        height: 50
      replicaInformation:
        alreadyUsed: 0
        character: {fileID: 11400000, guid: df5ced05feaf7d2438a27afab49786cf, type: 2}
        clip: {fileID: 0}
        animType: 0
        camPositionNumber: 0
        replicaText: "\u0421\u0430\u043C \u043C\u0430\u0433 \u0442\u043E\u0436\u0435
          \u043F\u0440\u043E\u043A\u043B\u044F\u0442 \u0438 \u043D\u0435 \u043C\u043E\u0436\u0435\u0442
          \u0432\u044B\u0439\u0442\u0438 \u0438\u0437 \u0442\u0430\u0432\u0435\u0440\u043D\u044B.
          \u0412\u0430\u043C \u043F\u0440\u0438\u0434\u0451\u0442\u0441\u044F \u0434\u0435\u0439\u0441\u0442\u0432\u043E\u0432\u0430\u0442\u044C
          \u0441\u0430\u043C\u0438\u043C. \u0427\u0442\u043E\u0431\u044B \u0441\u043D\u044F\u0442\u044C
          \u043F\u0440\u043E\u043A\u043B\u044F\u0442\u0438\u0435, \u043D\u0443\u0436\u043D\u043E
          \u043D\u0430\u0439\u0442\u0438 \u043A\u043D\u0438\u0433\u0443 \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u0438\u0439.
          \u041F\u0440\u0430\u0432\u0434\u0430, \u043E\u043D\u0430 \u0434\u0430\u043B\u0435\u043A\u043E.
          \u041C\u0430\u0433 \u0432\u0438\u0434\u0435\u043B \u0435\u0451 \u0442\u043E\u043B\u044C\u043A\u043E
          \u0432 \u0431\u0438\u0431\u043B\u0438\u043E\u0442\u0435\u043A\u0435 \u0433\u043E\u0440\u043E\u0434\u0430
          \u0421\u0430\u0440\u0433\u0430, \u0447\u0442\u043E \u043D\u0430 \u043C\u0430\u0442\u0435\u0440\u0438\u043A\u0435
          \u0421\u0430\u0440\u0433\u0430\u0441\u0430. \u0412\u0430\u043C \u043F\u0440\u0438\u0434\u0451\u0442\u0441\u044F
          \u043A\u0430\u043A-\u0442\u043E \u043F\u0435\u0440\u0435\u043F\u043B\u044B\u0442\u044C
          \u043F\u0440\u0435\u0441\u043D\u043E\u0432\u043E\u0434\u043D\u043E\u0435
          \u043C\u043E\u0440\u0435. \u041F\u043E\u044D\u0442\u043E\u043C\u0443 \u0432\u0430\u043C
          \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E \u043D\u0430\u0439\u0442\u0438
          \u0435\u0433\u043E \u0434\u0440\u0443\u0433\u0430 - \u043A\u0430\u043F\u0438\u0442\u0430\u043D\u0430
          \u041C\u0430\u0440\u0430. \u0422\u043E\u0442 \u043E\u0442\u0432\u0435\u0437\u0451\u0442
          \u0432\u0430\u0441 \u0437\u0430 \u043F\u0440\u0435\u0434\u0435\u043B\u044B
          \u0426\u0435\u043F\u0430, \u0437\u0430 \u043C\u043E\u0440\u0435. \u041D\u0430
          \u0434\u0440\u0443\u0433\u043E\u0439 \u043C\u0430\u0442\u0435\u0440\u0438\u043A.
          \u041A\u0430\u043F\u0438\u0442\u0430\u043D - \u0441\u0442\u0430\u0440\u044B\u0439
          \u0434\u0440\u0443\u0433 \u043C\u0430\u0433\u0430, \u043F\u043E\u044D\u0442\u043E\u043C\u0443
          \u0434\u043E\u043B\u0436\u0435\u043D \u0432\u0430\u043C \u043F\u043E\u043C\u043E\u0447\u044C.
          \u041D\u0430\u0434\u043E \u0442\u043E\u043B\u044C\u043A\u043E \u043F\u0435\u0440\u0435\u0434\u0430\u0442\u044C
          \u043F\u0438\u0441\u044C\u043C\u043E."
