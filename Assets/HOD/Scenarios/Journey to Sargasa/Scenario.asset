        character: {fileID: 11400000, guid: df5ced05feaf7d2438a27afab49786cf, type: 2}
        clip: {fileID: 0}
        animType: 0
        camPositionNumber: 0
        replicaText: "\u041E\u0433\u043E\u043D\u044C \u0432\u0441\u0451 \u0431\u043E\u043B\u044C\u0448\u0435
          \u043E\u0445\u0432\u0430\u0442\u044B\u0432\u0430\u043B \u043A\u043E\u0440\u043C\u0443
          \u043A\u043E\u0440\u0430\u0431\u043B\u044F. \u041D\u0443\u0436\u043D\u043E
          \u0431\u044B\u043B\u043E \u0447\u0442\u043E-\u0442\u043E \u0434\u0435\u043B\u0430\u0442\u044C.
          \u041D\u043E \u0432\u0430\u0448\u0438\u0445 \u0443\u0441\u0438\u043B\u0438\u0439
          \u0431\u044B\u043B\u043E \u043D\u0435\u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E.
          \u0418 \u0442\u0443\u0442 \u0412\u0430\u0440\u044F \u043F\u043E\u0431\u0435\u0436\u0430\u043B
          \u043E\u0431\u0440\u0430\u0442\u043D\u043E \u043D\u0430 \u043A\u0443\u0445\u043D\u044E.
          \u0412\u044B\u0431\u0435\u0436\u0430\u043B \u043E\u043D \u0443\u0436\u0435
          \u0441 \u0431\u0430\u043D\u043A\u043E\u0439 \u043E\u0431\u043B\u0430\u043A\u043E\u0432.
          \u041D\u0430\u0447\u0430\u043B \u043C\u0430\u0445\u0430\u0442\u044C \u0435\u0439,
          \u043F\u0440\u0438\u0432\u043B\u0435\u043A\u0430\u044F \u043A\u0438\u0442\u043E\u0432-\u043A\u043E\u0442\u043E\u0432.
          \u0422\u0435 \u0436\u0435\u043B\u0435\u0439\u043D\u044B\u0435 \u0433\u0438\u0433\u0430\u043D\u0442\u044B
          \u043F\u0440\u043E\u0448\u043B\u0438 \u0441\u043A\u0432\u043E\u0437\u044C
          \u043A\u043E\u0440\u0430\u0431\u043B\u044C, \u043F\u043E\u0442\u0443\u0448\u0438\u0432
          \u043E\u0433\u043E\u043D\u044C \u0438 \u0437\u0430\u0431\u0440\u0430\u0432
          \u0431\u0430\u043D\u043A\u0443.  \u0412\u044B \u043F\u043E\u0434\u0431\u0435\u0436\u0430\u043B\u0438
          \u043A \u0412\u0430\u0440\u0435. \u041E\u043D \u0431\u044B\u043B \u0432\u0435\u0441\u044C
          \u0432 \u043E\u0436\u0451\u0433\u0430\u0445. \u0421\u0442\u0430\u043B\u043E
          \u044F\u0441\u043D\u043E. \u041E\u043D \u043D\u0435 \u0436\u0438\u043B\u0435\u0446. 
          \u041A\u0430\u043F\u0438\u0442\u0430\u043D \u0438 \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0435\u2026
          \u041E\u043D\u0438 \u0434\u0430\u0436\u0435 \u043D\u0435 \u0440\u0443\u0433\u0430\u043B\u0438
          \u0432\u0430\u0441. \u041E\u043D\u0438 \u043F\u0440\u043E\u0441\u0442\u043E
          \u0441\u0442\u0430\u0440\u0430\u043B\u0438\u0441\u044C \u043D\u0435 \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C
          \u0441 \u0432\u0430\u043C\u0438 \u0431\u0435\u0437 \u043D\u0443\u0436\u0434\u044B.
          \u041D\u0430 \u043A\u043E\u0440\u0430\u0431\u043B\u0435 \u0432\u0441\u0435
          \u043F\u0440\u0438\u043D\u044F\u043B\u0438 \u0437\u0430 \u0438\u0441\u0442\u0438\u043D\u0443,
          \u0447\u0442\u043E \u0432\u044B \u043F\u0440\u043E\u043A\u043B\u044F\u0442\u044B,
          \u0438 \u0438\u043C\u0435\u043D\u043D\u043E \u0432\u044B \u043F\u0440\u0438\u043D\u043E\u0441\u0438\u0442\u0435
          \u043D\u0435\u0441\u0447\u0430\u0441\u0442\u044C\u044F.  \u0422\u0435\u043C
          \u043D\u0435 \u043C\u0435\u043D\u0435\u0435, \u0443\u0442\u0440\u043E\u043C
          \u041C\u0430\u0440 \u0432\u044B\u0437\u0432\u0430\u043B \u0432\u0430\u0441
          \u043A \u0441\u0435\u0431\u0435, \u0447\u0442\u043E\u0431\u044B \u0443\u0442\u0440\u044F\u0441\u0442\u0438
          \u043F\u043E\u0441\u043B\u0435\u0434\u0441\u0442\u0432\u0438\u044F. \u0412\u0430\u043C
          \u043F\u0440\u0438\u0434\u0451\u0442\u0441\u044F \u0437\u0430\u043F\u043B\u0430\u0442\u0438\u0442\u044C
          \u0437\u0430 \u0431\u0443\u0434\u0443\u0449\u0438\u0439 \u0440\u0435\u043C\u043E\u043D\u0442.
          \u041A\u0440\u043E\u043C\u0435 \u0442\u043E\u0433\u043E, \u0441\u0433\u043E\u0440\u0435\u043B\u043E
          \u043C\u043D\u043E\u0433\u043E \u043F\u0440\u043E\u0434\u0443\u043A\u0442\u043E\u0432,
          \u043F\u043E\u044D\u0442\u043E\u043C\u0443 \u0441 \u044D\u0442\u043E\u0433\u043E
          \u0434\u043D\u044F \u0432\u0441\u0435\u043C \u0432\u0430\u043C \u043D\u0430
          \u043A\u043E\u0440\u0430\u0431\u043B\u0435 \u043F\u0440\u0438\u0434\u0451\u0442\u0441\u044F
          \u0441\u0438\u043B\u044C\u043D\u043E \u0433\u043E\u043B\u043E\u0434\u0430\u0442\u044C,
          \u0447\u0442\u043E\u0431\u044B \u0434\u043E\u0442\u044F\u043D\u0443\u0442\u044C
          \u0434\u043E \u0421\u0430\u0440\u0433\u0430\u0441\u044B. \n\n\u0412\u0441\u0435
          \u0423\u0440\u043E\u043D \u043E\u0433\u043D\u0451\u043C 1\n\u0412\u0441\u0435
          \u041C\u0435\u0441\u044F\u0446\u044B -5\n\u0412\u0441\u0435 \u0421\u044B\u0442\u043E\u0441\u0442\u044C
          -3"
