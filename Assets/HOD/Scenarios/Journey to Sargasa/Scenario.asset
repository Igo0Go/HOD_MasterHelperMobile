          \u043F\u043E \u0433\u043E\u0440\u043E\u0434\u0443. \u041B\u044E\u0434\u0438
          \u043F\u043E\u0442\u0438\u0445\u043E\u043D\u044C\u043A\u0443 \u0432\u044B\u0445\u043E\u0434\u0438\u043B\u0438
          \u0438\u0437 \u0443\u043A\u0440\u044B\u0442\u0438\u0439. \u0421\u0442\u0430\u0440\u0430\u043B\u0438\u0441\u044C
          \u0440\u0430\u0437\u0433\u0440\u0435\u0431\u0430\u0442\u044C \u0437\u0430\u0432\u0430\u043B\u044B. 
          \u201C\u041F\u043E\u043B\u0443\u0447\u0430\u0435\u0442\u0441\u044F, \u043D\u0430\u043C
          \u043F\u0440\u0435\u0434\u0441\u0442\u043E\u0438\u0442 \u0442\u044F\u0436\u0451\u043B\u0430\u044F
          \u0431\u0438\u0442\u0432\u0430?\u201D - \u0441\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u043B\u0430
          \u0410\u0440\u0438\u0441\u0430. \u201C\u041F\u043E\u043B\u0443\u0447\u0430\u0435\u0442\u0441\u044F,
          \u0442\u0430\u043A.\u201D - \u0433\u043E\u0432\u043E\u0440\u0438\u043B
          \u041D\u0430\u043C\u0435\u0441\u0442\u043D\u0438\u043A - \u201C\u041D\u043E
          \u0442\u044B \u0443\u0436\u0435 \u0441\u0434\u0435\u043B\u0430\u043B\u0430
          \u0442\u043E, \u0447\u0442\u043E \u0432 \u0440\u043E\u0434\u0443 \u043D\u0438\u043A\u043E\u043C\u0443
          \u043D\u0435 \u0443\u0434\u0430\u0432\u0430\u043B\u043E\u0441\u044C. \u0420\u0430\u043D\u044C\u0448\u0435
          \u043F\u043E\u043B\u0443\u0447\u0430\u043B\u043E\u0441\u044C \u043F\u043E\u0434\u0430\u0432\u0438\u0442\u044C
          \u0442\u044C\u043C\u0443. \u041D\u043E \u0447\u0442\u043E\u0431 \u0443\u043F\u0440\u0430\u0432\u043B\u044F\u0442\u044C
          \u0435\u0439. \u0422\u0430\u043A\u043E\u0433\u043E \u0432 \u0437\u0430\u043F\u0438\u0441\u044F\u0445
          \u043D\u0435\u0442.\u201D \u201C\u0418 \u043A\u043E\u0433\u0434\u0430 \u0432\u0435\u0440\u043D\u0451\u0442\u0441\u044F
          \u043F\u0440\u0430\u0434\u0435\u0434?\u201D - \u0441\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u043B\u0430
          \u043E\u043D\u0430 \u201C\u0417\u043D\u0430\u044F \u0435\u0433\u043E, \u043D\u0430\u0434\u043E
          \u0436\u0434\u0430\u0442\u044C \u0433\u043E\u0434\u044B. \u0412\u0440\u0435\u043C\u044F
          \u0443 \u043D\u0430\u0441 \u0435\u0441\u0442\u044C.\u201D - \u0437\u0430\u0434\u0443\u043C\u0430\u043B\u0441\u044F
          \u043D\u0430\u043C\u0435\u0441\u0442\u043D\u0438\u043A. - \u201C\u041D\u043E
          \u0438 \u0440\u0430\u0431\u043E\u0442\u044B \u043C\u043D\u043E\u0433\u043E.\u201D "
