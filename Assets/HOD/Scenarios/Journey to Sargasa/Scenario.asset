        replicaText: "\u0423\u0436\u0435 \u0441\u0442\u0430\u0432\u0448\u0438\u0439
          \u0432\u0430\u043C \u0440\u043E\u0434\u043D\u044B\u043C \u0434\u043E\u043C\u043E\u043C,
          \u043A\u043E\u0440\u0430\u0431\u043B\u044C \u043F\u043E \u0438\u043C\u0435\u043D\u0438
          \u201C\u0427\u0435\u0440\u0435\u043F\u0430\u0448\u043A\u0430 \u041F\u0430\u0448\u043A\u0430\u201D
          \u043F\u0440\u0438\u0447\u0430\u043B\u0438\u043B \u043A \u0434\u0435\u0440\u0435\u0432\u043D\u0435
          \u0425\u043B\u044F\u0440, \u0447\u0442\u043E \u043D\u0430 \u0441\u0435\u0432\u0435\u0440\u043D\u043E\u043C
          \u0431\u0435\u0440\u0435\u0433\u0443 \u043C\u0430\u0442\u0435\u0440\u0438\u043A\u0430
          \u0421\u0430\u0440\u0433\u0430\u0441\u0430. \u041A \u0441\u043E\u0436\u0430\u043B\u0435\u043D\u0438\u044E,
          \u0432\u0430\u0448\u0435 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0435\u043D\u0438\u0435
          \u043E\u043C\u0440\u0430\u0447\u0435\u043D\u043E \u0441\u043C\u0435\u0440\u0442\u044C\u044E
          \u041C\u0430\u0440\u0430. \u0415\u0433\u043E \u0441\u0443\u043F\u0440\u0443\u0433\u0430,
          \u0410\u043B\u044C\u044F\u043D\u0430, \u043F\u0440\u0438\u043D\u044F\u043B\u0430
          \u0443\u0434\u0430\u0440 \u0441\u0442\u043E\u0439\u043A\u043E.\n\n\u0418
          \u0432\u043E\u0442, \u0432\u0441\u0435 \u0432\u044B \u043F\u043E\u0434
          \u043F\u0440\u043E\u043B\u0438\u0432\u043D\u044B\u043C \u0434\u043E\u0436\u0434\u0451\u043C
