      replicaInformation:
        alreadyUsed: 0
        character: {fileID: 11400000, guid: df5ced05feaf7d2438a27afab49786cf, type: 2}
        clip: {fileID: 0}
        animType: 0
        camPositionNumber: 0
        replicaText: "\u0412\u044B \u043C\u0438\u0440\u043D\u043E \u0448\u043B\u0438
          \u043F\u043E \u0431\u0430\u0437\u0430\u0440\u0443. \u041A\u0430\u043A \u0432\u0434\u0440\u0443\u0433
          \u0432\u0430\u0448\u0435 \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u0435
          \u043F\u0440\u0438\u0432\u043B\u0451\u043A \u043F\u0440\u0438\u043B\u0430\u0432\u043E\u043A,
          \u0441\u0434\u0435\u043B\u0430\u043D\u043D\u044B\u0439 \u0438\u0437 \u043B\u043E\u0434\u043A\u0438.
          \u0414\u0432\u043E\u0435, \u044F\u0432\u043D\u043E \u043D\u0435\u043C\u0435\u0441\u0442\u043D\u044B\u0435,
          \u043E \u0447\u0451\u043C-\u0442\u043E \u0436\u0438\u0432\u043E \u0441\u043F\u043E\u0440\u0438\u043B\u0438. 
          \u041B\u0435\u0442\u0438 \u0432 \u043A\u0443\u0447\u0435\u0432\u044B\u0435,
          \u043B\u0435\u0442\u0438 \u0432 \u043A\u0443\u0447\u0435\u0432\u044B\u0435!!!
          \u0417\u0410\u0427\u042D\u041C?! \u041F\u043E\u0442\u044D\u0440\u044F\u0442\u044C
          \u043F\u043E\u043B\u0434\u043D\u044F \u043D\u0430 \u0435\u0442\u0443 \u043F\u0430\u043A\u043E\u0441\u0442\u044C
          - \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u043B \u043E\u043D \u043D\u0430
          \u0438\u0441\u043A\u0440\u044F\u0449\u0438\u0435\u0441\u044F \u0432 \u0431\u0430\u043D\u043A\u0435
          \u0440\u0430\u0437\u0440\u044F\u0434\u044B \u0442\u043E\u043A\u0430.  \u041C\u044B
          \u043C\u043E\u0433\u043B\u0438 \u043F\u043E\u043B\u0435\u0442\u0435\u0442\u044C
          \u0432 \u043E\u0448\u043C\u0451\u0442\u043A\u0438 \u043B\u0435\u043D\u0442\u0438\u043A\u0443\u043B\u044F\u0440\u043D\u043E\u0433\u043E
          \u043E\u0431\u043B\u0430\u043A\u0430, \u043A\u0430\u043A \u0442\u044B \u0441\u043A\u0430\u0437\u0430\u043B,
          \u0438 \u043D\u0430\u0440\u0432\u0430\u0442\u044C\u0441\u044F \u043D\u0430
          \u0438\u043D\u0432\u0435\u0440\u0441\u043D\u0443\u044E \u0431\u0443\u0440\u044E.
          \u041F\u043E \u0431\u043B\u044E\u0434\u0435\u0447\u043A\u0443 \u043F\u0435\u0440\u0435\u0434\u0430\u0432\u0430\u043B\u0438,
          \u0447\u0442\u043E \u043E\u043D\u0430 \u0442\u0430\u043C \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u043B\u0430. 
          \u0422\u0440\u0435\u0442\u0438\u0439 \u0441\u0442\u043E\u044F\u043B \u043C\u0435\u0436\u0434\u0443
          \u043D\u0438\u043C\u0438, \u043D\u0430\u0441\u0443\u043F\u0438\u0432\u0448\u0438\u0441\u044C.
          \u041E\u043D \u0445\u043E\u0440\u043E\u0448\u043E \u0437\u043D\u0430\u043B
          \u043C\u0435\u0441\u0442\u043D\u044B\u0439 \u044F\u0437\u044B\u043A \u0438
          \u0437\u0430\u043D\u044F\u043B\u0441\u044F \u0432\u0430\u043C\u0438. \u041E\u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C,
          \u0447\u0442\u043E \u044D\u0442\u0438 \u0434\u0432\u043E\u0435 \u0431\u044B\u043B\u0438
          \u0438\u0437 \u043E\u0442\u0440\u044F\u0434\u0430 \u0448\u0442\u043E\u0440\u043C\u043E\u0445\u043E\u0434\u043E\u0432.
