          \u042D\u0442\u043E \u0438 \u0432\u0432\u0435\u043B\u043E \u0432\u0430\u0441
          \u0441\u043D\u043E\u0432\u0430 \u0432 \u0444\u043E\u043A\u0443\u0441. \u041F\u0438\u0440\u0430\u0442\u044B
          \u0443\u0432\u0438\u0434\u0435\u043B\u0438 \u0432\u0430\u0441, \u043D\u043E
          \u0443\u0436\u0435 \u043D\u0438\u0447\u0435\u0433\u043E \u043D\u0435 \u0443\u0441\u043F\u0435\u043B\u0438
          \u0441\u0434\u0435\u043B\u0430\u0442\u044C. \n\n\u0412\u044B \u0441 \u0423\u0440\u0435\u0439
          \u043F\u0435\u0440\u0435\u043C\u0430\u0445\u043D\u0443\u043B\u0438 \u043D\u0430
          \u043A\u0430\u043D\u0430\u0442\u0430\u0445 \u043D\u0430 \u201C\u0427\u0435\u0440\u0435\u043F\u0430\u0448\u043A\u0443
          \u041F\u0430\u0448\u043A\u0443\u201D \u0438 \u0441 \u0443\u0434\u0438\u0432\u043B\u0435\u043D\u0438\u0435\u043C
          \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0438\u043B\u0438, \u0447\u0442\u043E
          \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0435 \u0443\u0436\u0435
          \u043E\u0442\u0442\u0435\u0441\u043D\u0438\u043B\u0438 \u043F\u0438\u0440\u0430\u0442\u043E\u0432
          \u043A \u0431\u043E\u0440\u0442\u0430\u043C \u0442\u0430\u043A, \u0447\u0442\u043E
          \u0442\u0435 \u043F\u043E\u043F\u0440\u044B\u0433\u0430\u043B\u0438 \u0432
          \u043C\u043E\u0440\u0435, \u0430 \u043A\u0442\u043E-\u0442\u043E \u0438
          \u043E\u0431\u0440\u0430\u0442\u043D\u043E \u043D\u0430 \u043A\u043E\u0440\u0430\u0431\u043B\u044C.
          \u041A\u043E\u043D\u0435\u0447\u043D\u043E, \u043F\u043E\u0441\u043B\u0435
          \u0432\u0437\u0440\u044B\u0432\u0430 \u043F\u043E\u0440\u043E\u0445\u043E\u0432\u043E\u0433\u043E
          \u0441\u043A\u043B\u0430\u0434\u0430 \u0432\u0441\u0435 \u043E\u043D\u0438
          \u043F\u043E\u0439\u0434\u0443\u0442 \u043D\u0430 \u043A\u043E\u0440\u043C
          \u0440\u044B\u0431\u0430\u043C. \n\n\u0422\u0430\u043A \u0434\u0443\u043C\u0430\u043B\u0438
          \u0438 \u0432\u044B. \u041D\u043E \u0432\u0437\u0440\u044B\u0432\u0430
          \u043D\u0435 \u0441\u043B\u0443\u0447\u0438\u043B\u043E\u0441\u044C\u2026 
          \u0422\u043E\u0447\u043D\u0435\u0435, \u043E\u043D \u0431\u044B\u043B \u043A\u0430\u043A\u0438\u043C-\u0442\u043E
          \u0441\u0442\u0440\u0430\u043D\u043D\u044B\u043C. \u041A\u043E\u0440\u0430\u0431\u043B\u044C,
          \u043A\u0430\u043A \u0436\u0438\u0432\u043E\u0439, \u043D\u0430\u0447\u0430\u043B
          \u043A\u0430\u0448\u043B\u044F\u0442\u044C \u0438 \u0434\u0430\u0432\u0438\u0442\u044C\u0441\u044F
          \u0434\u044B\u043C\u043E\u043C.  \n\n\u201C\u0412\u0441\u0435\u043C \u0432\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F
          \u043D\u0430 \u043A\u043E\u0440\u0430\u0431\u043B\u044C!\u201D - \u043A\u0440\u0438\u0447\u0430\u043B
          \u043F\u0438\u0440\u0430\u0442\u0441\u043A\u0438\u0439 \u043A\u0430\u043F\u0438\u0442\u0430\u043D. 
          \n\n\u0412\u044B \u0447\u0443\u0434\u043E\u043C \u0441\u043C\u043E\u0433\u043B\u0438
          \u0441\u043F\u0430\u0441\u0442\u0438\u0441\u044C. \u041F\u043E\u0439\u043C\u0430\u0432
          \u043E\u0441\u0442\u0430\u0442\u043A\u0438 \u0448\u0442\u043E\u0440\u043C\u043E\u0432\u043E\u0433\u043E
          \u0432\u0435\u0442\u0440\u0430, \u041F\u0430\u043A\u0430\u043B\u0435\u0442
          \u0443\u0432\u0451\u043B \u0432\u0430\u0441 \u0434\u0430\u043B\u0435\u043A\u043E
          \u043E\u0442 \u0437\u0430\u0434\u044B\u0445\u0430\u044E\u0449\u0435\u0433\u043E\u0441\u044F
          \u043A\u043E\u0440\u0430\u0431\u043B\u044F. "
