        replicaText: "\u0412\u0430\u0448 \u043F\u0440\u043E\u0440\u043E\u0441\u043B\u0438\u043A
          \u0432\u0441\u0451 \u0436\u0435 \u0431\u044B\u043B \u0435\u0449\u0451 \u0441\u043B\u0438\u0448\u043A\u043E\u043C
          \u043C\u0430\u043B. \u041E\u043D \u0445\u0440\u0430\u0431\u0440\u043E \u0443\u043A\u0443\u0441\u0438\u043B
          \u043E\u0434\u043D\u043E\u0433\u043E \u0438\u0437 \u0448\u0430\u043C\u0430\u043D\u043E\u0432.
          \u0410 \u043F\u043E\u0442\u043E\u043C \u043D\u0430\u0447\u0430\u043B \u043D\u043E\u0441\u0438\u0442\u044C\u0441\u044F
          \u043F\u043E \u043F\u043E\u043B\u044F\u043D\u0435, \u0432\u044B\u0431\u0435\u0448\u0438\u0432\u0430\u044F
          \u0438\u0445 \u0432\u0441\u0435\u0445.\r\n\n\u042D\u0442\u043E\u0433\u043E
          \u0445\u0432\u0430\u0442\u0438\u043B\u043E, \u0447\u0442\u043E\u0431\u044B
          \u0432\u044B \u0441\u043C\u043E\u0433\u043B\u0438 \u0441\u0431\u0435\u0436\u0430\u0442\u044C.
          \u0412\u044B \u043D\u0430\u0434\u0435\u044F\u043B\u0438\u0441\u044C, \u0447\u0442\u043E
          \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0439 \u0438 \u044E\u0440\u043A\u0438\u0439
          \u043F\u0440\u043E\u0440\u043E\u0441\u043B\u0438\u043A \u0434\u043E\u0433\u043E\u043D\u0438\u0442
          \u0432\u0430\u0441, \u043D\u043E \u043D\u0435\u0442. \u041E\u0434\u0438\u043D
          \u0438\u0437 \u043C\u0430\u0433\u043E\u0432 \u043F\u043E\u0434\u0442\u044F\u043D\u0443\u043B
          \u0435\u0433\u043E \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u0438\u0435\u043C,
