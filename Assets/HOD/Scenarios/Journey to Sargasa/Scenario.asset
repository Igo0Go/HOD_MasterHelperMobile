        replicaText: "\u0421\u0442\u0440\u0430\u043D\u0438\u0446\u0430 39\u2014\r\n\r\n\u0442\u0435\u043C
          \u0441\u0430\u043C\u044B\u043C \u0440\u0430\u0437\u0433\u043D\u0435\u0432\u0430\u0432
          \u0434\u0440\u0435\u0432\u043D\u0435\u0433\u043E \u0431\u043E\u0433\u0430
          \u0410\u0441\u0442\u0435\u0440\u0433\u043E\u0442\u0430. \u0418 \u0442\u043E\u0442
          \u0443\u043D\u0438\u0447\u0442\u043E\u0436\u0438\u043B \u0432\u0435\u0441\u044C
          \u0438\u0445 \u043D\u0430\u0440\u043E\u0434. \u0422\u0430\u043A\u043E\u0432\u0430
          \u0431\u044B\u043B\u0430 \u043A\u0430\u0440\u0430 \u0437\u0430 \u0433\u043E\u0440\u0434\u044B\u043D\u044E.\r\n\r\n\u0413\u041B\u0410\u0412\u0410
          8 - \u041E\u0431\u0438\u0442\u0430\u043B\u0438\u0449\u0435 \u0431\u0430\u043D\u0448\u0438\r\n\r\n\u041D\u0430\u0448\u0435
          \u0432\u0441\u0442\u0443\u043F\u043B\u0435\u043D\u0438\u0435 \u0441\u0438\u043B\u044C\u043D\u043E
          \u0437\u0430\u0442\u044F\u043D\u0443\u043B\u043E\u0441\u044C, \u0434\u043E\u0440\u043E\u0433\u043E\u0439
          \u0447\u0438\u0442\u0430\u0442\u0435\u043B\u044C, \u043D\u043E \u043E\u043D\u043E
          \u0431\u044B\u043B\u043E \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E,
          \u0447\u0442\u043E\u0431\u044B \u043F\u043E\u043D\u044F\u0442\u044C, \u043E\u0442\u043A\u0443\u0434\u0430
          \u0431\u0435\u0440\u0451\u0442 \u043A\u043E\u0440\u043D\u0438 \u0432\u0435\u0440\u043E\u0432\u0430\u043D\u0438\u0435
          \u0432 \u0431\u0430\u043D\u0448\u0438. \u0414\u0435\u043B\u043E \u0432
          \u0442\u043E\u043C, \u0447\u0442\u043E \u043F\u043E \u0441\u043B\u043E\u0432\u0430\u043C
          \u043B\u044E\u0434\u0435\u0439 \u0438\u0437 \u043F\u043B\u0435\u043C\u0435\u043D\u0438
          \u0425\u0430\u043D\u043E\u043B\u0443, \u0438\u0445 \u043D\u0430\u0440\u043E\u0434
          \u043D\u0435 \u0437\u0430\u0431\u044B\u0432\u0430\u043B \u043E \u043C\u043E\u043B\u0438\u0442\u0432\u0430\u0445
          \u0438 \u0436\u0435\u0440\u0442\u0432\u0430\u0445 \u0434\u043B\u044F \u0431\u043E\u0433\u0430
          \u0410\u0441\u0442\u0435\u0440\u0433\u043E\u0442\u0430. \u041F\u043E \u044D\u0442\u043E\u0439
          \u043F\u0440\u0438\u0447\u0438\u043D\u0435 \u043E\u043D \u043F\u043E\u0449\u0430\u0434\u0438\u043B
          \u0438\u0445. \u041D\u043E \u0432\u043C\u0435\u0441\u0442\u0435 \u0441
          \u0442\u0435\u043C \u043D\u0430\u043A\u0430\u0437\u0430\u043B \u0438\u0445
          \u043F\u043B\u0435\u043C\u0435\u043D\u0438 \u0431\u044B\u0442\u044C \u043F\u0440\u0435\u0434\u0432\u0435\u0441\u0442\u043D\u0438\u043A\u043E\u043C
          \u043F\u0440\u0438\u0445\u043E\u0434\u0430 \u0410\u0441\u0442\u0435\u0440\u0433\u043E\u0442\u0430.\r\n\n\u0418
          \u0438\u043C\u0435\u043D\u043D\u043E \u043E \u043F\u0440\u0438\u0445\u043E\u0434\u0435
          \u0434\u0440\u0435\u0432\u043D\u0435\u0433\u043E \u0431\u043E\u0433\u0430
          \u0432\u043E\u0437\u0432\u0435\u0449\u0430\u044E\u0442 \u0431\u0430\u043D\u0448\u0438,
          \u043A\u0435\u043C \u0434\u043E\u043B\u0436\u043D\u0430 \u0431\u044B\u043B\u0430
          \u0441\u0442\u0430\u0442\u044C \u043B\u044E\u0431\u0430\u044F \u0434\u043E\u0447\u044C
          \u0440\u043E\u0434\u0430 \u0440\u0430\u0437 \u0432 \u0442\u0440\u0438 \u043F\u043E\u043A\u043E\u043B\u0435\u043D\u0438\u044F.
          \u041F\u043E \u0441\u043B\u043E\u0432\u0430\u043C \u0425\u0430\u043D\u043E\u043B\u0443,
          \u0431\u0435\u0434\u043D\u044B\u043C \u0434\u0435\u0432\u0443\u0448\u043A\u0430\u043C
          \u0441\u0443\u0436\u0434\u0435\u043D\u043E \u0431\u044B\u043B\u043E \u0440\u0430\u0441\u0442\u0438,
          \u043E\u0441\u043E\u0437\u043D\u0430\u0432\u0430\u044F \u043D\u0435\u043C\u0438\u043D\u0443\u0435\u043C\u044B\u0439
          \u0432\u0437\u0440\u044B\u0432 \u0442\u044C\u043C\u044B \u0432 \u0434\u0443\u0448\u0435.
          \u041D\u043E \u0432\u043E\u043B\u044F \u0431\u043E\u0433\u0430 \u0431\u044B\u043B\u0430
          \u043D\u0435\u043E\u0442\u0432\u0440\u0430\u0442\u0438\u043C\u0430. \r\n\r\n\u0422\u0430\u043A\u0438\u0445
          \u0434\u0435\u0432\u0443\u0448\u0435\u043A, \u043D\u0430\u0437\u044B\u0432\u0430\u0435\u043C\u044B\u0445
          \u201C\u0434\u0435\u0440\u0436\u0430\u0449\u0438\u0435 \u043C\u043E\u043B\u0447\u0430\u043D\u0438\u0435\u201D,
          \u0432 13 \u043B\u0435\u0442 \u043E\u0442\u0441\u044B\u043B\u0430\u043B\u0438
          \u0432 \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u043E\u0435 \u0441\u0435\u043B\u0435\u043D\u0438\u0435,
          \u0433\u0434\u0435 \u0436\u0438\u043B\u0438 \u0442\u043E\u043B\u044C\u043A\u043E
          \u0438\u043C \u043F\u043E\u0434\u043E\u0431\u043D\u044B\u0435. \u041E\u0434\u043D\u0430\u043A\u043E
          \u0432 \u0433\u043E\u0434\u044B \u043A\u0440\u043E\u0432\u0430\u0432\u043E\u0439
          \u0436\u0430\u0442\u0432\u044B \u043D\u043E\u0432\u044B\u0439 \u0432\u043E\u0436\u0434\u044C
          \u0425\u0430\u043D\u043E\u043B\u0443 \u043D\u0430\u0447\u0430\u043B \u043F\u0440\u0435\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u044C
          \u0432\u0441\u0435\u0445 \u0411\u0430\u043D\u0448\u0438. \u041E\u043D \u0438
          \u0435\u0433\u043E \u0441\u043E\u043B\u0434\u0430\u0442\u044B \u0438\u0441\u0442\u0440\u0435\u0431\u0438\u043B\u0438
          \u043F\u043E\u0447\u0442\u0438 \u0432\u0441\u0435\u0445 \u0434\u0435\u0432\u0443\u0448\u0435\u043A,
          \u0434\u0435\u0440\u0436\u0430\u0449\u0438\u0445 \u043C\u043E\u043B\u0447\u0430\u043D\u0438\u0435,
          \u043F\u043E\u043A\u0430 \u043D\u0435 \u0441\u0442\u043E\u043B\u043A\u043D\u0443\u043B\u0438\u0441\u044C
          \u0441 \u043E\u0431\u0440\u0430\u0442\u0438\u0432\u0448\u0435\u0439\u0441\u044F
          \u0411\u0430\u043D\u0448\u0438. \r\n\n\u0421\u0432\u043E\u0438\u043C \u043A\u0440\u0438\u043A\u043E\u043C
          \u043E\u043D\u0430 \u0441\u0440\u044B\u0432\u0430\u043B\u0430 \u043A\u043E\u0436\u0443
          \u0441 \u0441\u043E\u043B\u0434\u0430\u0442, \u0411\u043B\u0435\u0441\u043A
          \u0435\u0451 \u0433\u043B\u0430\u0437 \u0438\u0441\u043F\u0435\u043F\u0435\u043B\u044F\u043B
          \u043D\u0430 \u043C\u0435\u0441\u0442\u0435, \u0430 \u043A\u043E\u0432\u0430\u0440\u0441\u0442\u0432\u043E
          \u0438 \u043F\u0440\u043E\u0432\u043E\u0440\u0441\u0442\u0432\u043E \u0434\u0435\u043B\u0430\u043B\u0438
          \u0435\u0451 \u043F\u043E\u0447\u0442\u0438 \u043D\u0435\u0443\u043B\u043E\u0432\u0438\u043C\u043E\u0439.
          \u041D\u043E \u0445\u0438\u0442\u0440\u044B\u0439 \u0432\u043E\u0436\u0434\u044C
          \u043D\u0430\u0448\u0451\u043B \u0443\u043F\u0440\u0430\u0432\u0443 \u043D\u0430
          \u0431\u0443\u0439\u043D\u0443\u044E \u0434\u0435\u0432\u0443, \u043F\u0440\u0438\u0437\u0432\u0430\u0432
          \u0447\u0435\u0442\u044B\u0440\u0451\u0445 \u0448\u0430\u043C\u0430\u043D\u043E\u0432
          \u043F\u043B\u0435\u043C\u0451\u043D \u0421\u0430\u0440\u0433\u0430\u0441\u044B.
          \u0412\u043C\u0435\u0441\u0442\u0435 \u043E\u043D\u0438\u2026\r"
