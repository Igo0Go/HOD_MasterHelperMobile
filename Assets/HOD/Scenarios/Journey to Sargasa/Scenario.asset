      replicaInformation:
        alreadyUsed: 0
        character: {fileID: 11400000, guid: df5ced05feaf7d2438a27afab49786cf, type: 2}
        clip: {fileID: 0}
        animType: 0
        camPositionNumber: 0
        replicaText: "\u0427\u0451\u0440\u043D\u0430\u044F \u0434\u044B\u043C\u043A\u0430
          \u0432\u044B\u0440\u0432\u0430\u043B\u0430\u0441\u044C \u0438\u0437 \u043D\u0435\u0451
          \u0438 \u043D\u0430\u0447\u0430\u043B\u0430 \u0431\u0438\u0442\u044C \u0432\u0441\u0435\u0445
          \u0431\u0435\u0437 \u0440\u0430\u0437\u0431\u043E\u0440\u0443. \u0412 \u0441\u0443\u043C\u0430\u0442\u043E\u0445\u0435
          \u0432\u044B \u0441\u043C\u043E\u0433\u043B\u0438 \u0432\u044B\u0431\u0435\u0436\u0430\u0442\u044C
          \u0438\u0437 \u0431\u0438\u0431\u043B\u0438\u043E\u0442\u0435\u043A\u0438,
          \u0445\u043E\u0442\u044C \u0431\u0438\u043B\u043E \u0438 \u043F\u043E \u0432\u0430\u043C.\n\n---------------------\n\u0412\u0441\u0435:
          1 \u043F\u0440\u043E\u043D\u0438\u043A\u0430\u044E\u0449\u0435\u0433\u043E\n---------------------\n\n\u041F\u0435\u0440\u0435\u0434
          \u0442\u0435\u043C, \u043A\u0430\u043A \u043E\u043A\u043E\u043D\u0447\u0430\u0442\u0435\u043B\u044C\u043D\u043E
          \u0441\u0431\u0435\u0436\u0430\u0442\u044C, \u0432\u044B \u043E\u0431\u0435\u0440\u043D\u0443\u043B\u0438\u0441\u044C.
          \u0414\u044B\u043C\u043A\u0430 \u043F\u043E \u043F\u0440\u0435\u0436\u043D\u0435\u043C\u0443
          \u043D\u043E\u0441\u0438\u043B\u0430\u0441\u044C \u043F\u043E \u0432\u0441\u0435\u0439
          \u0431\u0438\u0431\u043B\u0438\u043E\u0442\u0435\u043A\u0435, \u043D\u043E
          \u0441\u0430\u043C\u0430 \u0410\u0440\u0438\u0441\u0430 \u0431\u044B\u043B\u0430
          \u0443\u0436\u0435 \u043C\u0435\u0440\u0442\u0432\u0430.\n\n\u0412\u0430\u043C
          \u043D\u0438\u0447\u0435\u0433\u043E \u043D\u0435 \u043E\u0441\u0442\u0430\u0432\u0430\u043B\u043E\u0441\u044C,
          \u043A\u0440\u043E\u043C\u0435 \u043A\u0430\u043A \u0431\u0435\u0436\u0430\u0442\u044C
          \u043F\u0440\u043E\u0447\u044C \u043E\u0442 \u0431\u0438\u0431\u043B\u0438\u043E\u0442\u0435\u043A\u0438,
          \u043F\u044B\u0442\u0430\u044F\u0441\u044C \u043D\u0435 \u0432\u0432\u044F\u0437\u044B\u0432\u0430\u0442\u044C\u0441\u044F
          \u0432 \u0431\u043E\u0438, \u0447\u0442\u043E \u0431\u0443\u0448\u0435\u0432\u0430\u043B\u0438
          \u043D\u0430 \u0443\u043B\u0438\u0446\u0435."
