        replicaText: "\u041F\u043E\u0441\u043B\u0435 \u0434\u043E\u043B\u0433\u043E\u0433\u043E
          \u043F\u043B\u0430\u0432\u0430\u043D\u0438\u044F \u043F\u043E \u043C\u043E\u0440\u044E
          \u0432\u044B \u043D\u0430\u043A\u043E\u043D\u0435\u0446 \u0443\u0432\u0438\u0434\u0435\u043B\u0438
          \u0437\u0435\u043C\u043B\u044E. \u041C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0439
          \u043E\u0441\u0442\u0440\u043E\u0432 \u041C\u043E\u043D\u0442\u0435\u0440\u0430
          - \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u043E\u0447\u043D\u044B\u0439
          \u043F\u0443\u043D\u043A\u0442 \u0432 \u043D\u0435\u0434\u0435\u043B\u0435
          \u043F\u0443\u0442\u0438 \u043E\u0442 \u0421\u0430\u0440\u0433\u0430\u0441\u044B.\r\n\n\u0411\u044B\u043B\u043E
          \u0440\u0435\u0448\u0435\u043D\u043E, \u0447\u0442\u043E \u0437\u0434\u0435\u0441\u044C
          \u0432\u044B \u043F\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435 \u0437\u0430\u043F\u0430\u0441\u044B,
          \u043F\u043E\u0447\u0438\u043D\u0438\u0442\u0435, \u0447\u0442\u043E \u0441\u043C\u043E\u0436\u0435\u0442\u0435,
          \u0438 \u043F\u0435\u0440\u0435\u0434\u043E\u0445\u043D\u0451\u0442\u0435
          \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0434\u043D\u0435\u0439.\r\n\n\u041E\u0442\u0440\u044F\u0434:
          \u0421\u0438\u043B\u044B \u043D\u0430 \u043C\u0430\u043A\u0441\u0438\u043C\u0443\u043C"
