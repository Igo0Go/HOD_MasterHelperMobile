  - nodeType: 1
    replicaNode:
      index: 228
      previousNodesNumbers: e3000000
      nextNodesNumbers: e5000000
      finalNode: 0
      leftToRight: 1
      transformRect:
        serializedVersion: 2
        x: 886
        y: 5530.5
        width: 150
        height: 50
      replicaInformation:
        alreadyUsed: 0
        character: {fileID: 11400000, guid: df5ced05feaf7d2438a27afab49786cf, type: 2}
        clip: {fileID: 0}
        animType: 0
        camPositionNumber: 0
        replicaText: "\u041D\u043E \u0432 \u0446\u0435\u043B\u043E\u043C, \u0432\u044B
          \u043E\u0431\u0436\u0438\u043B\u0438\u0441\u044C. \u0412 \u044D\u0442\u043E\u0442
          \u0432\u0435\u0447\u0435\u0440 \u0432\u0441\u0435 \u0432\u044B \u0440\u0435\u0448\u0438\u043B\u0438
          \u043F\u043E\u043C\u043E\u0447\u044C \u0412\u0430\u0440\u0435. \u0423\u0440\u044F
          \u0438 \u041F\u0430\u043A\u0430\u043B\u0435\u0442 \u0443\u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0438
          \u043A\u0430\u043F\u0438\u0442\u0430\u043D\u0430 \u0440\u0430\u0437\u043D\u043E\u043E\u0431\u0440\u0430\u0437\u0438\u0442\u044C
          \u0435\u0436\u0435\u0434\u043D\u0435\u0432\u043D\u044B\u0439 \u0440\u0430\u0446\u0438\u043E\u043D.
          \u0415\u0441\u043B\u0438 \u0440\u0430\u043D\u044C\u0448\u0435 \u0443 \u0432\u0430\u0441
          \u043A\u0430\u0436\u0434\u044B\u0439 \u0434\u0435\u043D\u044C \u0431\u044B\u043B\u0430
          \u043A\u0430\u0448\u0430 \u0438\u0437 \u043F\u0430\u0440\u0435\u043D\u043D\u043E\u0439
          \u0440\u0435\u043F\u044B, \u0442\u043E \u0442\u0435\u043F\u0435\u0440\u044C
          \u0440\u0430\u0437 \u0432 \u043D\u0435\u0434\u0435\u043B\u044E \u0412\u0430\u0440\u044F
          \u0432\u0441\u043A\u0440\u044B\u0432\u0430\u0435\u0442 \u043D\u0435\u043F\u0440\u0438\u043A\u043E\u0441\u043D\u043E\u0432\u0435\u043D\u043D\u044B\u0435
          \u0437\u0430\u043F\u0430\u0441\u044B \u0438 \u0434\u0435\u043B\u0430\u0435\u0442
          \u0447\u0442\u043E-\u0442\u043E \u043E\u0441\u043E\u0431\u043E\u0435. \u0418
          \u0437\u0430\u043C\u0435\u0442\u043D\u043E \u044D\u0442\u043E\u043C\u0443
          \u0440\u0430\u0434\u0443\u0435\u0442\u0441\u044F, \u043F\u0443\u0433\u0430\u044F
          \u041F\u0430\u043A\u0430\u043B\u0435\u0442\u0430.  \u0412\u044B \u0440\u0435\u0448\u0438\u043B\u0438
          \u0433\u043E\u0442\u043E\u0432\u0438\u0442\u044C \u043D\u0435\u0431\u0435\u0441\u043D\u044B\u0435
          \u043F\u0435\u043B\u044C\u043C\u0435\u0448\u043A\u0438. \u0412\u0430\u0440\u044F
          \u0434\u0435\u043B\u0430\u043B \u0438\u0437 \u0441\u043E\u043B\u043E\u043D\u0438\u043D\u044B
          \u0444\u0430\u0440\u0448, \u043F\u0440\u0435\u0434\u0432\u0430\u0440\u0438\u0442\u0435\u043B\u044C\u043D\u043E
          \u0440\u0430\u0437\u043C\u043E\u0447\u0438\u0432 \u043C\u044F\u0441\u043E,
          \u0430 \u043F\u043E\u0442\u043E\u043C \u0437\u0430\u043F\u0440\u0430\u0432\u043B\u044F\u044F
          \u0435\u0433\u043E \u0441\u043F\u0435\u0446\u0438\u044F\u043C\u0438. \u0412\u0430\u0441
          \u0436\u0435 \u043E\u0442\u043F\u0440\u0430\u0432\u0438\u043B\u0438 \u0437\u0430\u043C\u0435\u0441\u0438\u0442\u044C
          \u0442\u0435\u0441\u0442\u043E \u0438\u0437 \u043E\u0431\u043B\u0430\u043A\u043E\u0432.
          \u042D\u0442\u043E \u0431\u044B\u043B\u0438 \u043B\u0438\u0447\u043D\u044B\u0435
          \u0437\u0430\u043F\u0430\u0441\u044B \u0412\u0430\u0440\u0438. \u0411\u0430\u043D\u043E\u0447\u043A\u0430
          \u043A\u0443\u0447\u0435\u0432\u044B\u0445\u2026  \u041F\u0435\u0440\u0438\u043E\u0434\u0438\u0447\u0435\u0441\u043A\u0438
          \u0412\u0430\u0440\u044F \u0433\u043B\u044F\u0434\u0435\u043B \u0432 \u043E\u043A\u043E\u0448\u043A\u043E
          \u043D\u0430 \u0432\u043E\u0434\u0443. \u0422\u0430\u043C \u043F\u043B\u0430\u0432\u0430\u043B\u0438
          \u043A\u0438\u0442\u044B-\u043A\u043E\u0442\u044B, \u0432\u044B\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u044F
          \u0443 \u043A\u043E\u043A\u0430 \u043C\u043E\u043B\u043E\u043A\u0430, \u043D\u0435
          \u043F\u043E\u043D\u0438\u043C\u0430\u044F, \u0447\u0442\u043E \u044D\u0442\u043E
          \u043E\u0441\u0442\u0430\u0442\u043A\u0438 \u043E\u0431\u043B\u0430\u043A\u043E\u0432,
          \u0438 \u0440\u0430\u0441\u043A\u0430\u0447\u0438\u0432\u0430\u044F \u043A\u043E\u0440\u0430\u0431\u043B\u044C.
          \u0412\u0430\u0440\u044F \u0431\u0435\u0441\u043F\u043E\u043A\u043E\u0438\u043B\u0441\u044F,
          \u0438 \u043F\u043E\u0442\u043E\u043C\u0443 \u0443\u0431\u0440\u0430\u043B
          \u0431\u0430\u043D\u043A\u0443 \u043F\u043E\u0434\u0430\u043B\u044C\u0448\u0435
          \u043E\u0442 \u043E\u043A\u043D\u0430. \u041F\u043E\u0441\u043B\u0435 \u0412\u0430\u0440\u044F
          \u0441\u043D\u043E\u0432\u0430 \u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F
          \u043A \u0444\u0430\u0440\u0448\u0443\u2026 "
