          \u041E\u043D\u0438 \u0431\u0443\u0434\u0443\u0442 \u0438\u0441\u043A\u0430\u0442\u044C
          \u043C\u0435\u043D\u044F.\u201D - \u0441\u043A\u0430\u0437\u0430\u043B\u0430
          \u0410\u0440\u0438\u0441\u0430.  \u0412\u044B \u0434\u043E\u043B\u0433\u043E
          \u043F\u044B\u0442\u0430\u043B\u0438\u0441\u044C \u0443\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C
          \u0435\u0451 \u043F\u043E\u0439\u0442\u0438 \u0441 \u0432\u0430\u043C\u0438,
          \u043D\u043E \u043E\u043D\u0430 \u0431\u044B\u043B\u0430 \u0442\u0432\u0435\u0440\u0434\u0430
          \u0432 \u0441\u0432\u043E\u0451\u043C \u0440\u0435\u0448\u0435\u043D\u0438\u0438. "
