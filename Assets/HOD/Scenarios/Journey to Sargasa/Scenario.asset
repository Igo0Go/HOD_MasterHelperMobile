        replicaText: "\u041F\u0440\u043E\u0440\u043E\u0441\u043B\u0438\u043A \u0443\u0441\u043F\u0435\u0432\u0430\u0435\u0442
          \u043E\u0442\u043E\u0433\u043D\u0430\u0442\u044C \u043E\u0442 \u043D\u0435\u0433\u043E
          \u0441\u0438\u0440\u0435\u043D \u0438 \u0442\u043E\u043B\u043A\u043D\u0443\u0442\u044C
          \u041A\u043B\u0451\u043F\u0443 \u0432 \u0446\u0435\u043D\u0442\u0440 \u043F\u0430\u043B\u0443\u0431\u044B.
          \u0421\u0438\u0440\u0435\u043D\u044B \u044F\u0432\u043D\u043E \u0440\u0430\u0437\u044A\u044F\u0440\u0438\u043B\u0438\u0441\u044C.
          \u0412\u0441\u0435 \u0432\u043C\u0435\u0441\u0442\u0435 \u043E\u043D\u0438
          \u043E\u043A\u0440\u0443\u0436\u0438\u043B\u0438 \u043F\u0440\u043E\u0440\u043E\u0441\u043B\u0438\u043A\u0430
          \u0438 \u0443\u0442\u0430\u0449\u0438\u043B\u0438 \u0435\u0433\u043E \u0432
          \u0432\u043E\u0434\u0443, \u0433\u0434\u0435 \u0438 \u0440\u0430\u0441\u0442\u0435\u0440\u0437\u0430\u043B\u0438
          \u043D\u0430 \u0447\u0430\u0441\u0442\u0438. \u041D\u043E \u0432\u0430\u043C
          \u0445\u0432\u0430\u0442\u0438\u043B\u043E \u0432\u0440\u0435\u043C\u0435\u043D\u0438
          \u0447\u0442\u043E\u0431\u044B \u043F\u0440\u043E\u043F\u043B\u044B\u0442\u044C
          \u043F\u0440\u043E\u043B\u0438\u0432 \u0438 \u043E\u0442\u043E\u0440\u0432\u0430\u0442\u044C\u0441\u044F
          \u043E\u0442 \u0441\u0438\u0440\u0435\u043D."
