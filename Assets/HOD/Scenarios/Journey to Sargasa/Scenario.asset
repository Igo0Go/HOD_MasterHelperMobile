        replicaText: "\u0423\u0442\u0440\u043E\u043C, \u0432\u044B\u0441\u043B\u0443\u0448\u0430\u0432
          \u0432\u0430\u0448\u0443 \u0438\u0441\u0442\u043E\u0440\u0438\u044E, \u043C\u0435\u0441\u0442\u043D\u044B\u0439
          \u0441\u0442\u0430\u0440\u0435\u0439\u0448\u0438\u043D\u0430, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
          \u0431\u044B\u043B, \u043D\u0430 \u0441\u0430\u043C\u043E\u043C \u0434\u0435\u043B\u0435,
          \u043D\u0435 \u043C\u043D\u043E\u0433\u0438\u043C \u0441\u0442\u0430\u0440\u0448\u0435
          \u0432\u0430\u0441, \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u043B
          \u0432\u0430\u043C \u0438\u0437\u0443\u0447\u0438\u0442\u044C \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u0438\u044F
          \u0448\u043A\u043E\u043B\u044B \u043B\u0435\u0441\u0430. \u0418\u043C\u0435\u043D\u043D\u043E
          \u0438\u0437\u0443\u0447\u0438\u0442\u044C. \u0412\u0435\u0434\u044C \u0441
          \u0432\u0430\u0448\u0438\u043C \u043F\u0440\u043E\u043A\u043B\u044F\u0442\u0438\u0435\u043C
          \u0432\u0441\u044F\u043A\u043E\u0435 \u043C\u043E\u0436\u0435\u0442 \u0441\u043B\u0443\u0447\u0438\u0442\u044C\u0441\u044F,
          \u0430 \u0437\u043D\u0430\u043D\u0438\u044F \u0432\u0441\u0435\u0433\u0434\u0430
          \u0431\u0443\u0434\u0443\u0442 \u0441 \u0432\u0430\u043C\u0438!\n\n\u0412\u0430\u043C
          \u043F\u0440\u0438\u0434\u0451\u0442\u0441\u044F \u0437\u0430\u0434\u0435\u0440\u0436\u0430\u0442\u044C\u0441\u044F
          \u0437\u0434\u0435\u0441\u044C \u043D\u0430 \u043A\u0430\u043A\u043E\u0435-\u0442\u043E
          \u0432\u0440\u0435\u043C\u044F, \u043D\u043E \u0432\u044B \u0441\u043C\u043E\u0436\u0435\u0442\u0435
          \u043F\u043E\u043F\u0440\u0430\u043A\u0442\u0438\u043A\u043E\u0432\u0430\u0442\u044C\u0441\u044F
          \u0441 \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u0438\u044F\u043C\u0438.
          \u0421\u0432\u0438\u0442\u043A\u0438 \u0432\u0430\u043C \u043F\u0440\u0435\u0434\u043E\u0441\u0442\u0430\u0432\u044F\u0442.
          \u0418 \u043F\u0440\u0435\u0434\u043B\u0430\u0433\u0430\u044E\u0442 \u043D\u0430\u0447\u0430\u0442\u044C
          \u043F\u0440\u044F\u043C\u043E \u0441\u0435\u0439\u0447\u0430\u0441.\n\n\u0412\u0441\u0435:
          +1 \u0417\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u0438\u0435 \u0448\u043A\u043E\u043B\u044B
          \u043B\u0435\u0441\u0430"
