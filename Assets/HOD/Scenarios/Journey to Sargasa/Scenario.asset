      replicaInformation:
        alreadyUsed: 0
        character: {fileID: 11400000, guid: df5ced05feaf7d2438a27afab49786cf, type: 2}
        clip: {fileID: 0}
        animType: 0
        camPositionNumber: 0
        replicaText: "\u041A\u043E\u0440\u0430\u0431\u043B\u044C \u043F\u0438\u0440\u0430\u0442\u043E\u0432
          \u0443\u043F\u043B\u044B\u0432\u0430\u043B \u0434\u0430\u043B\u0435\u043A\u043E
          \u0437\u0430 \u0433\u043E\u0440\u0438\u0437\u043E\u043D\u0442, \u043E\u0441\u0442\u0430\u0432\u0438\u0432
          \u0432\u0441\u0435\u0445 \u0432\u0430\u0441 \u0442\u043E\u043D\u0443\u0442\u044C
          \u0432 \u043F\u0440\u0435\u0441\u043D\u043E\u0432\u043E\u0434\u043D\u043E\u043C
          \u043C\u043E\u0440\u0435. \u041F\u0440\u043E\u0440\u043E\u0441\u043B\u0438\u043A
          \u043A \u044D\u0442\u043E\u043C\u0443 \u0432\u0440\u0435\u043C\u0435\u043D\u0438
          \u0443\u0441\u043F\u0435\u043B \u0437\u043D\u0430\u0442\u043D\u043E \u043F\u043E\u0434\u0440\u0430\u0441\u0442\u0438.
          \u041E\u043D \u0438 \u0441\u043E\u0431\u0440\u0430\u043B \u0432\u0441\u0435\u0445
          \u0432\u0430\u0441. \u041D\u043E \u0442\u043E\u043B\u044C\u043A\u043E \u0432\u0430\u0441.
          \u0414\u0430\u0436\u0435 \u0442\u0435\u043B \u043A\u043E\u0433\u043E-\u0442\u043E
          \u0438\u0437 \u043A\u043E\u043C\u0430\u043D\u0434\u044B \u201C\u0427\u0435\u0440\u0435\u043F\u0430\u0448\u043A\u0438
          \u041F\u0430\u0448\u043A\u0438\u201D \u043D\u0435 \u0431\u044B\u043B\u043E.
          \n\n\u041D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0447\u0430\u0441\u043E\u0432
          \u0432\u044B \u043F\u043E\u0442\u0438\u0445\u043E\u043D\u044C\u043A\u0443
          \u043F\u043B\u044B\u043B\u0438 \u043F\u043E \u043C\u043E\u0440\u044E, \u043D\u043E
          \u0432 \u0438\u0442\u043E\u0433\u0435 \u0432\u0441\u0451 \u0436\u0435 \u0432\u044B\u0448\u043B\u0438
          \u043D\u0430 \u043A\u0430\u043A\u043E\u0439-\u0442\u043E \u0431\u0435\u0440\u0435\u0433. 
          \n\n\u041F\u0440\u043E\u0440\u043E\u0441\u043B\u0438\u043A \u0436\u0435
          \u0441\u0438\u043B\u044C\u043D\u043E \u0440\u0430\u0437\u0431\u0443\u0445,
          \u0432\u043F\u0438\u0442\u0430\u0432 \u043C\u043D\u043E\u0433\u043E \u0432\u043E\u0434\u044B.
          \u041E\u043D \u044F\u0432\u043D\u043E \u0434\u043E\u0440\u043E\u0441 \u0434\u043E
          \u0444\u0430\u0437\u044B, \u043A\u043E\u0433\u0434\u0430 \u0434\u043E\u043B\u0436\u0435\u043D
          \u043F\u0443\u0441\u0442\u0438\u0442\u044C \u043A\u043E\u0440\u043D\u0438.
          \u041A \u0441\u043E\u0436\u0430\u043B\u0435\u043D\u0438\u044E, \u0432\u0430\u043C
          \u043F\u0440\u0438\u0448\u043B\u043E\u0441\u044C \u0432\u044B\u0432\u0435\u0441\u0442\u0438
          \u0435\u0433\u043E \u043D\u0430 \u0431\u0435\u0440\u0435\u0433. \u0422\u0430\u043C
          \u0432\u044B \u0432\u0441\u0435\u0439 \u043A\u043E\u043C\u0430\u043D\u0434\u043E\u0439
          \u0438 \u043F\u0440\u043E\u0441\u0442\u0438\u043B\u0438\u0441\u044C \u0441
          \u043F\u0440\u043E\u0440\u043E\u0441\u043B\u0438\u043A\u043E\u043C, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
          \u043D\u0430\u0432\u0435\u043A\u0430 \u0443\u0441\u043D\u0443\u043B, \u043D\u0430\u0431\u0438\u0440\u0430\u044F\u0441\u044C
          \u0441\u0438\u043B, \u0447\u0442\u043E\u0431\u044B \u0441\u0442\u0430\u0442\u044C
          \u044D\u043D\u0442\u043E\u043C. \n\n\u041E\u0431\u0435\u0441\u0441\u0438\u043B\u0435\u043D\u043D\u044B\u0435,
          \u0432\u044B \u043F\u0440\u043E\u0441\u0442\u043E \u0443\u0441\u043D\u0443\u043B\u0438
          \u043F\u0440\u044F\u043C\u043E \u043D\u0430 \u0431\u0435\u0440\u0435\u0433\u0443.
          \n\n\u0412\u0441\u0435: \u0421\u0438\u043B\u044B = 2\n\u0412\u0441\u0435:
          \u0421\u044B\u0442\u043E\u0441\u0442\u044C -2"
