        replicaText: "\u0412\u0441\u0451 \u044D\u0442\u043E \u0432\u0440\u0435\u043C\u044F
          \u043A\u0430\u043F\u0438\u0442\u0430\u043D \u043B\u0438\u0431\u043E \u043F\u0440\u043E\u043F\u0430\u0434\u0430\u043B
          \u043D\u0430 \u0441\u0443\u0448\u0435, \u0432\u044B\u0438\u0441\u043A\u0438\u0432\u0430\u044F
          \u043F\u0440\u0438\u043F\u0430\u0441\u044B \u043F\u043E \u043F\u0440\u0438\u0435\u043C\u043B\u0435\u043C\u043E\u0439
          \u0446\u0435\u043D\u0435, \u043B\u0438\u0431\u043E \u0441\u0438\u0434\u0435\u043B
          \u0432 \u0441\u0432\u043E\u0435\u0439 \u043A\u0430\u044E\u0442\u0435 \u0441
          \u043A\u043D\u0438\u0433\u0430\u043C\u0438 \u0438 \u043A\u0430\u0440\u0442\u0430\u043C\u0438.
          \u041F\u043E\u044D\u0442\u043E\u043C\u0443 \u0431\u044B\u043B \u043D\u0435\u043C\u0430\u043B\u043E
          \u0443\u0434\u0438\u0432\u043B\u0451\u043D, \u0443\u0437\u043D\u0430\u0432,
          \u0447\u0442\u043E \u0440\u0443\u043A\u0430\u0441\u0442\u044B\u0439 \u041A\u043B\u0451\u043F\u0430
          \u0437\u0430 \u044D\u0442\u0438 \u0434\u043D\u0438 \u0443\u043C\u0443\u0434\u0440\u0438\u043B\u0441\u044F
          \u043D\u0430\u0439\u0442\u0438 \u043D\u0430 \u043E\u0441\u0442\u0440\u043E\u0432\u0435
