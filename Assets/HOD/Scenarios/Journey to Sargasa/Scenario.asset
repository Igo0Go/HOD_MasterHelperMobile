        replicaText: "\u0412\u0430\u0441 \u0440\u0430\u0437\u0431\u0438\u043B\u0438.
          \u041C\u0430\u0440 \u043B\u0435\u0436\u0430\u043B \u0440\u0430\u043D\u0435\u043D\u044B\u0439,
          \u043D\u043E \u0432\u0441\u0451 \u0435\u0449\u0451 \u043E\u0442\u0431\u0438\u0432\u0430\u043B\u0441\u044F
