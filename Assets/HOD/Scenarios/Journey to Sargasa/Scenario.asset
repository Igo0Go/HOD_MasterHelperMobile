        replicaText: "\u041C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0439 \u043A\u043E\u0440\u0430\u0431\u043B\u0438\u043A
          \u043C\u0435\u0440\u043D\u043E \u0432\u044B\u043F\u043B\u044B\u0432\u0430\u043B
          \u0438\u0437 \u0431\u0443\u0445\u0442\u044B. \u0412\u0441\u0435 \u0440\u0430\u0431\u043E\u0442\u0430\u043B\u0438
          \u043D\u0430 \u0441\u0432\u043E\u0438\u0445 \u043C\u0435\u0441\u0442\u0430\u0445.
          \u041A\u0430\u043F\u0438\u0442\u0430\u043D \u0432 \u043A\u0430\u044E\u0442\u0435
          \u0441\u0432\u0435\u0440\u044F\u043B\u0441\u044F \u0441 \u043A\u0430\u0440\u0442\u0430\u043C\u0438.
          \u041F\u0430\u043A\u0430\u043B\u0435\u0442 \u0443 \u0448\u0442\u0443\u0440\u0432\u0430\u043B\u0430
          \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u044F\u043B \u043A\u043E\u0440\u0430\u0431\u043B\u044C
          \u043C\u0435\u0436 \u0434\u0432\u0443\u0445 \u0441\u043A\u0430\u043B\u0438\u0441\u0442\u044B\u0445
          \u0441\u0442\u0435\u043D \u0413\u0440\u0430\u043D\u0438\u0442\u043E\u0432\u043E\u0433\u043E
          \u043E\u0431\u043E\u0434\u0430 - \u043E\u0434\u043D\u043E\u0433\u043E \u0438\u0437
          \u0433\u043E\u0440\u043D\u044B\u0445 \u043C\u0430\u0441\u0441\u0438\u0432\u043E\u0432
          \u0446\u0435\u043F\u0430, \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0438
          \u043E\u0442\u0434\u0435\u043B\u044F\u043B \u044D\u0442\u0443 \u0431\u0443\u0445\u0442\u0443
          \u043E\u0442 \u043F\u0440\u0435\u0441\u043D\u043E\u0432\u043E\u0434\u043D\u043E\u0433\u043E
          \u043C\u043E\u0440\u044F."
