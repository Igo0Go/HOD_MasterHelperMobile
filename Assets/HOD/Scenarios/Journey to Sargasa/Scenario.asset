          \u0433\u043D\u0438\u0442\u044C, \u043E\u0449\u0443\u0449\u0430\u044F \u043A\u0430\u0436\u0434\u0443\u044E
          \u0441\u0435\u043A\u0443\u043D\u0434\u0443 \u0431\u043E\u043B\u0438 \u0438
          \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E \u043D\u0430\u0431\u043B\u044E\u0434\u0430\u044F,
          \u043A\u0430\u043A \u043E\u043D\u0438 \u0441\u0430\u043C\u0438 \u043E\u0442\u043F\u0440\u0430\u0432\u043B\u044F\u043B\u0438\u0441\u044C
          \u0432 \u043D\u0435\u0431\u044B\u0442\u0438\u0435. \u0418\u0431\u0440\u0430\u0433\u0438\u043C
          \u0443\u043F\u043E\u0434\u043E\u0431\u0438\u043B \u0432\u0440\u0430\u0433\u043E\u0432
          \u0437\u0430\u0433\u0440\u043E\u0431\u043D\u044B\u043C.\r\n\r\n\u041D\u043E
          \u0434\u0430\u0436\u0435 \u0438\u0437\u0443\u0440\u043E\u0434\u043E\u0432\u0430\u043D\u043D\u044B\u0439
          \u0438 \u043F\u043E\u043B\u0443\u0441\u0433\u043D\u0438\u0432\u0448\u0438\u0439
          \u0423\u0440\u0433\u043E\u0440\u043E\u0434 \u0441\u043C\u043E\u0433 \u0441\u043E\u0431\u0440\u0430\u0442\u044C
          \u0441\u0432\u043E\u0438\u0445 \u043C\u0451\u0440\u0442\u0432\u044B\u0445
          \u0432\u043E\u0438\u043D\u043E\u0432 \u0438 \u0434\u0432\u0438\u043D\u0443\u0442\u044C\u0441\u044F
          \u043F\u0440\u043E\u0442\u0438\u0432 \u0445\u0435\u0441\u0430 \u0421\u0430\u0440\u0433\u0430\u0441\u044B.
          \u0411\u043E\u0439 \u0431\u044B\u043B \u0441\u0442\u0440\u0430\u0448\u043D\u044B\u043C.
          \u0411\u0435\u0441\u0441\u043C\u0435\u0440\u0442\u043D\u044B\u043C \u0441\u043E\u043B\u0434\u0430\u0442\u0430\u043C
          \u0423\u0440\u0433\u043E\u0440\u043E\u0434\u0430 \u043B\u043E\u043C\u0430\u043B\u0438
          \u043A\u043E\u0441\u0442\u0438 \u0438 \u0434\u0440\u043E\u0431\u0438\u043B\u0438
          \u0447\u0435\u0440\u0435\u043F\u0430, \u043B\u0438\u0448\u044C \u0431\u044B
          \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C \u0437\u0430\u0433\u0440\u043E\u0431\u043D\u044B\u0445.
          \u041D\u043E \u0423\u0440\u0433\u043E\u0440\u043E\u0434 \u043F\u0440\u043E\u0440\u0432\u0430\u043B\u0441\u044F
          \u0434\u043E \u0418\u0431\u0440\u0430\u0433\u0438\u043C\u0430. \u041F\u043E\u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0435
          \u0441\u043E\u0431\u044B\u0442\u0438\u044F \u043D\u0430\u0432\u0435\u043A\u0438
          \u0432\u044B\u0441\u0435\u0447\u0435\u043D\u044B \u0432 \u043F\u0430\u043C\u044F\u0442\u0438
          \u0421\u0430\u0440\u0433\u0430\u0441\u044B \u0441\u0442\u0438\u0445\u043E\u043C
          \u041C\u0443\u0445\u0438\u0431\u0438:\r\n\r\n\u0418 \u0432\u043E\u0448\u0451\u043B
          \u0423\u0440\u0433\u043E\u0440\u043E\u0434 \u0432 \u0442\u0440\u043E\u043D\u043D\u044B\u0439
          \u0437\u0430\u043B \u043A \u0418\u0431\u0440\u0430\u0433\u0438\u043C\u0443\r\n\u0418
          \u0442\u0438\u0445\u043E \u043E\u043D \u0441 \u043D\u0438\u043C \u0433\u043E\u0432\u043E\u0440\u0438\u043B.\r\n\u041E\u043D
          \u043F\u0440\u043E\u0448\u0451\u043B \u0441\u043A\u0432\u043E\u0437\u044C
          \u043F\u0435\u0441\u043A\u0438, \u0441\u043A\u0432\u043E\u0437\u044C \u043C\u0435\u0447\u0438
          \u0438 \u0441\u043A\u0432\u043E\u0437\u044C \u0437\u0438\u043C\u0443.\r\n\u0418
          \u0445\u0435\u0441 \u0423\u0440\u0433\u043E\u0440\u043E\u0434\u0430 \u0441\u043F\u0440\u043E\u0441\u0438\u043B:\r\n\u201C\u0422\u0430\u043A
          \u0447\u0442\u043E \u0436\u0435, \u043C\u0435\u0440\u0442\u0432\u0435\u0446,
          \u043C\u0435\u043D\u044F \u043D\u0430 \u0437\u0430\u043A\u043B\u0430\u043D\u044C\u0435?\r\n\u0417\u0430\u0433\u0440\u043E\u0431\u043D\u044B\u0435
          \u0433\u043E\u0440\u043E\u0434 \u0441\u043E\u0436\u0433\u0443\u0442?\u201D\r\n\u201C\u041C\u0438\u043B\u043E\u0440\u0434,
          \u0425\u043E\u0447\u0443 \u043F\u0435\u0440\u0435\u0434\u0430\u0442\u044C
          \u0441 \u0442\u043E\u0433\u043E \u0441\u0432\u0435\u0442\u0430 \u043F\u043E\u0441\u043B\u0430\u043D\u0438\u0435.\r\n\u0425\u043E\u0447\u0443
          \u043F\u0435\u0440\u0435\u0434\u0430\u0442\u044C, \u0432\u0430\u0441 \u0442\u0430\u043C
          \u0436\u0434\u0443\u0442.\u201D\r\n\u0421\u043A\u0430\u0437\u0430\u043B
          \u0441\u043B\u043E\u0432\u0430 \u044D\u0442\u0438 \u043D\u0430\u0448 \u0440\u044B\u0446\u0430\u0440\u044C
          \u0437\u0430\u0433\u0440\u043E\u0431\u043D\u044B\u0439\r\n\u0418 \u043C\u0438\u0433\u043E\u043C
          \u0431\u0443\u043B\u0430\u0442\u043D\u044B\u0439 \u043A\u0438\u043D\u0436\u0430\u043B\r\n\u0412
          \u0436\u0438\u0432\u043E\u0442 \u0432\u043E\u043D\u0437\u0438\u043B \u043F\u043E\u043B\u043D\u043E\u0441\u0442\u044C\u044E
          \u0445\u0435\u0441\u0443 \u043E\u043D \u0437\u043B\u043E\u0431\u043D\u043E\u043C\u0443.\r\n\u0418
          \u0438\u043C \u0432\u0440\u0430\u0433\u043E\u0432 \u043F\u043E\u0441\u043B\u0435
          \u0441\u0440\u0430\u0436\u0430\u043B.\r"
