        replicaText: "\u0422\u0435\u043F\u0435\u0440\u044C \u0432\u0441\u0435\u0445
          \u0432\u0430\u0441 \u0432\u0435\u043B\u0438 \u0432 \u043F\u0435\u0449\u0435\u0440\u0443.
          \u041E\u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C, \u0442\u0430\u043C
          \u0443 \u043D\u0438\u0445 \u0431\u044B\u043B\u043E \u0446\u0435\u043B\u043E\u0435
          \u043F\u043E\u0441\u0435\u043B\u0435\u043D\u0438\u0435. \u0412\u0441\u044E\u0434\u0443
          \u0431\u044B\u043B\u0438 \u0432\u0438\u0434\u043D\u044B \u043A\u0430\u043A\u0438\u0435-\u0442\u043E
          \u0440\u0438\u0441\u0443\u043D\u043A\u0438. \u041D\u0430 \u043D\u0438\u0445
          \u043B\u044E\u0434\u0438 \u0443\u0431\u0438\u0432\u0430\u043B\u0438 \u043F\u0435\u0440\u0435\u0434
          \u043E\u0433\u0440\u043E\u043C\u043D\u044B\u043C \u0447\u0443\u0434\u043E\u0432\u0438\u0449\u0435\u043C
          \u0434\u0440\u0443\u0433\u043E\u0433\u043E \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430,
          \u0432\u044B\u043F\u0443\u0441\u043A\u0430\u044F \u043D\u0430\u0440\u0443\u0436\u0443
          \u043A\u0430\u043A\u043E\u0439-\u0442\u043E \u0434\u044B\u043C.\n\n\u0412\u0441\u0435:
          \u042D\u043A\u0438\u043F\u0438\u0440\u043E\u0432\u043A\u0430 \u0432 \u0445\u0440\u0430\u043D\u0438\u043B\u0438\u0449\u0435\n\u0412\u0441\u0435:
          \u0418\u043D\u0432\u0435\u043D\u0442\u0430\u0440\u044C \u0432 \u0445\u0440\u0430\u043D\u0438\u043B\u0438\u0449\u0435\n\n\u041E\u0434\u043D\u043E\u043C\u0443
          \u0438\u0437 \u0432\u0430\u0448\u0438\u0445 \u0443\u0434\u0430\u043B\u043E\u0441\u044C
          \u0437\u0430\u0442\u0435\u0440\u044F\u0442\u044C\u0441\u044F \u0432 \u0442\u043E\u043B\u043F\u0435
          \u0438 \u0443\u0439\u0442\u0438 \u0432 \u0442\u0435\u043D\u044C. \u041E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0445
          \u0443\u0432\u0435\u043B\u0438. \u041D\u0443\u0436\u043D\u043E \u0431\u044B\u043B\u043E
