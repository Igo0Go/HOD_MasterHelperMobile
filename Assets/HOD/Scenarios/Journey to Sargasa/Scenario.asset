      replicaInformation:
        alreadyUsed: 0
        character: {fileID: 11400000, guid: df5ced05feaf7d2438a27afab49786cf, type: 2}
        clip: {fileID: 0}
        animType: 0
        camPositionNumber: 0
        replicaText: "\u041E\u043D\u0430 \u0432\u044B\u0431\u0435\u0436\u0430\u043B\u0430
          \u043A \u043E\u0434\u043D\u043E\u043C\u0443 \u0438\u0437 \u043A\u0443\u043B\u044C\u0442\u0438\u0441\u0442\u043E\u0432,
          \u043A\u043E\u0442\u043E\u0440\u044B\u0439\u2026 \u0432 \u0441\u0442\u0440\u0430\u0445\u0435
          \u043E\u0442\u0448\u0430\u0442\u043D\u0443\u043B\u0441\u044F \u043E\u0442
          \u043D\u0435\u0451, \u0432\u044B\u0440\u043E\u043D\u0438\u0432 \u043C\u0435\u0447.
          \u041E\u043D\u0430 \u0432\u043E\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043B\u0430\u0441\u044C
          \u044D\u0442\u0438\u043C \u0438 \u043F\u043E\u0432\u0435\u043B\u0430 \u0432\u0430\u0441
          \u0437\u0430 \u0441\u043E\u0431\u043E\u0439. \u041A\u0443\u043B\u044C\u0442\u0438\u0441\u0442\u044B
          \u043A\u0430\u043A \u0431\u0443\u0434\u0442\u043E \u0431\u043E\u044F\u043B\u0438\u0441\u044C
          \u0435\u0451. \u041D\u043E \u0441\u0442\u043E\u0438\u043B\u043E \u0435\u0439
          \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F \u0441\u043F\u0438\u043D\u043E\u0439,
          \u043A\u0430\u043A \u043E\u043D\u0438 \u0440\u0438\u043D\u0443\u043B\u0438\u0441\u044C
          \u0437\u0430 \u0432\u0430\u043C\u0438 \u0442\u043E\u043B\u043F\u043E\u0439.
          \u0410 \u043E\u0434\u0438\u043D \u0438\u0437 \u043A\u0443\u043B\u044C\u0442\u0438\u0441\u0442\u043E\u0432
          \u0432\u044B\u0441\u0442\u0440\u0435\u043B\u0438\u043B \u0438\u0437 \u043B\u0443\u043A\u0430.
          \u0421\u0442\u0440\u0435\u043B\u0430 \u043F\u043E\u043F\u0430\u043B\u0430
          \u0432 \u043E\u0434\u043D\u043E\u0433\u043E \u0438\u0437 \u0432\u0430\u0448\u0438\u0445.
          \u0418 \u044D\u0442\u0430 \u0441\u0442\u0440\u0435\u043B\u0430 \u0431\u044B\u043B\u0430
          \u043E\u0442\u0440\u0430\u0432\u043B\u0435\u043D\u0430. \u041D\u043E \u0432
          \u0438\u0442\u043E\u0433\u0435, \u0445\u043E\u0442\u044C \u0438 \u0441
          \u0431\u043E\u043B\u044C\u0448\u0438\u043C \u0442\u0440\u0443\u0434\u043E\u043C,
          \u0432\u044B \u0441\u043C\u043E\u0433\u043B\u0438 \u0441\u0431\u0435\u0436\u0430\u0442\u044C.\n\n\u0410\u043A\u0442\u0438\u0432\u043D\u044B\u0439
          \u0438\u0433\u0440\u043E\u043A: \u041E\u0442\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435"
