        character: {fileID: 11400000, guid: df5ced05feaf7d2438a27afab49786cf, type: 2}
        clip: {fileID: 0}
        animType: 0
        camPositionNumber: 0
        replicaText: "\u0412\u044B \u0432\u0435\u0436\u043B\u0438\u0432\u043E \u043F\u0440\u043E\u0441\u0438\u0442\u0435
          \u0437\u0430\u0433\u0440\u043E\u0431\u043D\u044B\u0445 \u0432\u044B\u0441\u043B\u0443\u0448\u0430\u0442\u044C
          \u0438\u0441\u0442\u043E\u0440\u0438\u044E. \u041F\u0440\u0435\u0434\u0432\u043E\u0434\u0438\u0442\u0435\u043B\u044C
          \u0437\u0430\u0433\u0440\u043E\u0431\u043D\u044B\u0445 \u0437\u0430\u043C\u0435\u0442\u043D\u043E
          \u0440\u0430\u0441\u0441\u0442\u0440\u043E\u0438\u043B\u0441\u044F.\r\n\r\n\u201C\u041D\u0435
          \u0443\u0431\u0435\u0440\u0435\u0433\u043B\u0438\u201D\r\n\r\n\u0412\u044B
          \u0441\u0442\u043E\u044F\u043B\u0438 \u0432 \u043D\u0435\u0434\u043E\u0443\u043C\u0435\u043D\u0438\u0438\r\n\r\n\u201C\u0412\u0438\u0434\u0438\u0442\u0435
          \u043B\u0438, \u044F \u0435\u0451 \u043F\u0440\u0430\u0434\u0435\u0434.
          \u041D\u0443, \u0432 \u0441\u043C\u044B\u0441\u043B\u0435, \u0431\u044B\u043B
          \u0438\u043C. \u041C\u044B \u043D\u043E\u0441\u0438\u0442\u0435\u043B\u0438
          \u0442\u044C\u043C\u044B, \u0442\u0430\u043A \u0431\u044B\u043B\u043E \u0432\u0441\u0435\u0433\u0434\u0430.
          \u0418 \u0441\u043B\u0435\u0434\u0438\u043C \u0437\u0430 \u044D\u0442\u0438\u043C
          \u0438 \u043F\u043E\u0441\u043B\u0435 \u0441\u043C\u0435\u0440\u0442\u0438.
          \u0412\u0438\u0434\u043D\u043E \u043D\u0430\u043C \u0431\u043E\u043B\u044C\u0448\u0435,
          \u0447\u0435\u043C \u0441\u043C\u0435\u0440\u0442\u043D\u044B\u043C. \u041E\u0431\u044B\u0447\u043D\u043E
          \u043C\u044B \u0432 \u0440\u043E\u0434\u0443 \u0441\u0442\u0430\u0440\u0430\u043B\u0438\u0441\u044C
          \u043D\u0435 \u0432\u044B\u043F\u0443\u0441\u043A\u0430\u0442\u044C \u0442\u044C\u043C\u0443,
          \u043D\u043E \u0441\u0435\u0439\u0447\u0430\u0441 \u044D\u0442\u043E \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E.
          \u041D\u043E \u0440\u0430\u0437 \u0434\u0435\u0432\u043E\u0447\u043A\u0430
          \u043C\u0435\u0440\u0442\u0432\u0430, \u0442\u043E \u043D\u0430\u0434\u0435\u0436\u0434\u044B
          \u0431\u043E\u043B\u044C\u0448\u0435 \u043D\u0435\u0442. \u0412\u044B \u043E\u0447\u0435\u043D\u044C
          \u043E\u0433\u043E\u0440\u0447\u0438\u043B\u0438 \u043C\u0435\u043D\u044F,
          \u0440\u0435\u0431\u044F\u0442\u0430.\u201D\r\n\r\n\u0412\u044B \u0441\u043F\u0440\u043E\u0441\u0438\u043B\u0438,
          \u0437\u0430\u0447\u0435\u043C \u0442\u043E\u0433\u0434\u0430 \u0432\u0441\u0435
          \u044D\u0442\u0438 \u043D\u0430\u043F\u0430\u0434\u0435\u043D\u0438\u044F,
          \u0435\u0441\u043B\u0438 \u0410\u0440\u0438\u0441\u0430 - \u0440\u043E\u0434\u043D\u044F.\r\n\r\n\u201C\u0410
          \u0432\u044B \u0431\u044B \u043F\u043E\u0432\u0435\u0440\u0438\u043B\u0438?\u201D
          \r\n\r\n\u0412\u044B \u0432\u0441\u0435 \u0437\u0430\u0434\u0443\u043C\u0430\u043B\u0438\u0441\u044C.\r\n\r\n\u201C\u041D\u0430\u0441
          \u0432\u0441\u0435\u0433\u0434\u0430 \u0431\u044C\u044E\u0442 \u043F\u0435\u0440\u0432\u044B\u043C\u0438.
          \u041C\u044B \u0438 \u0437\u0430\u0449\u0438\u0449\u0430\u0435\u043C\u0441\u044F.
          \u0423 \u043D\u0430\u0441 \u0434\u0435\u043B\u0430 \u043F\u043E\u0432\u0430\u0436\u043D\u0435\u0435,
          \u0447\u0435\u043C \u0441\u043F\u0430\u0441\u0430\u0442\u044C \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u044B\u0445
          \u043B\u044E\u0434\u0435\u0439. \u041C\u044B \u0437\u0430 \u0432\u0430\u0441
          \u0432\u0441\u0435\u0445 \u043E\u0442\u0432\u0435\u0442 \u0434\u0435\u0440\u0436\u0438\u043C.
          \u043F\u043E\u0442\u043E\u043C\u0443 \u0438 \u0443\u0431\u0438\u0432\u0430\u0435\u043C
          \u043F\u043E\u0440\u043E\u0439. \u041F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E
          \u0432\u044B \u043C\u0435\u0448\u0430\u0435\u0442\u0435. \u041D\u043E \u0435\u0451
          \u0431\u044B \u043C\u044B \u043D\u0435 \u043E\u0431\u0438\u0434\u0435\u043B\u0438.
          \u0410 \u0440\u0430\u0437 \u0432\u044B \u0441\u0430\u043C\u0438 \u0441
          \u043D\u0430\u043C\u0438 \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C
          \u043D\u0430\u0447\u0430\u043B\u0438, \u0437\u043D\u0430\u0447\u0438\u0442,
          \u0438 \u0441\u043B\u0443\u0448\u0430\u0442\u044C \u0433\u043E\u0442\u043E\u0432\u044B.
          \r\n\u041D\u0443 \u0434\u0430 \u043B\u0430\u0434\u043D\u043E. \u041D\u0430\u0434\u043E
          \u0434\u043E\u043B\u043E\u0436\u0438\u0442\u044C \u0437\u0430\u0433\u0440\u043E\u0431\u043D\u044B\u043C.
          \u0412\u0438\u0434\u043D\u043E, \u0441\u0443\u0434\u044C\u0431\u0430 \u044D\u0442\u043E\u0433\u043E
          \u043C\u0438\u0440\u0430 \u0442\u0430\u043A\u0430\u044F. \u0410 \u0432\u044B
          \u0442\u0443\u0442 \u0441\u0432\u043E\u044E\u2026 \u0436\u0438\u0437\u043D\u044C
          \u0436\u0438\u0432\u0438\u0442\u0435. \u041F\u043E\u043A\u0430.\u201D\r\n\r\n\u0418
          \u0437\u0430\u0433\u0440\u043E\u0431\u043D\u044B\u0435 \u0443\u0448\u043B\u0438.\r\n\n\u0412\u044B
          \u043C\u0438\u0440\u043D\u043E \u0443\u0448\u043B\u0438 \u0438\u0437 \u0433\u043E\u0440\u043E\u0434\u0430.
          \u0427\u0442\u043E \u0431\u044B \u043D\u0438 \u0431\u044B\u043B\u043E,
          \u043E\u043D\u043E \u043A\u043E\u043D\u0447\u0438\u043B\u043E\u0441\u044C.
          \u0427\u0442\u043E-\u0442\u043E \u0435\u0449\u0451 \u0445\u0443\u0436\u0435
          \u0442\u043E\u043B\u044C\u043A\u043E \u0433\u0440\u044F\u0434\u0451\u0442.
          \u041D\u0430 \u0444\u043E\u043D\u0435 \u0432\u0441\u0435\u0433\u043E \u0441\u043B\u0443\u0447\u0438\u0432\u0448\u0435\u0433\u043E\u0441\u044F
          \u0432\u0430\u0448\u0438 \u043F\u0440\u043E\u043A\u043B\u044F\u0442\u0438\u044F
          - \u043B\u0438\u0448\u044C \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0430\u044F
          \u0442\u0440\u0443\u0434\u043D\u043E\u0441\u0442\u044C.\r\n\r\n\u0412\u044B
          \u043F\u043E\u0448\u043B\u0438 \u0441\u0432\u043E\u0435\u0439 \u0434\u043E\u0440\u043E\u0433\u043E\u0439
          \u043F\u0440\u043E\u0447\u044C \u043E\u0442 \u0421\u0430\u0440\u0433\u0438.\r"
