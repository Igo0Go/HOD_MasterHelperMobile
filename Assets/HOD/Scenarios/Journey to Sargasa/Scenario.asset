        replicaText: "\u041F\u0440\u043E\u0440\u043E\u0441\u043B\u0438\u043A \u043A\u0443\u0441\u0430\u0435\u0442
          \u043E\u0434\u043D\u043E\u0433\u043E \u0438\u0437 \u043C\u044F\u0442\u0435\u0436\u043D\u0438\u043A\u043E\u0432,
          \u0430 \u043F\u043E\u0442\u043E\u043C \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442
          \u043D\u043E\u0441\u0438\u0442\u044C\u0441\u044F \u0432\u043E\u043A\u0440\u0443\u0433,
          \u0441\u043E\u0437\u0434\u0430\u0432\u0430\u044F \u0441\u0443\u043C\u0430\u0442\u043E\u0445\u0443.
          \u042D\u0442\u043E\u0433\u043E \u0445\u0432\u0430\u0442\u0430\u0435\u0442,
          \u0447\u0442\u043E\u0431\u044B \u0432\u044B \u043C\u043E\u0433\u043B\u0438
          \u0441\u0431\u0435\u0436\u0430\u0442\u044C.\r\n\r\n\u041D\u0430 \u0443\u043B\u0438\u0446\u0430\u0445
          \u0434\u0432\u0435 \u0441\u0442\u043E\u0440\u043E\u043D\u044B \u0441\u0440\u0430\u0436\u0430\u043B\u0438\u0441\u044C
          \u0434\u0440\u0443\u0433 \u0441 \u0434\u0440\u0443\u0433\u043E\u043C. \u0412\u044B
          \u0437\u0430\u0442\u0435\u0440\u044F\u043B\u0438\u0441\u044C \u0432 \u0442\u043E\u043B\u043F\u0435
