      replicaInformation:
        alreadyUsed: 0
        character: {fileID: 11400000, guid: df5ced05feaf7d2438a27afab49786cf, type: 2}
        clip: {fileID: 0}
        animType: 0
        camPositionNumber: 0
        replicaText: "\u0412\u044B \u0437\u0430\u0445\u043E\u0434\u0438\u0442\u0435
          \u0432 \u043B\u0435\u0441. \u0413\u043B\u0443\u0431\u043E\u043A\u043E\u0439
          \u043D\u043E\u0447\u044C\u044E \u0432\u044B \u043F\u043B\u0430\u043D\u0438\u0440\u0443\u0435\u0442\u0435
          \u0443\u0441\u0442\u0440\u043E\u0438\u0442\u044C\u0441\u044F \u043D\u0430
          \u043F\u0440\u0438\u0432\u0430\u043B, \u043D\u043E \u043F\u043E\u043F\u0430\u0434\u0430\u0435\u0442\u0435
          \u0432 \u0437\u0430\u0441\u0430\u0434\u0443. \u0412\u0430\u0441 \u043E\u043A\u0440\u0443\u0436\u0438\u043B\u0438
          \u0441\u0442\u0440\u0430\u043D\u043D\u044B\u0435 \u043B\u044E\u0434\u0438
          \u0432 \u0434\u043B\u0438\u043D\u043D\u044B\u0445 \u043E\u0434\u0435\u0436\u0434\u0430\u0445.
          \u041F\u043E\u0445\u043E\u0436\u0435, \u044D\u0442\u043E \u043F\u043E\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u0438
          \u043A\u0430\u043A\u043E\u0433\u043E-\u0442\u043E \u043A\u0443\u043B\u044C\u0442\u0430
          \u0438\u043B\u0438 \u0441\u0435\u043A\u0442\u044B.\n\n\u0411\u043E\u0439\n----------------\n\u041A\u0443\u043B\u044C\u0442\u0438\u0441\u0442
          \u04457\n\n[] | [] | [] \n\u0421\u043A\u043E\u0440\u043E\u0441\u0442\u044C:
          8\n\u0423\u044F\u0437\u0432\u0438\u043C\u043E\u0441\u0442\u044C: \n\u0421\u0442\u043E\u0439\u043A\u043E\u0441\u0442\u044C:
          \u041E\u0433\u043E\u043D\u044C\n\n-0-\u0431\u043B\u0438\u0436\u043D\u044F\u044F
          \u0430\u0442\u0430\u043A\u0430: 1 \u0444\u0438\u0437\n----------------\n\u041A\u0443\u043B\u044C\u0442\u0438\u0441\u0442
          \u043C\u0430\u0433 \u04452\n\n[] | [][][] | [] \n\u0421\u043A\u043E\u0440\u043E\u0441\u0442\u044C:
          7\n\u0423\u044F\u0437\u0432\u0438\u043C\u043E\u0441\u0442\u044C: \u041C\u043E\u0440\u043E\u0437
          \n\u0421\u0442\u043E\u0439\u043A\u043E\u0441\u0442\u044C: \u041E\u0433\u043E\u043D\u044C\n\n-0-\u0431\u043B\u0438\u0436\u043D\u044F\u044F
          \u0430\u0442\u0430\u043A\u0430: 1 \u0444\u0438\u0437\n-0-\u0437\u0430\u043A\u043B.
          \u0423\u043A\u043E\u043B\n-0-\u0437\u0430\u043A\u043B. \u0420\u0430\u0437\u0440\u0435\u0437\n-0-\u0437\u0430\u043A\u043B.
          \u041F\u043B\u0430\u043C\u044F\n----------------"
