        camPositionNumber: 0
        replicaText: "\u0423\u0442\u0440\u043E\u043C \u0432\u044B \u0432\u0435\u0440\u043D\u0443\u043B\u0438\u0441\u044C
          \u043D\u0430 \u0432\u0435\u0440\u0445\u043E\u0432\u043D\u0443\u044E \u043F\u043B\u0430\u0442\u0444\u043E\u0440\u043C\u0443.
          \u041F\u0440\u0438\u0448\u043B\u043E \u0432\u0440\u0435\u043C\u044F \u043D\u043E\u0432\u043E\u0439
          \u0442\u0440\u0435\u043D\u0438\u0440\u043E\u0432\u043A\u0438.\n\n\u201C\u042F
          \u0438\u0441\u043A\u0430\u043B \u0432 \u043D\u0430\u0448\u0435\u0439 \u0431\u0438\u0431\u043B\u0438\u043E\u0442\u0435\u043A\u0435\u2026\u201D
          - \u0433\u043E\u0432\u043E\u0440\u0438\u043B \u0441\u0442\u0430\u0440\u0435\u0439\u0448\u0438\u043D\u0430
          - \u201C\u042F \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E
          \u043D\u0435 \u0441\u043C\u043E\u0433\u0443 \u043F\u043E\u043C\u043E\u0447\u044C
          \u0432\u0430\u043C \u0441 \u043F\u0440\u043E\u043A\u043B\u044F\u0442\u0438\u044F\u043C\u0438.
          \u041F\u043E\u044D\u0442\u043E\u043C\u0443 \u0432\u0430\u0448\u0438 \u0442\u0440\u0435\u043D\u0438\u0440\u043E\u0432\u043A\u0438
          \u0431\u0443\u0434\u0443\u0442 \u0432\u0435\u0441\u044C\u043C\u0430 \u043F\u043E\u043B\u0435\u0437\u043D\u044B,
          \u0432\u0435\u0434\u044C \u0432\u0430\u043C \u043F\u0440\u0438\u0434\u0451\u0442\u0441\u044F
          \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C \u043F\u0443\u0442\u044C.\u201D\n\n\u0412\u0441\u0435:
