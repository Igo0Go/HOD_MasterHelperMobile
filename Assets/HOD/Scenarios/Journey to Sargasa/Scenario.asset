  - nodeType: 1
    replicaNode:
      index: 60
      previousNodesNumbers: 3b000000
      nextNodesNumbers: 3d000000
      finalNode: 0
      leftToRight: 1
      transformRect:
        serializedVersion: 2
        x: 1367
        y: 1803
        width: 150
        height: 50
      replicaInformation:
        alreadyUsed: 0
        character: {fileID: 11400000, guid: df5ced05feaf7d2438a27afab49786cf, type: 2}
        clip: {fileID: 0}
        animType: 0
        camPositionNumber: 0
        replicaText: "\u0412\u044B \u0440\u0435\u0448\u0438\u043B\u0438 \u0432\u0441\u0451
          \u0436\u0435 \u043F\u043E\u0438\u0441\u043A\u0430\u0442\u044C \u0442\u043E\u0432\u0430\u0440\u044B
          \u0434\u043B\u044F \u043C\u0430\u0433\u043E\u0432. \u041D\u0430 \u0443\u0434\u0438\u0432\u043B\u0435\u043D\u0438\u0435,
          \u043D\u0438\u043A\u0442\u043E \u043D\u0438\u0447\u0435\u0433\u043E \u043F\u043E\u0434\u043E\u0431\u043D\u043E\u0433\u043E
          \u043D\u0435 \u043F\u0440\u043E\u0434\u0430\u0432\u0430\u043B. \u041F\u043E\u0447\u0442\u0438
          \u043F\u043E\u0434 \u043A\u043E\u043D\u0435\u0446 \u0442\u043E\u0440\u0433\u043E\u0432\u043E\u0433\u043E
          \u0434\u043D\u044F \u0432\u044B \u043D\u0430\u0448\u043B\u0438 \u0432 \u043A\u0430\u043A\u043E\u043C-\u0442\u043E
          \u0437\u0430\u043A\u043E\u0443\u043B\u043A\u0435 \u043F\u0430\u043B\u0430\u0442\u043A\u0443
          \u0441 \u043C\u0430\u0433\u0438\u0447\u0435\u0441\u043A\u0438\u043C\u0438
          \u0441\u0432\u0438\u0442\u043A\u0430\u043C\u0438. \u0417\u0434\u0435\u0441\u044C
          \u0431\u044B\u043B \u043C\u043E\u043B\u043E\u0434\u043E\u0439 \u043C\u0443\u0436\u0447\u0438\u043D\u0430.
          \u0423 \u043D\u0435\u0433\u043E \u043D\u0430 \u0440\u0443\u043A\u0430\u0445
          \u0441\u0438\u0434\u0435\u043B\u0430 \u0434\u0435\u0432\u043E\u0447\u043A\u0430
          \u043B\u0435\u0442 \u043F\u044F\u0442\u0438. \u041E\u043D\u0430 \u0447\u0442\u043E-\u0442\u043E
          \u0440\u0438\u0441\u043E\u0432\u0430\u043B\u0430 \u043D\u0430 \u043B\u0438\u0441\u0442\u0435
          \u043F\u0435\u0440\u0433\u0430\u043C\u0435\u043D\u0442\u0430 \u043A\u0438\u0441\u0442\u043E\u0447\u043A\u043E\u0439.
          \u042D\u0442\u043E \u0431\u044B\u043B\u0430 \u043A\u0430\u043A\u0430\u044F-\u0442\u043E
          \u0440\u0443\u043D\u0430. \u041F\u043E\u0442\u043E\u043C \u043E\u043D\u0430
          \u043F\u0440\u0438\u043B\u043E\u0436\u0438\u043B\u0430 \u0440\u0443\u043A\u0443.
          \u041D\u0438\u043A\u043E\u043C\u0443 \u043D\u0435 \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u044F,
          \u0433\u043B\u044F\u043D\u0443\u043B\u0430 \u0432 \u043D\u0435\u0451. \u0410
          \u043F\u043E\u0442\u043E\u043C \u0440\u0435\u0437\u043A\u043E \u043E\u0442\u043F\u0443\u0441\u0442\u0438\u043B\u0430.
          \u0418\u0437 \u043B\u0438\u0441\u0442\u0430 \u0432\u044B\u043B\u0435\u0442\u0435\u043B
          \u0448\u0430\u0440\u0438\u043A \u0441\u0432\u0435\u0442\u0430. \u0420\u0443\u043D\u0430
          \u0438\u0441\u0447\u0435\u0437\u043B\u0430 \u0441 \u043B\u0438\u0441\u0442\u0430. 
          \u201C\u0423\u043C\u043D\u0438\u0446\u0430\u201D - \u0441\u043A\u0430\u0437\u0430\u043B
          \u0435\u0439 \u043C\u043E\u043B\u043E\u0434\u043E\u0439 \u043C\u0430\u0433
          \u0438 \u0432\u0437\u044F\u043B \u043B\u0438\u0441\u0442 \u043F\u0435\u0440\u0433\u0430\u043C\u0435\u043D\u0442\u0430
          \u0441\u0435\u0431\u0435, \u043D\u0430\u0447\u0430\u0432 \u0447\u0442\u043E-\u0442\u043E
          \u043D\u0430 \u043D\u0451\u043C \u043F\u0438\u0441\u0430\u0442\u044C. \u0414\u0435\u0432\u043E\u0447\u043A\u0430
          \u0436\u0435 \u0432\u0437\u044F\u043B\u0430 \u0438\u0437 \u0441\u0442\u043E\u043F\u043A\u0438
          \u043D\u043E\u0432\u044B\u0439 \u043B\u0438\u0441\u0442\u0438\u043A.  \u201C\u0412\u044B
          \u043D\u0435 \u0432\u0438\u0434\u0435\u043B\u0438, \u043A\u0430\u043A \u0433\u043E\u0442\u043E\u0432\u044F\u0442\u0441\u044F
          \u0441\u0432\u0438\u0442\u043A\u0438?\u201D - \u0443\u043B\u044B\u0431\u0430\u043B\u0441\u044F
          \u043C\u043E\u043B\u043E\u0434\u043E\u0439 \u043C\u0430\u0433. \u0414\u0435\u0432\u043E\u0447\u043A\u0430
          \u043F\u043E\u0431\u0435\u0434\u043D\u043E \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u043B\u0430
          \u043D\u0430 \u0432\u0430\u0448\u0443 \u0448\u0430\u0439\u043A\u0443. -
          \u201C\u0421\u043D\u0430\u0447\u0430\u043B\u0430 \u043D\u0430 \u043E\u0431\u044B\u0447\u043D\u044B\u0439
          \u043F\u0435\u0440\u0433\u0430\u043C\u0435\u043D\u0442 \u043A\u0430\u043A\u043E\u0439-\u043D\u0438\u0431\u0443\u0434\u044C
          \u0441\u0442\u0430\u0440\u043E\u0439 \u0440\u0443\u043D\u043E\u0439 \u043D\u0443\u0436\u043D\u043E
          \u043D\u0430\u043B\u043E\u0436\u0438\u0442\u044C \u043C\u0430\u0433\u0438\u044E.
          \u0422\u043E\u0433\u0434\u0430 \u043E\u043D \u0431\u0443\u0434\u0435\u0442
          \u043B\u0443\u0447\u0448\u0435 \u0441\u043E\u0445\u0440\u0430\u043D\u044F\u0442\u044C
          \u043C\u0430\u0433\u0438\u0447\u0435\u0441\u043A\u0438\u0435 \u043F\u0438\u0441\u044C\u043C\u0435\u043D\u0430,
          \u0447\u0442\u043E \u043D\u0430 \u043D\u0451\u043C \u043F\u0438\u0448\u0443\u0442
          \u043F\u043E\u0441\u043B\u0435. \u0422\u0430\u043A\u0438\u0435 \u0441\u0432\u0438\u0442\u043A\u0438
          \u0434\u043E\u043B\u044C\u0448\u0435 \u0445\u0440\u0430\u043D\u044F\u0442\u0441\u044F.
