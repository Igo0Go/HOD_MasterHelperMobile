        replicaText: "\u041A \u0441\u043E\u0436\u0430\u043B\u0435\u043D\u0438\u044E,
          \u0432\u0430\u0448 \u043F\u0440\u043E\u0440\u043E\u0441\u043B\u0438\u043A
          \u0435\u0449\u0451 \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0439.
          \u041C\u044F\u0442\u0435\u0436\u043D\u0438\u043A \u043F\u0440\u043E\u0441\u0442\u043E
          \u0431\u0440\u043E\u0441\u0430\u0435\u0442 \u0432 \u043D\u0435\u0433\u043E
          \u0444\u0430\u043A\u0435\u043B. \u0412\u044B \u043D\u0435 \u0443\u0441\u043F\u0435\u0432\u0430\u0435\u0442\u0435
          \u043D\u0438\u0447\u0435\u0433\u043E \u0441\u0434\u0435\u043B\u0430\u0442\u044C.
          \u041D\u0430 \u0443\u0434\u0438\u0432\u043B\u0435\u043D\u0438\u0435, \u044D\u0442\u043E
          \u043F\u0440\u0438\u0432\u043E\u0434\u0438\u0442 \u0432 \u0431\u0435\u0448\u0435\u043D\u0441\u0442\u0432\u043E
          \u043D\u0430\u043C\u0435\u0441\u0442\u043D\u0438\u043A\u0430, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
          \u0441\u0440\u044B\u0432\u0430\u0435\u0442\u0441\u044F \u0441 \u043C\u0435\u0441\u0442\u0430
          \u0438 \u0431\u044B\u0441\u0442\u0440\u043E \u0443\u0431\u0438\u0432\u0430\u0435\u0442
          \u043C\u0435\u0440\u0437\u0430\u0432\u0446\u0430. \u0422\u0430\u043A\u043E\u0435
          \u043F\u043E\u0432\u0435\u0434\u0435\u043D\u0438\u0435 \u0437\u0430\u0440\u044F\u0436\u0430\u0435\u0442
          \u0438 \u0441\u0442\u0440\u0430\u0436\u043D\u0438\u043A\u043E\u0432. \u041D\u043E
          \u043E\u043D\u0438 \u0437\u0430\u0448\u043B\u0438 \u0441\u043B\u0438\u0448\u043A\u043E\u043C
