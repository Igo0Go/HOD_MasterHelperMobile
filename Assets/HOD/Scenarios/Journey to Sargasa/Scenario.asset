        replicaText: "\u041F\u043E\u0445\u043E\u0436\u0435, \u043F\u0440\u043E\u0440\u043E\u0441\u043B\u0438\u043A
          \u043F\u043E\u0433\u043B\u043E\u0442\u0438\u043B \u0441\u043B\u0438\u0448\u043A\u043E\u043C
          \u043C\u043D\u043E\u0433\u043E \u0432\u043E\u0434\u044B. \u041E\u043D \u044F\u0432\u043D\u043E
          \u0434\u043E\u0440\u043E\u0441 \u0434\u043E \u0444\u0430\u0437\u044B, \u043A\u043E\u0433\u0434\u0430
          \u0434\u043E\u043B\u0436\u0435\u043D \u043F\u0443\u0441\u0442\u0438\u0442\u044C
          \u043A\u043E\u0440\u043D\u0438. \u041A \u0441\u043E\u0436\u0430\u043B\u0435\u043D\u0438\u044E,
          \u0432\u0430\u043C \u043F\u0440\u0438\u0448\u043B\u043E\u0441\u044C \u0432\u044B\u0432\u0435\u0441\u0442\u0438
          \u0435\u0433\u043E \u043D\u0430 \u0431\u0435\u0440\u0435\u0433. \u0422\u0430\u043C
          \u0432\u044B \u0432\u0441\u0435\u0439 \u043A\u043E\u043C\u0430\u043D\u0434\u043E\u0439
          \u0438 \u043F\u0440\u043E\u0441\u0442\u0438\u043B\u0438\u0441\u044C \u0441
          \u043F\u0440\u043E\u0440\u043E\u0441\u043B\u0438\u043A\u043E\u043C, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
          \u043D\u0430\u0432\u0435\u043A\u0430 \u0443\u0441\u043D\u0443\u043B, \u043D\u0430\u0431\u0438\u0440\u0430\u044F\u0441\u044C
