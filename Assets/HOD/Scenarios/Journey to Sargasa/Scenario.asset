          \u043F\u0438\u0440\u0430\u0442, \u0441\u043E\u0431\u0438\u0440\u0430\u0435\u0442\u0441\u044F
          \u043D\u0430\u043D\u0435\u0441\u0442\u0438 \u0443\u0434\u0430\u0440. \u041D\u043E
          \u0423\u0440\u044F \u0432\u043E\u0432\u0440\u0435\u043C\u044F \u043F\u0440\u043E\u0442\u044B\u043A\u0430\u0435\u0442
          \u0435\u0433\u043E \u043A\u043B\u0438\u043D\u043A\u043E\u043C. \u041E\u0434\u043D\u0430\u043A\u043E
          \u0442\u0443\u0442 \u0436\u0435 \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442
          \u0443\u0434\u0430\u0440 \u043F\u043E \u0433\u043E\u043B\u043E\u0432\u0435
          \u0438 \u043F\u0430\u0434\u0430\u0435\u0442."
