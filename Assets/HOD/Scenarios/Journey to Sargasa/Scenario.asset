        replicaText: "\u041C\u0430\u0440 \u0438 \u041F\u0430\u043A\u0430\u043B\u0435\u0442,
          \u0434\u0432\u0430 \u043A\u0430\u043F\u0438\u0442\u0430\u043D\u0430, \u0431\u0438\u043B\u0438\u0441\u044C
          \u0441\u043F\u0438\u043D\u0430 \u043A \u0441\u043F\u0438\u043D\u0435 \u043E\u0442\u0442\u044F\u043D\u0443\u0432
          \u043D\u0430 \u0441\u0435\u0431\u044F \u043F\u044F\u0442\u0435\u0440\u044B\u0445
          \u043F\u0438\u0440\u0430\u0442\u043E\u0432. \u041C\u0430\u043B\u043E \u043A\u0442\u043E
          \u043C\u043E\u0433 \u0441\u0440\u0430\u0432\u043D\u0438\u0442\u044C\u0441\u044F
          \u0432 \u0441\u0438\u043B\u0435 \u0441 \u041F\u0430\u043A\u0430\u043B\u0435\u0442\u043E\u043C.
          \u041C\u0430\u0440 \u0436\u0435, \u0445\u043E\u0442\u044C \u0438 \u0431\u044B\u043B
          \u0441\u0442\u0430\u0440\u043E\u0432\u0430\u0442, \u043D\u043E \u043A\u043E\u043C\u043F\u0435\u043D\u0441\u0438\u0440\u043E\u0432\u0430\u043B
          \u044D\u0442\u043E \u043C\u0430\u0441\u0442\u0435\u0440\u0441\u0442\u0432\u043E\u043C.
          \u0415\u0433\u043E \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F \u0431\u044B\u043B\u0438
          \u043A\u0443\u0434\u0430 \u043B\u0435\u0433\u0447\u0435 \u0438 \u0430\u043A\u043A\u0443\u0440\u0430\u0442\u043D\u0435\u0439.
          \u041E\u043D \u043D\u0435 \u0442\u0430\u043A \u0441\u043A\u043E\u0440\u043E
          \u0432\u044B\u0434\u044B\u0445\u0430\u043B\u0441\u044F, \u043A\u0430\u043A
          \u041F\u0430\u043A\u0430\u043B\u0435\u0442. \u0418 \u0434\u043E\u0431\u0430\u0432\u043B\u044F\u043B
          \u043C\u0430\u0433\u0438\u044E \u043C\u043E\u0440\u0435\u0445\u043E\u0434\u043E\u0432
          \u0432 \u0441\u0432\u043E\u0438 \u0430\u0442\u0430\u043A\u0438."
