        camPositionNumber: 0
        replicaText: "\u0410 \u043F\u043E\u0442\u043E\u043C \u0432\u044B \u0443\u0432\u0438\u0434\u0435\u043B\u0438,
          \u043A\u0430\u043A \u0441\u043B\u0451\u0437\u044B \u043D\u0430 \u0435\u0451
          \u0449\u0435\u043A\u0430\u0445 \u043F\u0440\u0435\u0432\u0440\u0430\u0449\u0430\u044E\u0442\u0441\u044F
          \u0432 \u043A\u0430\u043A\u0443\u044E-\u0442\u043E \u0447\u0451\u0440\u043D\u0443\u044E
          \u0434\u044B\u043C\u043A\u0443. \u042D\u0442\u0430 \u0434\u044B\u043C\u043A\u0430
          \u043F\u043E\u0441\u0442\u0435\u043F\u0435\u043D\u043D\u043E \u043F\u043E\u0433\u043B\u043E\u0442\u0438\u043B\u0430
          \u0410\u0440\u0438\u0441\u0443 \u043F\u043E\u043B\u043D\u043E\u0441\u0442\u044C\u044E.
          \u0412\u0430\u043C \u0445\u0432\u0430\u0442\u0438\u043B\u043E \u0443\u043C\u0430
          \u043D\u0435 \u043E\u0441\u0442\u0430\u0432\u0430\u0442\u044C\u0441\u044F
          \u0440\u044F\u0434\u043E\u043C. \u0412\u044B \u0432\u043E\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043B\u0438\u0441\u044C
          \u0442\u0435\u043C, \u0447\u0442\u043E \u0432\u0441\u0435 \u043E\u0442\u0432\u043B\u0435\u043A\u043B\u0438\u0441\u044C
          \u043D\u0430 \u0434\u0435\u0432\u0443\u0448\u043A\u0443, \u0438 \u043F\u0440\u043E\u0431\u0438\u043B\u0438
          \u0441\u0435\u0431\u0435 \u043F\u0443\u0442\u044C \u043D\u0430\u0440\u0443\u0436\u0443.
          \r\n\u0423\u0436\u0435 \u0437\u0430 \u0432\u0430\u0448\u0438\u043C\u0438
          \u0441\u043F\u0438\u043D\u0430\u043C\u0438 \u0432\u044B \u0441\u043B\u044B\u0448\u0430\u043B\u0438
          \u043C\u043E\u0433\u0438\u043B\u044C\u043D\u044B\u0439 \u043A\u0440\u0438\u043A,
          \u043F\u043E\u0441\u043B\u0435 \u0447\u0435\u0433\u043E \u0441\u043B\u0443\u0447\u0438\u043B\u0441\u044F
          \u0432\u0437\u0440\u044B\u0432. \u042D\u0442\u0430 \u0447\u0451\u0440\u043D\u0430\u044F
          \u0434\u044B\u043C\u043A\u0430 \u043B\u0435\u0442\u0430\u043B\u0430 \u043F\u043E\u0432\u0441\u044E\u0434\u0443.
          \u041D\u043E \u0432\u044B \u0443\u0441\u043F\u0435\u043B\u0438 \u0441\u043F\u0440\u044F\u0442\u0430\u0442\u044C\u0441\u044F.
          \n\n\u041A\u043E\u0433\u0434\u0430 \u0432\u0441\u0451 \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u043B\u043E\u0441\u044C,
          \u0432\u044B \u0432\u0435\u0440\u043D\u0443\u043B\u0438\u0441\u044C \u043A
          \u0410\u0440\u0438\u0441\u0435. \u041E\u043D\u0430 \u0431\u044B\u043B\u0430
          \u043C\u0435\u0440\u0442\u0432\u0430. \u041A\u0430\u043A \u0438 \u0432\u0441\u0435
          \u043D\u0430\u043F\u0430\u0434\u0430\u0432\u0448\u0438\u0435. \u0412\u0430\u043C
          \u043E\u0441\u0442\u0430\u043B\u043E\u0441\u044C \u0442\u043E\u043B\u044C\u043A\u043E
          \u0441\u043D\u044F\u0442\u044C \u043F\u0440\u043E\u043A\u043B\u044F\u0442\u044C\u044F.\r"
