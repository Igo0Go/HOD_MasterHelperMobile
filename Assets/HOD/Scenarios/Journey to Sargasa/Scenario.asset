      replicaInformation:
        alreadyUsed: 0
        character: {fileID: 11400000, guid: df5ced05feaf7d2438a27afab49786cf, type: 2}
        clip: {fileID: 0}
        animType: 0
        camPositionNumber: 0
        replicaText: "\u0412\u044B \u0432\u0441\u0451 \u0448\u043B\u0438 \u043F\u043E
          \u043F\u043B\u043E\u0449\u0430\u0434\u0438. \u0412\u0434\u0440\u0443\u0433
          \u0432\u044B \u0443\u0432\u0438\u0434\u0435\u043B\u0438 \u043A\u0430\u043A 
          \u043C\u043E\u043B\u043E\u0434\u043E\u0439 \u043F\u0430\u0440\u0435\u043D\u044C
          \u0437\u0430\u0431\u0440\u0430\u043B\u0441\u044F \u043D\u0430 \u0431\u043E\u0447\u043A\u0443.\r\n\r\n\u201C\u0413\u0440\u0430\u0436\u0434\u0430\u043D\u0435
          \u0421\u0430\u0440\u0433\u0438!\u201D - \u043A\u0440\u0438\u0447\u0430\u043B
          \u043E\u043D - \u201C\u0414\u043E\u043A\u043E\u043B\u0435 \u043C\u043E\u0436\u043D\u043E
          \u0442\u0435\u0440\u043F\u0435\u0442\u044C \u0443\u0437\u0443\u0440\u043F\u0430\u0442\u043E\u0440\u0430?!
          \u041D\u0430\u0441\u043B\u0435\u0434\u043D\u0438\u043A \u043D\u0430\u0448\u0435\u0433\u043E
          \u043A\u043E\u0440\u043E\u043B\u044F - \u0432\u0430\u0448 \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0438\u0439
          \u043F\u0440\u0430\u0432\u0438\u0442\u0435\u043B\u044C, \u0430 \u043D\u0435
          \u043D\u0430\u043C\u0435\u0441\u0442\u043D\u0438\u043A! \u041E\u043D \u043F\u0440\u0438\u0434\u0451\u0442.
          \u041F\u0440\u0438\u0434\u0451\u0442 \u0438 \u043F\u0440\u0438\u043D\u0435\u0441\u0451\u0442
          \u043C\u0438\u0440! \u041D\u0435 \u0431\u0443\u0434\u0435\u0442 \u0431\u043E\u043B\u044C\u0448\u0435
          \u043A\u0430\u0437\u043D\u0435\u0439. \u041D\u0435 \u0431\u0443\u0434\u0435\u0442
          \u0431\u043E\u043B\u044C\u0448\u0435 \u0434\u043E\u043D\u043E\u0441\u043E\u0432.\u201D\r\n\r\n\u201C\u041D\u0435
          \u0431\u0443\u0434\u0435\u0442 \u0431\u043E\u043B\u044C\u0448\u0435 \u0435\u0434\u044B,
          \u043A\u0430\u043A \u0440\u0430\u043D\u044C\u0448\u0435\u201D - \u0432\u043E\u0440\u0447\u0430\u043B
          \u043A\u0442\u043E-\u0442\u043E \u0438\u0437 \u0441\u0442\u0430\u0440\u0438\u043A\u043E\u0432
          - \u201C\u0421\u043B\u0430\u0437\u044C \u0441 \u0431\u043E\u0447\u043A\u0438
          \u044E\u043D\u0435\u0446!\u201D\r\n\r\n\u201C\u041D\u0430\u0448\u0438 \u043E\u0442\u0446\u044B
          \u0438 \u0434\u0435\u0434\u044B \u0441\u043B\u0430\u0431\u044B!\u201D -
          \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u043B \u0442\u043E\u0442
          - \u201C\u041E\u043D\u0438 \u0431\u043E\u044F\u0442\u044C\u0441\u044F \u0432\u044B\u0439\u0442\u0438
          \u043F\u0440\u043E\u0442\u0438\u0432 \u043D\u0430\u043C\u0435\u0441\u0442\u043D\u0438\u043A\u0430.
          \u041D\u043E \u043C\u044B - \u043D\u0435\u0442! \u0412 \u043D\u0430\u0441
          \u0441\u0438\u043B\u0430! \u0412\u0441\u0442\u0430\u043D\u044C\u0442\u0435
          \u043D\u0430 \u0437\u0430\u0449\u0438\u0442\u0443 \u0441\u0432\u043E\u0435\u0439
          \u0441\u0432\u043E\u0431\u043E\u0434\u044B. \u0411\u0435\u0440\u0438\u0442\u0435
          \u043E\u0440\u0443\u0436\u0438\u0435! \u0412\u0441\u0442\u0440\u0435\u0442\u044C\u0442\u0435
          \u043D\u043E\u0432\u043E\u0433\u043E \u043A\u043E\u0440\u043E\u043B\u044F!\u201D\r\n\r\n\u041E\u043D
          \u043D\u0435 \u0443\u0441\u043F\u0435\u043B \u0434\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C
          \u043E\u0441\u0442\u0430\u0442\u043E\u043A \u0441\u0432\u043E\u0435\u0439
          \u0440\u0435\u0447\u0438. \u0415\u0433\u043E \u043F\u043E\u0439\u043C\u0430\u043B\u0430
          \u0441\u0442\u0440\u0430\u0436\u0430. \u0411\u044B\u0441\u0442\u0440\u043E
          \u0438 \u0431\u0435\u0437 \u0448\u0443\u043C\u0430, \u0435\u0433\u043E
          \u0443\u0432\u0435\u043B\u0438 \u0434\u043E\u043B\u043E\u0439 \u0441 \u0433\u043B\u0430\u0437
          \u043D\u0430\u0440\u043E\u0434\u0430.\r\n\r\n\u201C\u041D\u0435\u0441\u0447\u0430\u0441\u0442\u043D\u044B\u0439.\u201D
          - \u0448\u0435\u043F\u0442\u0430\u043B \u0442\u043E\u0442 \u0441\u0430\u043C\u044B\u0439
          \u0441\u0442\u0430\u0440\u0438\u043A - \u201C\u0414\u0430 \u043F\u0440\u043E\u0441\u0442\u044F\u0442
          \u043F\u0440\u0435\u0434\u043A\u0438 \u0442\u0432\u043E\u044E \u0434\u0443\u0448\u0443.\u201D\r\n\r\n\u0418
          \u043E\u043D \u043F\u043E\u0448\u0451\u043B \u0437\u0430 \u0441\u0432\u043E\u0439
          \u043F\u0440\u0438\u043B\u0430\u0432\u043E\u043A. \u041E\u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C,
          \u0447\u0442\u043E \u043E\u043D \u043F\u0440\u043E\u0434\u0430\u0432\u0430\u043B
          \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u0438\u044F \u0438 \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u044B.\r\n\n\u041F\u043E\u043A\u0443\u043F\u043A\u0430\n\u041F\u0440\u043E\u0434\u0430\u0436\u0430\n\u041E\u0431\u043C\u0435\u043D\n-------------\n\u0417\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u0438\u044F\n\u0418\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u044B"
