          \u0438 \u0434\u0432\u0438\u0433\u0430\u0435\u0442\u0435\u0441\u044C \u043A
          \u043D\u0438\u043C. \u041E\u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C,
          \u0447\u0442\u043E \u044D\u0442\u043E \u0441\u043E\u043A\u0440\u044B\u0442\u043E\u0435
          \u043E\u0442 \u0433\u043B\u0430\u0437 \u0432\u0435\u043B\u0438\u043A\u043E\u0435
          \u0434\u0440\u0435\u0432\u043E. \u0417\u0434\u0435\u0441\u044C \u043D\u0430
          \u0434\u0435\u0440\u0435\u0432\u044F\u043D\u043D\u044B\u0445 \u043F\u043B\u0430\u0442\u0444\u043E\u0440\u043C\u0430\u0445
          \u0432\u044B\u0441\u043E\u043A\u043E \u0432 \u043A\u0440\u043E\u043D\u0435
          \u0441\u043A\u0440\u044B\u0432\u0430\u043B\u0430\u0441\u044C \u043C\u0430\u0433\u0438\u0447\u0435\u0441\u043A\u0430\u044F
          \u0448\u043A\u043E\u043B\u0430 \u043B\u0435\u0441\u0430 - \u043E\u0434\u043D\u043E
          \u0438\u0437 \u043E\u0442\u0432\u0435\u0442\u0432\u043B\u0435\u043D\u0438\u0439
          \u0438\u0437\u043D\u0430\u0447\u0430\u043B\u044C\u043D\u043E\u0439 \u0448\u043A\u043E\u043B\u044B
          \u043D\u0435\u0431\u0430. \u041C\u043E\u043D\u0430\u0445\u0438 \u044D\u0442\u043E\u0433\u043E
          \u0442\u0435\u0447\u0435\u043D\u0438\u044F \u043F\u0440\u0435\u0434\u043F\u043E\u0447\u0438\u0442\u0430\u043B\u0438
          \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C
          \u0441\u0438\u043B\u044B \u043D\u0435 \u0434\u043B\u044F \u0442\u043E\u0433\u043E,
          \u0447\u0442\u043E\u0431\u044B \u043C\u0435\u043D\u044F\u0442\u044C \u0440\u0435\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044C
          \u043F\u043E\u0434 \u0441\u0435\u0431\u044F, \u0430 \u0434\u043B\u044F
          \u0442\u043E\u0433\u043E, \u0447\u0442\u043E\u0431\u044B \u0441\u043E\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043E\u0432\u0430\u0442\u044C
          \u0441 \u043D\u0435\u0439 \u0432 \u0433\u0430\u0440\u043C\u043E\u043D\u0438\u0438.
          \u041C\u043E\u043D\u0430\u0445\u0438 \u043F\u0440\u0438\u043D\u044F\u043B\u0438
          \u0432\u0430\u0441 \u0433\u043B\u0443\u0431\u043E\u043A\u043E\u0439 \u043D\u043E\u0447\u044C\u044E.
          \u041D\u0430\u043A\u043E\u0440\u043C\u0438\u043B\u0438 \u0438 \u0443\u0441\u0442\u0440\u043E\u0438\u043B\u0438
          \u043D\u0430 \u043D\u043E\u0447\u043B\u0435\u0433 \u0432 \u043E\u0434\u043D\u043E\u0439
          \u0438\u0437 \u043A\u043E\u043C\u043D\u0430\u0442 \u043D\u0430 \u043C\u043E\u043B\u043E\u0434\u044B\u0445
          \u0432\u0435\u0442\u0432\u044F\u0445, \u0432\u044B\u0441\u043E\u043A\u043E
          \u043D\u0430\u0434 \u0437\u0435\u043C\u043B\u0451\u0439.\n\n\u0412\u0441\u0435:
          \u0421\u0438\u043B\u044B+5\n\u0412\u0441\u0435: \u0421\u044B\u0442\u043E\u0441\u0442\u044C+3"
